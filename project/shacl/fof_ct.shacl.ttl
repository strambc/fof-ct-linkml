fof_ct:SubCellROITable a sh:NodeShape ;
    rdfs:comment "The Sub-Cell ROI Data table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_subcell). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the TSV serialisation) together with the full collection of sub-cellular ROIs (recorded as data rows). This table is optional but recommended. Analogous to the MappingSet class in SSSOM." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" "FOF-CT_vol_core" "FOF-CT_vol_quality" "FOF-CT_undecoded" ) ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path fof_ct:additional_tables ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. The required value is specific to each table. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_subcell" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:datatype xsd:string ;
            sh:description "The type of cells present in this dataset, expressed using an ontology term from the Experimental Factor Ontology (EFO). Examples include \"Primary cell line\", \"Immortal cell line\", \"Induced pluripotent stem (IPS) cell\", \"Cell in tissue\", \"Cell in organoid\", \"Other\". Written as #Cell_Type: in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fof_ct:cell_type ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:description ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required (metric-triggered) when any intensity metric is reported in an optional column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 10 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:datatype xsd:string ;
            sh:description "The type of sub-cellular structure ROI documented in this table or mapping file. It is recommended to use a GO 'cellular_component' child term. Examples include Nucleolus, Nuclear Lamina (NL), Nuclear Pore Complex (NPC), PML_body, Cajal_body, Chromosome_Domain. Written as #Sub_Cell_ROI_Type: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:sub_cell_roi_type ],
        [ sh:class fof_ct:SubCellROI ;
            sh:description "The complete collection of sub-cellular ROIs constituting this dataset. Each SubCellROI corresponds to one data row in the TSV serialisation. At least one user-defined optional column (e.g. ROI_Volume, ROI_Area) MUST be present in every submitted Sub-Cell ROI Data table." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path fof_ct:sub_cell_rois ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:lab_name ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required (metric-triggered) when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:description "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required (metric- triggered) when any time metric is reported in an optional column." ;
            sh:in ( "s" "sec" "ms" "msec" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 11 ;
            sh:path fof_ct:time_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ] ;
    sh:targetClass fof_ct:SubCellROITable .

fof_ct:TraceTable a sh:NodeShape ;
    rdfs:comment "The Trace Data table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_trace). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the CSV serialisation) together with the full collection of Traces (recorded as data rows). Analogous to the MappingSet class in SSSOM. This table is optional but recommended when trace-level properties are recorded." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:description "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required (metric- triggered) when any time metric is reported in an optional column." ;
            sh:in ( "s" "sec" "ms" "msec" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path fof_ct:time_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:lab_name ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required (metric-triggered) when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:description ],
        [ sh:class fof_ct:Trace ;
            sh:description "The complete collection of Traces constituting this dataset. Each Trace corresponds to one data row in the TSV serialisation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path fof_ct:traces ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required (metric-triggered) when any intensity metric is reported in an optional column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" "FOF-CT_vol_core" "FOF-CT_vol_quality" "FOF-CT_undecoded" ) ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path fof_ct:additional_tables ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. The required value is specific to each table. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_trace" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ] ;
    sh:targetClass fof_ct:TraceTable .

fof_ct:UndecodedLocalizationTable a sh:NodeShape ;
    rdfs:comment "The Undecoded SM Localization Data table of a FOF-vol-CT dataset (namespace: FOF-CT_undecoded, no 4dn_ prefix). This table is optional but recommended. It records raw localization detections prior to any decoding or assignment step. Submission is recommended when the raw detections are available and reproducibility of the decoding pipeline is desired." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required (metric-triggered) when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:lab_name ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:description "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required (metric- triggered) when any time metric is reported in an optional column." ;
            sh:in ( "s" "sec" "ms" "msec" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path fof_ct:time_unit ],
        [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" "FOF-CT_vol_core" "FOF-CT_vol_quality" "FOF-CT_undecoded" ) ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path fof_ct:additional_tables ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:description ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. Must always be 'FOF-CT_undecoded' (no 4dn_ prefix — this FOF-vol-CT-exclusive namespace intentionally omits it). Written as ##Table_Namespace= in the file header." ;
            sh:in ( "FOF-CT_undecoded" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:class fof_ct:UndecodedLocalization ;
            sh:description "The complete collection of UndecodedLocalization events constituting this dataset. Each entry corresponds to one data row in the TSV serialisation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path fof_ct:undecoded_localizations ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required (metric-triggered) when any intensity metric is reported in an optional column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ] ;
    sh:targetClass fof_ct:UndecodedLocalizationTable .

fof_ct:Cell a sh:NodeShape ;
    rdfs:comment "A single Cell identified in a FOF-bas-CT experiment. Each instance of this class corresponds to one row in the TSV data section of the FOF-CT Cell Data table. The cell_id field uniquely identifies each Cell and links to the core table, the Sub-Cell ROI Data table, and the Cell/ROI Mapping table. This class accepts additional user-defined optional columns (e.g. Cell_Size, Cell_Volume, Cell_Cycle_State, RNA_Spot_Count) via open schema. At least one such user-defined column MUST be present per submission." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Unique integer identifier for this Cell. Cell_ID values are unique across the entire dataset, enabling unambiguous cross-referencing with the core table, the Sub-Cell ROI Data table, and the Cell/ROI Mapping table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:cell_id ],
        [ sh:datatype xsd:integer ;
            sh:description "Identifier of the extracellular structure ROI (e.g. tissue section, organoid) that contains this Cell. Conditionally required when this Cell can be associated with an extracellular ROI identified as part of this experiment and reported in a dedicated Extra-Cell ROI Data table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:extra_cell_roi_id ] ;
    sh:targetClass fof_ct:Cell .

fof_ct:ExtraCellROI a sh:NodeShape ;
    rdfs:comment "A single extracellular structure ROI (e.g. a tissue section or organoid) identified in a FOF-bas-CT experiment. Each instance of this class corresponds to one row in the TSV data section of the FOF-CT Extra-Cell ROI Data table. The extra_cell_roi_id field uniquely identifies each ROI and links to the core table, the RNA Spot Data table, and the Cell Data table. This class accepts additional user-defined optional columns (e.g. ROI_Volume, Cell_Count). At least one such user-defined column MUST be present per submission." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Unique integer identifier for this extracellular structure ROI. Extra_Cell_ROI_ID values are unique across the entire dataset, enabling unambiguous cross-referencing with the core table, the RNA Spot Data table, and the Cell Data table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:extra_cell_roi_id ] ;
    sh:targetClass fof_ct:ExtraCellROI .

fof_ct:Localization a sh:NodeShape ;
    rdfs:comment "A single individual localisation event contributing to the final position of a bright DNA Spot in a multiplexed FISH experiment (e.g. MERFISH). Each instance of this class corresponds to one row in the CSV data section of the FOF-CT Spot Demultiplexing table. The spot_id field links each Localization to its parent Spot in the core table (or RNA Spot Data table); it may be NA when the localisation could not be assigned to any Spot. This class accepts additional user-defined optional columns (e.g. Hyb, Brightness, Fit_Quality)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for a bright DNA Spot. Used as a primary key in quality and biological data tables, and as a foreign key linking localization events to their parent Spot in the demultiplexing table. In FOF-vol-CT (table 13, SM Localization Data), this same Spot_ID concept is derived by clustering Single-Molecule (SM) Localization events rather than by direct optical detection, and every SM Localization event MUST report its associated Spot_ID." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:spot_id ],
        [ sh:datatype xsd:string ;
            sh:description "The name of the fluorophore whose emission was used to detect this Spot / RNA Spot / localization event (e.g. AlexaFluor_488, Cy5). Mandatory in the Spot Demultiplexing, Spot Quality, RNA Spot Quality, SM Localization Quality, and Undecoded SM Localization tables. Written as the Fluor column." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:fluorophore_name ],
        [ sh:datatype xsd:string ;
            sh:description "The wavelength characteristics of the emission channel used to image this Spot / RNA Spot / localization event (e.g. '510/25', '695/81'). Mandatory in the Spot Demultiplexing, Spot Quality, RNA Spot Quality, SM Localization Quality, and Undecoded SM Localization tables. Written as the Channel column." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:channel_name ],
        [ sh:datatype xsd:float ;
            sh:description "Sub-pixel X coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections (drift correction, chromatic correction, etc.)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:x ],
        [ sh:datatype xsd:float ;
            sh:description "Sub-pixel Y coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:y ],
        [ sh:datatype xsd:integer ;
            sh:description "A unique integer identifier for an individual localization event. Loc_ID values are unique across the entire dataset. Serves as primary key in the Spot Demultiplexing, SM Localization Data, SM Localization Quality, and Undecoded SM Localization tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:loc_id ],
        [ sh:datatype xsd:float ;
            sh:description "Sub-pixel Z coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:z ] ;
    sh:targetClass fof_ct:Localization .

fof_ct:RNASpot a sh:NodeShape ;
    rdfs:comment "A single detected RNA bright Spot corresponding to one RNA transcript location detected alongside Chromatin Tracing. Each instance of this class corresponds to one row in the CSV data section of the FOF-CT RNA Spot Data table. The rna_spot_id links each RNASpot to the RNA Quality and RNA Biological Data tables; the trace_id links this RNA Spot to a DNA chromatin Trace in the core table and Trace Data table. This class accepts additional user-defined optional columns via open schema." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Sub-pixel Y coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:y ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for a chromatin Trace. Used as a primary key in the Trace Data table and as a foreign key in the RNA Spot Data table and (mandatorily) in the FOF-vol-CT SM Localization Data table." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:trace_id ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for a sub-cellular structure ROI (e.g., nucleus, nucleolus). Links to the Sub-Cell ROI Data table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fof_ct:sub_cell_roi_id ],
        [ sh:datatype xsd:float ;
            sh:description "Sub-pixel X coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections (drift correction, chromatic correction, etc.)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:x ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for an extracellular structure ROI (e.g., tissue, organoid). Links to the Extra-Cell ROI Data table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:extra_cell_roi_id ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for a Cell. Links to the Cell Data table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fof_ct:cell_id ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique integer identifier for an RNA bright Spot, unique across the entire dataset. Used as a primary key in the RNA Spot Data table and as a foreign key in the RNA Quality and RNA Biological Data tables." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:rna_spot_id ],
        [ sh:datatype xsd:string ;
            sh:description "Official gene identifier corresponding to rna_name. The type of identifier used (e.g. Ensembl gene ID, NCBI Gene ID) must be declared in the gene_id_type header field." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:gene_id ],
        [ sh:datatype xsd:float ;
            sh:description "Sub-pixel Z coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:z ],
        [ sh:datatype xsd:string ;
            sh:description "Official transcript identifier for the specific transcript targeted by the FISH probe. Conditionally required when multiple transcripts share the same gene_id and the FISH probe can distinguish among them. The type of identifier used must be declared in the transcript_id_type header field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fof_ct:transcript_id ],
        [ sh:datatype xsd:string ;
            sh:description "Official name of the gene from which the targeted RNA is transcribed (e.g. ACTB, GAPDH). Should follow HGNC (human) or MGI (mouse) gene nomenclature." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:rna_name ] ;
    sh:targetClass fof_ct:RNASpot .

fof_ct:RNASpotBiologicalRecord a sh:NodeShape ;
    rdfs:comment "A single row in the RNA Spot Biological Data table. Each instance captures one or more user-defined biological properties for a specific RNA bright Spot identified by RNA_Spot_ID. RNA_Spot_ID values must be unique across the dataset, linking to the corresponding record in the RNA Spot Data table (table 4). At least one user-defined biological property column MUST be present; users declare these via #^ header lines." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Unique integer identifier for an RNA bright Spot, unique across the entire dataset. Used as a primary key in the RNA Spot Data table and as a foreign key in the RNA Quality and RNA Biological Data tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:rna_spot_id ] ;
    sh:targetClass fof_ct:RNASpotBiologicalRecord .

fof_ct:RNASpotQualityRecord a sh:NodeShape ;
    rdfs:comment "A single row in the RNA Spot Quality table. Each instance captures one or more quality metrics for a specific RNA bright Spot identified by RNA_Spot_ID. RNA_Spot_ID values must be unique across the dataset, linking to the corresponding record in the RNA Spot Data table (table 4). RNA_Spot_ID, Channel and Fluor are mandatory; all other reserved quality-metric columns are conditionally required (the same reserved vocabulary as the Spot Quality table) or fully free-form; users declare the latter via #^ header lines." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The name of the fluorophore whose emission was used to detect this Spot / RNA Spot / localization event (e.g. AlexaFluor_488, Cy5). Mandatory in the Spot Demultiplexing, Spot Quality, RNA Spot Quality, SM Localization Quality, and Undecoded SM Localization tables. Written as the Fluor column." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:fluorophore_name ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of photons detected for this localization event or Spot. Reserved, conditionally-required column name (Photon_Count) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables; highly recommended in the latter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:photon_count ],
        [ sh:datatype xsd:float ;
            sh:description "Chromatic aberration correction offset applied to the X coordinate. Same unit as X. Reserved, conditionally-required column name (X_Chromatic_Shift) in the Spot Quality and RNA Spot Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fof_ct:x_chromatic_shift ],
        [ sh:datatype xsd:float ;
            sh:description "Z coordinate before any post-processing corrections. Same unit as Z. Reserved, conditionally-required column name (Raw_Z) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fof_ct:raw_z ],
        [ sh:datatype xsd:float ;
            sh:description "Signal intensity of the brightest pixel within the Spot / localization boundary. Reserved, conditionally-required column name (Peak_Intensity) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fof_ct:peak_intensity ],
        [ sh:datatype xsd:float ;
            sh:description "Drift correction offset applied to the Z coordinate. Same unit as Z. Reserved, conditionally-required column name (Z_Drift) in the Spot Quality and RNA Spot Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fof_ct:z_drift ],
        [ sh:datatype xsd:float ;
            sh:description "Metric quantifying the precision of the Z-axis localization estimate. Highly recommended (not literally mandatory) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables. Written as the reserved Z_Loc_Precision column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:z_precision ],
        [ sh:datatype xsd:float ;
            sh:description "Drift correction offset applied to the Y coordinate. Same unit as Y. Reserved, conditionally-required column name (Y_Drift) in the Spot Quality and RNA Spot Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fof_ct:y_drift ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique integer identifier for an RNA bright Spot, unique across the entire dataset. Used as a primary key in the RNA Spot Data table and as a foreign key in the RNA Quality and RNA Biological Data tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:rna_spot_id ],
        [ sh:datatype xsd:float ;
            sh:description "Chromatic aberration correction offset applied to the Z coordinate. Same unit as Z. Reserved, conditionally-required column name (Z_Chromatic_Shift) in the Spot Quality and RNA Spot Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path fof_ct:z_chromatic_shift ],
        [ sh:datatype xsd:float ;
            sh:description "Metric quantifying the precision of the Y-axis localization estimate. Highly recommended (not literally mandatory) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables. Written as the reserved Y_Loc_Precision column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:y_precision ],
        [ sh:datatype xsd:float ;
            sh:description "Chromatic aberration correction offset applied to the Y coordinate. Same unit as Y. Reserved, conditionally-required column name (Y_Chromatic_Shift) in the Spot Quality and RNA Spot Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fof_ct:y_chromatic_shift ],
        [ sh:datatype xsd:float ;
            sh:description "Localization error estimate for the X coordinate (e.g. standard deviation of repeated measurements). Same unit as X. Reserved, conditionally-required column name (X_Loc_Error) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path fof_ct:x_loc_error ],
        [ sh:datatype xsd:string ;
            sh:description "The wavelength characteristics of the emission channel used to image this Spot / RNA Spot / localization event (e.g. '510/25', '695/81'). Mandatory in the Spot Demultiplexing, Spot Quality, RNA Spot Quality, SM Localization Quality, and Undecoded SM Localization tables. Written as the Channel column." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:channel_name ],
        [ sh:datatype xsd:float ;
            sh:description "X coordinate before any post-processing corrections (drift correction, chromatic correction, etc.). Same unit as X. Reserved, conditionally-required column name (Raw_X) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:raw_x ],
        [ sh:datatype xsd:float ;
            sh:description "Signal intensity of the centroid pixel of the Spot / localization. Reserved, conditionally-required column name (Centroid_Intensity) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fof_ct:centroid_intensity ],
        [ sh:datatype xsd:float ;
            sh:description "Localization error estimate for the Z coordinate. Same unit as Z. Reserved, conditionally-required column name (Z_Loc_Error) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path fof_ct:z_loc_error ],
        [ sh:datatype xsd:float ;
            sh:description "Y coordinate before any post-processing corrections. Same unit as Y. Reserved, conditionally-required column name (Raw_Y) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:raw_y ],
        [ sh:datatype xsd:float ;
            sh:description "Localization error estimate for the Y coordinate. Same unit as Y. Reserved, conditionally-required column name (Y_Loc_Error) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path fof_ct:y_loc_error ],
        [ sh:datatype xsd:float ;
            sh:description "Metric quantifying the precision of the X-axis localization estimate. Typically the Cramer-Rao lower bound or Thompson method estimate. Highly recommended (not literally mandatory) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables. Must be accompanied by a description in the file header. Written as the reserved X_Loc_Precision column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:x_precision ],
        [ sh:datatype xsd:float ;
            sh:description "Drift correction offset applied to the X coordinate. Same unit as X. Reserved, conditionally-required column name (X_Drift) in the Spot Quality and RNA Spot Quality tables. Not part of the reserved vocabulary of the SM Localization Quality table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fof_ct:x_drift ],
        [ sh:datatype xsd:float ;
            sh:description "Metric quantifying how well the fitted model matches the observed signal (e.g. chi-squared, R-squared). Reserved, conditionally-required column name (Goodness_of_Fit) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fof_ct:goodness_of_fit ] ;
    sh:targetClass fof_ct:RNASpotQualityRecord .

fof_ct:ROIMapping a sh:NodeShape ;
    rdfs:comment "A single boundary record for one Cell, Sub-Cell ROI, or Extra-Cell ROI in a FOF-bas-CT experiment. Each instance corresponds to one row in the TSV data section of the FOF-CT Cell/ROI Mapping table. Exactly one of the three identifier slots (sub_cell_roi_id, cell_id, extra_cell_roi_id) must be populated per file; the choice of identifier must be consistent across all rows of a given submission. The roi_boundaries slot holds the boundary coordinates in the format specified by roi_boundaries_format in the table header. This class accepts additional user-defined optional columns." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for the Sub-Cell ROI whose boundaries are described in this row. Conditionally required when this file contains sub- cellular ROI boundary data. Exactly one of sub_cell_roi_id, cell_id, or extra_cell_roi_id must be used consistently throughout the file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:sub_cell_roi_id ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for the Cell whose boundaries are described in this row. Conditionally required when this file contains Cell boundary data. Exactly one of sub_cell_roi_id, cell_id, or extra_cell_roi_id must be used consistently throughout the file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:cell_id ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for the extracellular structure ROI whose boundaries are described in this row. Conditionally required when this file contains Extra-Cell ROI boundary data. Exactly one of sub_cell_roi_id, cell_id, or extra_cell_roi_id must be used consistently throughout the file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:extra_cell_roi_id ],
        [ sh:datatype xsd:string ;
            sh:description "Boundary coordinates for this Cell or ROI, encoded in the format specified by roi_boundaries_format in the table header. For the OME ROI Polygon model, coordinates are provided as a space-separated list of \"x,y\" pairs (e.g. \"12.5,40.2 13.1,41.0 ...\"). For OBJ 3D mesh format, the field contains the vertex and face list for the boundary mesh." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:roi_boundaries ] ;
    sh:targetClass fof_ct:ROIMapping .

fof_ct:SMLocalization a sh:NodeShape ;
    rdfs:comment "A single individual single-molecule (SM) localization event in a FOF-vol-CT dataset. Each instance corresponds to one row in the TSV data section of the SM Localization Data table. The loc_id field is the primary key; spot_id links this localization to its parent Spot (if Spot/Trace post-processing was performed); trace_id links it to its parent Trace. Sub_Cell_ROI_ID, Cell_ID and Extra_Cell_ROI_ID optionally link the localization to spatial context tables." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for a sub-cellular structure ROI (e.g., nucleus, nucleolus). Links to the Sub-Cell ROI Data table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:sub_cell_roi_id ],
        [ sh:datatype xsd:integer ;
            sh:description "Identifier of the Spot (centroid of the SM localization cloud, derived by clustering SM Localization events) to which this localization belongs. Mandatory for every SM Localization event (see vol_core.rst: \"A valid FOF-vol-CT deposition MUST mandatorily report Loc_ID together with its associated Spot_ID and Trace_ID for every SM Localization event.\")." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:spot_id ],
        [ sh:datatype xsd:integer ;
            sh:description "Non-inclusive end coordinate on the chromosome for the genomic target sequence, following BED convention. Used by both the core (Spot) and vol_core (SMLocalization) tables." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:chrom_end ],
        [ sh:datatype xsd:float ;
            sh:description "Sub-pixel Y coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:y ],
        [ sh:datatype xsd:string ;
            sh:description "Chromosome name/identifier using BED (Browser Extensible Data) convention (e.g., chr3, chrY, chr2_random). Used by both the core (Spot) and vol_core (SMLocalization) tables." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:chrom ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for an extracellular structure ROI (e.g., tissue, organoid). Links to the Extra-Cell ROI Data table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fof_ct:extra_cell_roi_id ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique integer identifier for this SM localization event. Loc_ID values are unique across the entire dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fof_ct:loc_id ],
        [ sh:datatype xsd:integer ;
            sh:description "Identifier of the chromatin Trace to which this localization and its parent Spot belong. Mandatory for every SM Localization event (see vol_core.rst)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:trace_id ],
        [ sh:datatype xsd:float ;
            sh:description "Sub-pixel Z coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:z ],
        [ sh:datatype xsd:integer ;
            sh:description "0-based start coordinate on the chromosome for the genomic target sequence, following BED convention. Used by both the core (Spot) and vol_core (SMLocalization) tables." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:chrom_start ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for a Cell. Links to the Cell Data table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:cell_id ],
        [ sh:datatype xsd:float ;
            sh:description "Sub-pixel X coordinate of this SM localization event in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fof_ct:x ] ;
    sh:targetClass fof_ct:SMLocalization .

fof_ct:SMLocalizationQualityRecord a sh:NodeShape ;
    rdfs:comment "A single row in the SM Localization Quality table. Each instance captures quality metrics for one SM localization event identified by Loc_ID. Loc_ID, Channel and Fluor are mandatory. X_Loc_Precision, Y_Loc_Precision, Z_Loc_Precision and Photon_Count are highly recommended but not literally mandatory. All other reserved metric columns are conditionally required (use of the reserved name is optional, but mandatory if that metric is reported). Additional user-defined optional columns must be described in the file header." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Z coordinate before any post-processing corrections. Same unit as Z. Reserved, conditionally-required column name (Raw_Z) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fof_ct:raw_z ],
        [ sh:datatype xsd:float ;
            sh:description "Highly recommended (not literally mandatory): X_Loc_Precision." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:x_precision ],
        [ sh:datatype xsd:float ;
            sh:description "Localization error estimate for the Z coordinate. Same unit as Z. Reserved, conditionally-required column name (Z_Loc_Error) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fof_ct:z_loc_error ],
        [ sh:datatype xsd:integer ;
            sh:description "Highly recommended: number of photons detected for this localization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:photon_count ],
        [ sh:datatype xsd:float ;
            sh:description "Localization error estimate for the Y coordinate. Same unit as Y. Reserved, conditionally-required column name (Y_Loc_Error) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fof_ct:y_loc_error ],
        [ sh:datatype xsd:float ;
            sh:description "Signal intensity of the brightest pixel within the Spot / localization boundary. Reserved, conditionally-required column name (Peak_Intensity) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fof_ct:peak_intensity ],
        [ sh:datatype xsd:float ;
            sh:description "Y coordinate before any post-processing corrections. Same unit as Y. Reserved, conditionally-required column name (Raw_Y) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:raw_y ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique integer identifier for the SM localization event to which these quality metrics belong. Links to the corresponding SMLocalization record in the SM Localization Data table (table 13)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:loc_id ],
        [ sh:datatype xsd:float ;
            sh:description "Localization error estimate for the X coordinate (e.g. standard deviation of repeated measurements). Same unit as X. Reserved, conditionally-required column name (X_Loc_Error) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fof_ct:x_loc_error ],
        [ sh:datatype xsd:float ;
            sh:description "Highly recommended (not literally mandatory): Y_Loc_Precision." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:y_precision ],
        [ sh:datatype xsd:float ;
            sh:description "Signal intensity of the centroid pixel of the Spot / localization. Reserved, conditionally-required column name (Centroid_Intensity) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fof_ct:centroid_intensity ],
        [ sh:datatype xsd:float ;
            sh:description "Highly recommended (not literally mandatory): Z_Loc_Precision." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:z_precision ],
        [ sh:datatype xsd:string ;
            sh:description "The name of the fluorophore whose emission was used to detect this Spot / RNA Spot / localization event (e.g. AlexaFluor_488, Cy5). Mandatory in the Spot Demultiplexing, Spot Quality, RNA Spot Quality, SM Localization Quality, and Undecoded SM Localization tables. Written as the Fluor column." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:fluorophore_name ],
        [ sh:datatype xsd:float ;
            sh:description "Metric quantifying how well the fitted model matches the observed signal (e.g. chi-squared, R-squared). Reserved, conditionally-required column name (Goodness_of_Fit) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fof_ct:goodness_of_fit ],
        [ sh:datatype xsd:string ;
            sh:description "The wavelength characteristics of the emission channel used to image this Spot / RNA Spot / localization event (e.g. '510/25', '695/81'). Mandatory in the Spot Demultiplexing, Spot Quality, RNA Spot Quality, SM Localization Quality, and Undecoded SM Localization tables. Written as the Channel column." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:channel_name ],
        [ sh:datatype xsd:float ;
            sh:description "X coordinate before any post-processing corrections (drift correction, chromatic correction, etc.). Same unit as X. Reserved, conditionally-required column name (Raw_X) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:raw_x ] ;
    sh:targetClass fof_ct:SMLocalizationQualityRecord .

fof_ct:Spot a sh:NodeShape ;
    rdfs:comment "A single DNA-FISH bright Spot detected in a ball-and-stick Chromatin Tracing experiment. Each instance of this class corresponds to one row in the TSV data section of the FOF-CT core table and represents a specific genomic target sequence localised in 3D space and assigned to a chromatin Trace." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "0-based start coordinate on the chromosome for the genomic target sequence, following BED convention. Used by both the core (Spot) and vol_core (SMLocalization) tables." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:chrom_start ],
        [ sh:datatype xsd:string ;
            sh:description "Chromosome name/identifier using BED (Browser Extensible Data) convention (e.g., chr3, chrY, chr2_random). Used by both the core (Spot) and vol_core (SMLocalization) tables." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:chrom ],
        [ sh:datatype xsd:float ;
            sh:description "Sub-pixel X coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections (drift correction, chromatic correction, etc.)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:x ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for a sub-cellular structure ROI (e.g., nucleus, nucleolus). Links to the Sub-Cell ROI Data table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fof_ct:sub_cell_roi_id ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for a chromatin Trace. Used as a primary key in the Trace Data table and as a foreign key in the RNA Spot Data table and (mandatorily) in the FOF-vol-CT SM Localization Data table." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:trace_id ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for an extracellular structure ROI (e.g., tissue, organoid). Links to the Extra-Cell ROI Data table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:extra_cell_roi_id ],
        [ sh:datatype xsd:float ;
            sh:description "Sub-pixel Z coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:z ],
        [ sh:datatype xsd:float ;
            sh:description "Sub-pixel Y coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:y ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for a bright DNA Spot. Used as a primary key in quality and biological data tables, and as a foreign key linking localization events to their parent Spot in the demultiplexing table. In FOF-vol-CT (table 13, SM Localization Data), this same Spot_ID concept is derived by clustering Single-Molecule (SM) Localization events rather than by direct optical detection, and every SM Localization event MUST report its associated Spot_ID." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:spot_id ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for a Cell. Links to the Cell Data table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fof_ct:cell_id ],
        [ sh:datatype xsd:integer ;
            sh:description "Non-inclusive end coordinate on the chromosome for the genomic target sequence, following BED convention. Used by both the core (Spot) and vol_core (SMLocalization) tables." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fof_ct:chrom_end ] ;
    sh:targetClass fof_ct:Spot .

fof_ct:SpotBiologicalRecord a sh:NodeShape ;
    rdfs:comment "A single row in the Spot Biological Data table. Each instance captures one or more user-defined biological properties for a specific DNA bright Spot identified by Spot_ID. Spot_ID values must be unique across the dataset, linking to the corresponding Spot record in the core table (table 1). At least one user-defined biological property column MUST be present; users declare these via #^ header lines." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Unique integer identifier for the DNA bright Spot to which these biological properties belong. Links to the corresponding Spot record in the core table (table 1). Must be unique within this table and across the entire dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:spot_id ] ;
    sh:targetClass fof_ct:SpotBiologicalRecord .

fof_ct:SpotQualityRecord a sh:NodeShape ;
    rdfs:comment "A single row in the Spot Quality table. Each instance captures one or more quality metrics for a specific DNA bright Spot identified by Spot_ID. At least one user-defined quality metric column MUST be present; users declare these via #^ header lines." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Chromatic aberration correction offset applied to the Y coordinate. Same unit as Y. Reserved, conditionally-required column name (Y_Chromatic_Shift) in the Spot Quality and RNA Spot Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fof_ct:y_chromatic_shift ],
        [ sh:datatype xsd:float ;
            sh:description "Chromatic aberration correction offset applied to the Z coordinate. Same unit as Z. Reserved, conditionally-required column name (Z_Chromatic_Shift) in the Spot Quality and RNA Spot Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path fof_ct:z_chromatic_shift ],
        [ sh:datatype xsd:float ;
            sh:description "Signal intensity of the centroid pixel of the Spot / localization. Reserved, conditionally-required column name (Centroid_Intensity) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fof_ct:centroid_intensity ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique integer identifier for the DNA bright Spot to which these quality metrics belong. Links to the corresponding Spot record in the core table (table 1). Must be unique within this table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:spot_id ],
        [ sh:datatype xsd:string ;
            sh:description "The name of the fluorophore whose emission was used to detect this Spot / RNA Spot / localization event (e.g. AlexaFluor_488, Cy5). Mandatory in the Spot Demultiplexing, Spot Quality, RNA Spot Quality, SM Localization Quality, and Undecoded SM Localization tables. Written as the Fluor column." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:fluorophore_name ],
        [ sh:datatype xsd:float ;
            sh:description "Localization error estimate for the Z coordinate. Same unit as Z. Reserved, conditionally-required column name (Z_Loc_Error) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path fof_ct:z_loc_error ],
        [ sh:datatype xsd:string ;
            sh:description "The wavelength characteristics of the emission channel used to image this Spot / RNA Spot / localization event (e.g. '510/25', '695/81'). Mandatory in the Spot Demultiplexing, Spot Quality, RNA Spot Quality, SM Localization Quality, and Undecoded SM Localization tables. Written as the Channel column." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:channel_name ],
        [ sh:datatype xsd:float ;
            sh:description "Chromatic aberration correction offset applied to the X coordinate. Same unit as X. Reserved, conditionally-required column name (X_Chromatic_Shift) in the Spot Quality and RNA Spot Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fof_ct:x_chromatic_shift ],
        [ sh:datatype xsd:float ;
            sh:description "Signal intensity of the brightest pixel within the Spot / localization boundary. Reserved, conditionally-required column name (Peak_Intensity) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fof_ct:peak_intensity ],
        [ sh:datatype xsd:float ;
            sh:description "Recommended: metric for X localization precision" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:x_precision ],
        [ sh:datatype xsd:float ;
            sh:description "Drift correction offset applied to the X coordinate. Same unit as X. Reserved, conditionally-required column name (X_Drift) in the Spot Quality and RNA Spot Quality tables. Not part of the reserved vocabulary of the SM Localization Quality table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fof_ct:x_drift ],
        [ sh:datatype xsd:float ;
            sh:description "Y coordinate before any post-processing corrections. Same unit as Y. Reserved, conditionally-required column name (Raw_Y) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:raw_y ],
        [ sh:datatype xsd:float ;
            sh:description "Drift correction offset applied to the Z coordinate. Same unit as Z. Reserved, conditionally-required column name (Z_Drift) in the Spot Quality and RNA Spot Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fof_ct:z_drift ],
        [ sh:datatype xsd:float ;
            sh:description "Localization error estimate for the Y coordinate. Same unit as Y. Reserved, conditionally-required column name (Y_Loc_Error) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path fof_ct:y_loc_error ],
        [ sh:datatype xsd:float ;
            sh:description "Drift correction offset applied to the Y coordinate. Same unit as Y. Reserved, conditionally-required column name (Y_Drift) in the Spot Quality and RNA Spot Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fof_ct:y_drift ],
        [ sh:datatype xsd:float ;
            sh:description "Metric quantifying how well the fitted model matches the observed signal (e.g. chi-squared, R-squared). Reserved, conditionally-required column name (Goodness_of_Fit) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fof_ct:goodness_of_fit ],
        [ sh:datatype xsd:float ;
            sh:description "Localization error estimate for the X coordinate (e.g. standard deviation of repeated measurements). Same unit as X. Reserved, conditionally-required column name (X_Loc_Error) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path fof_ct:x_loc_error ],
        [ sh:datatype xsd:float ;
            sh:description "Z coordinate before any post-processing corrections. Same unit as Z. Reserved, conditionally-required column name (Raw_Z) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fof_ct:raw_z ],
        [ sh:datatype xsd:integer ;
            sh:description "Optional standardised name for photon count" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:photon_count ],
        [ sh:datatype xsd:float ;
            sh:description "Metric quantifying the precision of the Z-axis localization estimate. Highly recommended (not literally mandatory) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables. Written as the reserved Z_Loc_Precision column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:z_precision ],
        [ sh:datatype xsd:float ;
            sh:description "X coordinate before any post-processing corrections (drift correction, chromatic correction, etc.). Same unit as X. Reserved, conditionally-required column name (Raw_X) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:raw_x ],
        [ sh:datatype xsd:float ;
            sh:description "Metric quantifying the precision of the Y-axis localization estimate. Highly recommended (not literally mandatory) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables. Written as the reserved Y_Loc_Precision column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:y_precision ] ;
    sh:targetClass fof_ct:SpotQualityRecord .

fof_ct:SubCellROI a sh:NodeShape ;
    rdfs:comment "A single sub-cellular structure ROI (e.g. nucleolus, nuclear lamina, PML body, chromosome domain) identified in a FOF-bas-CT experiment. Each instance of this class corresponds to one row in the TSV data section of the FOF-CT Sub-Cell ROI Data table. The sub_cell_roi_id field uniquely identifies each ROI and links to the core table, the Cell Data table, and the Cell/ROI Mapping table. This class accepts additional user-defined optional columns (e.g. ROI_Volume, ROI_Area). At least one such user-defined column MUST be present per submission." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Identifier of the Cell to which this sub-cellular ROI belongs. Conditionally required when this ROI can be associated with a Cell identified as part of this experiment and reported in a dedicated Cell Data table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:cell_id ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique integer identifier for this sub-cellular structure ROI. Sub_Cell_ROI_ID values are unique across the entire dataset, enabling unambiguous cross-referencing with the core table, the Cell Data table, and the Cell/ROI Mapping table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:sub_cell_roi_id ] ;
    sh:targetClass fof_ct:SubCellROI .

fof_ct:Trace a sh:NodeShape ;
    rdfs:comment "A single chromatin Trace representing global properties associated with an entire polymeric trace rather than with individual Spots. Each instance of this class corresponds to one row in the CSV data section of the FOF-CT Trace Data table. The trace_id links each Trace to the core table and to the RNA Spot Data table. IMPORTANT: this class MUST contain at least one user-defined optional column describing trace-level properties (e.g., Allele, RNA_Expression, Lamina_Distance). User-defined columns are accommodated via open schema." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for a chromatin Trace. Used as a primary key in the Trace Data table and as a foreign key in the RNA Spot Data table and (mandatorily) in the FOF-vol-CT SM Localization Data table." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:trace_id ] ;
    sh:targetClass fof_ct:Trace .

fof_ct:UndecodedLocalization a sh:NodeShape ;
    rdfs:comment "A single raw, undecoded SM localization event in a FOF-vol-CT dataset. Each instance corresponds to one row in the TSV data section of the Undecoded SM Localization Data table. This class uses LocalizationMixin for the shared loc_id, x, y, z slots. The 8 mandatory columns, in order, are: Loc_ID, Hyb_ID, Image_Frame_ID, X, Y, Z, Channel, Fluor. TheZ (the_z) is a reserved, conditionally-required column for the focal Z-plane identifier." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Unique integer identifier for this undecoded localization event. Loc_ID values are unique across the entire dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:loc_id ],
        [ sh:datatype xsd:float ;
            sh:description "Sub-pixel Y coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fof_ct:y ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique integer identifier for the imaging frame in which this undecoded localization event was detected. Written as the Image_Frame_ID column. Mandatory in the Undecoded SM Localization table." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:image_frame_id ],
        [ sh:datatype xsd:integer ;
            sh:description "Unique identifier for the hybridization round in which this localization event was detected. Written as the Hyb_ID column. Mandatory in the Undecoded SM Localization table." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:hyb_id ],
        [ sh:datatype xsd:float ;
            sh:description "Sub-pixel Z coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fof_ct:z ],
        [ sh:datatype xsd:string ;
            sh:description "The name of the fluorophore whose emission was used to detect this Spot / RNA Spot / localization event (e.g. AlexaFluor_488, Cy5). Mandatory in the Spot Demultiplexing, Spot Quality, RNA Spot Quality, SM Localization Quality, and Undecoded SM Localization tables. Written as the Fluor column." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:fluorophore_name ],
        [ sh:datatype xsd:float ;
            sh:description "Sub-pixel X coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections (drift correction, chromatic correction, etc.)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:x ],
        [ sh:datatype xsd:string ;
            sh:description "The wavelength characteristics of the emission channel used to image this Spot / RNA Spot / localization event (e.g. '510/25', '695/81'). Mandatory in the Spot Demultiplexing, Spot Quality, RNA Spot Quality, SM Localization Quality, and Undecoded SM Localization tables. Written as the Channel column." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:channel_name ],
        [ sh:datatype xsd:integer ;
            sh:description "Identifier of the focal Z-plane in which this localization event was detected. Reserved, conditionally-required column name (TheZ) in the Undecoded SM Localization table: optional to use, but if the focal Z-plane is reported this exact reserved column name MUST be used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:the_z ] ;
    sh:targetClass fof_ct:UndecodedLocalization .

fof_ct:Software a sh:NodeShape ;
    rdfs:comment "Provenance metadata for a single software tool used to produce or process data in a FOF-CT table. If more than one tool was used, a separate Software entry must be provided for each. Written as a repeating block of #Software_* fields in the file header." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Name of the software tool. Written as #Software_Title:." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:software_title ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the algorithm used, sufficient to guarantee reproducibility. Written as #Software_Description:." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:software_description ],
        [ sh:description "Functional category of the software tool. Written as #Software_Type:." ;
            sh:in ( "Distance Calculation" "DriftCorrection" "Precision Assessment" "Segmentation" "Single Molecule Localization" "SpotLoc" "SpotLoc+Tracing" "Tracing" "Other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path fof_ct:software_type ],
        [ sh:description "Unique identifier (DOI, PMCID, ArXiv ID, etc.) for the primary publication describing this software. Written as #Software_PreferredCitationID:." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path fof_ct:software_preferred_citation_id ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the input parameters used for the specific analysis run performed using this Software. Should provide sufficient detail about the analysis parameters used to guarantee interpretation and reproducibility (e.g. input parameters used for assessing the precision of single molecule localization or drift correction in X, Y and Z). Written as #Software_Parameters:." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:software_parameters ],
        [ sh:datatype xsd:string ;
            sh:description "Author name(s) in 'Surname, Firstname' format, multiple authors separated by semicolons. Written as #Software_Authors:." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:software_authors ],
        [ sh:description "URL of the repository where the software release can be obtained. Written as #Software_Repository:." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path fof_ct:software_repository ] ;
    sh:targetClass fof_ct:Software .

