@prefix fof_ct: <https://w3id.org/fof-ct/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fof_ct:CellTable a sh:NodeShape ;
    rdfs:comment "The Cell Data table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_cell). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the TSV serialisation) together with the full collection of Cells (recorded as data rows). This table is optional but recommended. Analogous to the MappingSet class in SSSOM." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:lab_name ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:datatype xsd:string ;
            sh:description "The type of cells present in this dataset, expressed using an ontology term from the Experimental Factor Ontology (EFO). Examples include \"Cell in tissue\" or \"Cell in organoid\". Written as #Cell_Type: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:cell_type ],
        [ sh:description "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required when any time metric is reported." ;
            sh:in ( "s" "sec" "ms" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 11 ;
            sh:path fof_ct:time_unit ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fof_ct:softwares ],
        [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Conditionally required when any location or distance metric is reported." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:description ],
        [ sh:datatype xsd:string ;
            sh:description "The type of extracellular structure ROI within which cells are embedded, expressed using an EFO 'organism part' child term (e.g. Tissue, Organoid). Conditionally required when extracellular structure ROIs are identified and reported in a dedicated Extra-Cell ROI Data table. Written as #Extra_Cell_ROI_Type: in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fof_ct:extra_cell_roi_type ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. The required value is specific to each table. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_cell" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" ) ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path fof_ct:additional_tables ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:class fof_ct:Cell ;
            sh:description "The complete collection of Cells constituting this dataset. Each Cell corresponds to one data row in the TSV serialisation. At least one user-defined optional column (e.g. Cell_Size, Cell_Volume) MUST be present in every submitted Cell Data table." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path fof_ct:cells ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_name ] ;
    sh:targetClass fof_ct:CellTable .

fof_ct:ExtraCellROITable a sh:NodeShape ;
    rdfs:comment "The Extra-Cell ROI Data table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_extracell). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the TSV serialisation) together with the full collection of extracellular ROIs (recorded as data rows). This table is optional but recommended. Analogous to the MappingSet class in SSSOM." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Conditionally required when any location or distance metric is reported." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:datatype xsd:string ;
            sh:description "The type of extracellular structure ROI within which cells are embedded, expressed using an EFO 'organism part' child term (e.g. Tissue, Organoid). Conditionally required when extracellular structure ROIs are identified and reported in a dedicated Extra-Cell ROI Data table. Written as #Extra_Cell_ROI_Type: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:extra_cell_roi_type ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:description ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:class fof_ct:ExtraCellROI ;
            sh:description "The complete collection of extracellular ROIs constituting this dataset. Each ExtraCellROI corresponds to one data row in the TSV serialisation. At least one user-defined optional column (e.g. ROI_Volume, Cell_Count) MUST be present in every submitted Extra-Cell ROI Data table." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path fof_ct:extra_cell_rois ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" ) ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path fof_ct:additional_tables ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:lab_name ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. The required value is specific to each table. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_extracell" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:description "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required when any time metric is reported." ;
            sh:in ( "s" "sec" "ms" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path fof_ct:time_unit ] ;
    sh:targetClass fof_ct:ExtraCellROITable .

fof_ct:LocalizationTable a sh:NodeShape ;
    rdfs:comment "The Spot Demultiplexing table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_demultiplexing). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the CSV serialisation) together with the full collection of Localization events (recorded as data rows). Analogous to the MappingSet class in SSSOM. This table is optional but recommended for multiplexed FISH experiments." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:description ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:description "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required when any time metric is reported." ;
            sh:in ( "s" "sec" "ms" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path fof_ct:time_unit ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" ) ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path fof_ct:additional_tables ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:lab_name ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. The required value is specific to each table. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_demultiplexing" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fof_ct:softwares ],
        [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Conditionally required when any location or distance metric is reported." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:class fof_ct:Localization ;
            sh:description "The complete collection of Localization events constituting this dataset. Each Localization corresponds to one data row in the TSV serialisation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path fof_ct:localizations ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ] ;
    sh:targetClass fof_ct:LocalizationTable .

fof_ct:RNASpotBiologicalTable a sh:NodeShape ;
    rdfs:comment "The RNA Spot Biological Data table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_rna_bio). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the TSV serialisation) together with the full collection of RNASpotBiologicalRecord rows. Submission of this table is optional but highly recommended." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Unit used for any spatial coordinate or distance metric reported in user-defined columns (e.g. distance from nuclear lamina). Conditionally required when any such metric is present. Written as ##XYZ_Unit= in the file header." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" ) ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path fof_ct:additional_tables ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. Must always be '4dn_FOF-CT_rna_bio'. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_rna_bio" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:description ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:lab_name ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:class fof_ct:RNASpotBiologicalRecord ;
            sh:description "The complete collection of RNASpotBiologicalRecord rows constituting this dataset. Each record corresponds to one data row in the TSV serialisation and must include at least one user-defined biological property column." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path fof_ct:rna_spot_biological_records ],
        [ sh:description "Unit used for any time metric reported in user-defined columns. Conditionally required when any such metric is present. Written as ##Time_Unit= in the file header." ;
            sh:in ( "s" "sec" "ms" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path fof_ct:time_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used for any intensity metric reported in user-defined columns. Conditionally required when any such metric is present. Written as ##Intensity_Unit= in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Required only when software was used; omit the block entirely if no software was applied. Written as repeating #Software_* blocks in the file header." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements. Conditionally required when any intensity metric is present. Written as #Intensity_Measurement_Method: in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:intensity_measurement_method ] ;
    sh:targetClass fof_ct:RNASpotBiologicalTable .

fof_ct:RNASpotQualityTable a sh:NodeShape ;
    rdfs:comment "The RNA Spot Quality table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_rna_quality). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the TSV serialisation) together with the full collection of RNASpotQualityRecord rows. Submission of this table is optional but recommended." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Unit used for any spatial coordinate or distance metric reported in user-defined columns. Conditionally required when any such metric is present. Written as ##XYZ_Unit= in the file header." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:class fof_ct:RNASpotQualityRecord ;
            sh:description "The complete collection of RNASpotQualityRecord rows constituting this dataset. Each record corresponds to one data row in the TSV serialisation and must include at least one user-defined quality metric column." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path fof_ct:rna_spot_quality_records ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. Must always be '4dn_FOF-CT_rna_quality'. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_rna_quality" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" ) ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path fof_ct:additional_tables ],
        [ sh:description "Unit used for any time metric reported in user-defined columns. Conditionally required when any such metric is present. Written as ##Time_Unit= in the file header." ;
            sh:in ( "s" "sec" "ms" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path fof_ct:time_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used for any intensity metric reported in user-defined columns. Conditionally required when any such metric is present. Written as ##Intensity_Unit= in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:lab_name ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Required only when software was used; omit the block entirely if no software was applied. Written as repeating #Software_* blocks in the file header." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements. Conditionally required when any intensity metric is present. Written as #Intensity_Measurement_Method: in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:description ] ;
    sh:targetClass fof_ct:RNASpotQualityTable .

fof_ct:RNASpotTable a sh:NodeShape ;
    rdfs:comment "The RNA Spot Data table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_rna). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the CSV serialisation) together with the full collection of RNA Spots (recorded as data rows). Analogous to the MappingSet class in SSSOM. This table is optional but recommended when RNA data are collected alongside Chromatin Tracing." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. The required value is specific to each table. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_rna" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" ) ;
            sh:minCount 1 ;
            sh:order 10 ;
            sh:path fof_ct:additional_tables ],
        [ sh:datatype xsd:string ;
            sh:description "Type of gene identifier used in the gene_id column (e.g. Ensembl_V38, NCBI_Gene). Written as ##Gene_ID_Type= in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:gene_id_type ],
        [ sh:datatype xsd:string ;
            sh:description "Genome build used for Chrom, Chrom_Start and Chrom_End coordinates. The 4DN Data Portal accepts GRCh38 (human) and GRCm38 (mouse). When the genome under study contains an INSERTION or DELETION the value must use the mandatory 'custom-build:' prefix followed by a descriptive name (e.g., custom-build:GRCm38+pJT039(insertion)). Written as ##Genome_Assembly= in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:genome_assembly ],
        [ sh:description "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required when any time metric is reported." ;
            sh:in ( "s" "sec" "ms" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 12 ;
            sh:path fof_ct:time_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Type of transcript identifier used in the transcript_id column (e.g. Ensembl_V38, RefSeq). Conditionally required when multiple transcripts share the same gene_id and the FISH probe can distinguish among them. Written as ##Transcript_ID_Type= in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:transcript_id_type ],
        [ sh:class fof_ct:RNASpot ;
            sh:description "The complete collection of RNA Spots constituting this dataset. Each RNASpot corresponds to one data row in the TSV serialisation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path fof_ct:rna_spots ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fof_ct:description ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fof_ct:softwares ],
        [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Conditionally required when any location or distance metric is reported." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:lab_name ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:experimenter_name ] ;
    sh:targetClass fof_ct:RNASpotTable .

fof_ct:ROIMappingTable a sh:NodeShape ;
    rdfs:comment "The Cell/ROI Mapping table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_mapping). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the TSV serialisation) together with the full collection of ROI boundary records (recorded as data rows). This table is conditionally required whenever a Cell Data table, a Sub-Cell ROI Data table, or an Extra-Cell ROI Data table is deposited. Analogous to the MappingSet class in SSSOM." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The type of sub-cellular structure ROI documented in this table or mapping file. It is recommended to use an EFO 'cellular_component' child term. Examples include Nucleolus, NL (nuclear lamina), NPC (nuclear pore complex), PML_body, Cajal_body, Chromosome_Domain. Written as #Sub_Cell_ROI_Type: in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:sub_cell_roi_type ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:description "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required when any time metric is reported." ;
            sh:in ( "s" "sec" "ms" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path fof_ct:time_unit ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" ) ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path fof_ct:additional_tables ],
        [ sh:class fof_ct:ROIMapping ;
            sh:description "The complete collection of ROI boundary records constituting this dataset. Each ROIMapping corresponds to one data row in the TSV serialisation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fof_ct:roi_mappings ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. The required value is specific to each table. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_mapping" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:datatype xsd:string ;
            sh:description "The type of extracellular structure ROI within which cells are embedded, expressed using an EFO 'organism part' child term (e.g. Tissue, Organoid). Conditionally required when extracellular structure ROIs are identified and reported in a dedicated Extra-Cell ROI Data table. Written as #Extra_Cell_ROI_Type: in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:extra_cell_roi_type ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Conditionally required when any location or distance metric is reported." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the coordinate format used to encode boundary data in the roi_boundaries column. Examples include the OME ROI Polygon model (coordinates as \"x1,y1 x2,y2 ...\") and the OBJ 3D mesh format (vertex and face lists). Must be sufficient for unambiguous parsing of all roi_boundaries values in this file. Written as #ROI_Boundaries_Format: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:roi_boundaries_format ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fof_ct:description ],
        [ sh:datatype xsd:string ;
            sh:description "The type of cells present in this dataset, expressed using an ontology term from the Experimental Factor Ontology (EFO). Examples include \"Cell in tissue\" or \"Cell in organoid\". Written as #Cell_Type: in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fof_ct:cell_type ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:lab_name ] ;
    sh:targetClass fof_ct:ROIMappingTable .

fof_ct:SpotBiologicalTable a sh:NodeShape ;
    rdfs:comment "The Spot Biological Data table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_bio). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the TSV serialisation) together with the full collection of SpotBiologicalRecord rows. Submission of this table is optional but highly recommended." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:class fof_ct:SpotBiologicalRecord ;
            sh:description "The complete collection of SpotBiologicalRecord rows constituting this dataset. Each record corresponds to one data row in the TSV serialisation and must include at least one user-defined biological property column." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path fof_ct:spot_biological_records ],
        [ sh:description "Unit used for any time metric reported in user-defined columns. Conditionally required when any such metric is present. Written as ##Time_Unit= in the file header." ;
            sh:in ( "s" "sec" "ms" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path fof_ct:time_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used for any intensity metric reported in user-defined columns. Conditionally required when any such metric is present. Written as ##Intensity_Unit= in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. Must always be '4dn_FOF-CT_bio'. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_bio" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Required only when software was used; omit the block entirely if no software was applied. Written as repeating #Software_* blocks in the file header." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements. Conditionally required when any intensity metric is present. Written as #Intensity_Measurement_Method: in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:description "Unit used for any spatial coordinate or distance metric reported in user-defined columns (e.g. distance from nuclear lamina). Conditionally required when any such metric is present. Written as ##XYZ_Unit= in the file header." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:lab_name ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:description ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" ) ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path fof_ct:additional_tables ] ;
    sh:targetClass fof_ct:SpotBiologicalTable .

