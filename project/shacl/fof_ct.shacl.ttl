@prefix fof_ct: <https://w3id.org/fof-ct/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fof_ct:CellTable a sh:NodeShape ;
    rdfs:comment "The Cell Data table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_cell). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the TSV serialisation) together with the full collection of Cells (recorded as data rows). This table is optional but recommended. Analogous to the MappingSet class in SSSOM." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fof_ct:Cell ;
            sh:description "The complete collection of Cells constituting this dataset. Each Cell corresponds to one data row in the TSV serialisation. At least one user-defined optional column (e.g. Cell_Size, Cell_Volume) MUST be present in every submitted Cell Data table." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path fof_ct:cells ],
        [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 10 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:description "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required (metric- triggered) when any time metric is reported in an optional column." ;
            sh:in ( "s" "sec" "ms" "msec" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 11 ;
            sh:path fof_ct:time_unit ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" "FOF-CT_vol_core" "FOF-CT_vol_quality" "FOF-CT_undecoded" ) ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path fof_ct:additional_tables ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required (metric-triggered) when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. The required value is specific to each table. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_cell" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:datatype xsd:string ;
            sh:description "The type of extracellular structure ROI within which cells are embedded, expressed using an EFO 'organism part' child term (e.g. Tissue, Organoid). Conditionally required when extracellular structure ROIs are identified and reported in a dedicated Extra-Cell ROI Data table. Written as #Extra_Cell_ROI_Type: in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fof_ct:extra_cell_roi_type ],
        [ sh:datatype xsd:string ;
            sh:description "The type of cells present in this dataset, expressed using an ontology term from the Experimental Factor Ontology (EFO). Examples include \"Primary cell line\", \"Immortal cell line\", \"Induced pluripotent stem (IPS) cell\", \"Cell in tissue\", \"Cell in organoid\", \"Other\". Written as #Cell_Type: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:cell_type ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:lab_name ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:description ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required (metric-triggered) when any intensity metric is reported in an optional column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fof_ct:intensity_unit ] ;
    sh:targetClass fof_ct:CellTable .

fof_ct:DemultiplexingTable a sh:NodeShape ;
    rdfs:comment "The Spot Demultiplexing table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_demultiplexing). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the CSV serialisation) together with the full collection of Localization events (recorded as data rows). Analogous to the MappingSet class in SSSOM. This table is optional but recommended for multiplexed FISH experiments." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:description "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required (metric- triggered) when any time metric is reported in an optional column." ;
            sh:in ( "s" "sec" "ms" "msec" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path fof_ct:time_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required (metric-triggered) when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" "FOF-CT_vol_core" "FOF-CT_vol_quality" "FOF-CT_undecoded" ) ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path fof_ct:additional_tables ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:description ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:lab_name ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required (metric-triggered) when any intensity metric is reported in an optional column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. The required value is specific to each table. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_demultiplexing" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:class fof_ct:Localization ;
            sh:description "The complete collection of Localization events constituting this dataset. Each Localization corresponds to one data row in the TSV serialisation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path fof_ct:localizations ] ;
    sh:targetClass fof_ct:DemultiplexingTable .

fof_ct:ExtraCellROITable a sh:NodeShape ;
    rdfs:comment "The Extra-Cell ROI Data table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_extracell). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the TSV serialisation) together with the full collection of extracellular ROIs (recorded as data rows). This table is optional but recommended. Analogous to the MappingSet class in SSSOM." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required (metric-triggered) when any intensity metric is reported in an optional column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" "FOF-CT_vol_core" "FOF-CT_vol_quality" "FOF-CT_undecoded" ) ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path fof_ct:additional_tables ],
        [ sh:datatype xsd:string ;
            sh:description "The type of extracellular structure ROI within which cells are embedded, expressed using an EFO 'organism part' child term (e.g. Tissue, Organoid). Conditionally required when extracellular structure ROIs are identified and reported in a dedicated Extra-Cell ROI Data table. Written as #Extra_Cell_ROI_Type: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:extra_cell_roi_type ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fof_ct:softwares ],
        [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 9 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. The required value is specific to each table. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_extracell" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:class fof_ct:ExtraCellROI ;
            sh:description "The complete collection of extracellular ROIs constituting this dataset. Each ExtraCellROI corresponds to one data row in the TSV serialisation. At least one user-defined optional column (e.g. ROI_Volume, Cell_Count) MUST be present in every submitted Extra-Cell ROI Data table." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path fof_ct:extra_cell_rois ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:lab_name ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:description ],
        [ sh:description "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required (metric- triggered) when any time metric is reported in an optional column." ;
            sh:in ( "s" "sec" "ms" "msec" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path fof_ct:time_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required (metric-triggered) when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fof_ct:intensity_measurement_method ] ;
    sh:targetClass fof_ct:ExtraCellROITable .

fof_ct:LocalizationMixin a sh:NodeShape ;
    rdfs:comment "Mixin capturing the shared concept of a single localization event across FOF-CT modalities. Used by Localization (demultiplexing), SMLocalization (vol_core), and UndecodedLocalization (undecoded). All three classes represent the same atomic measurement unit — the sub-pixel position of a detected fluorescence emission event — but differ in context, mandatory columns, and table role." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Sub-pixel Y coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:y ],
        [ sh:datatype xsd:float ;
            sh:description "Sub-pixel Z coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:z ],
        [ sh:datatype xsd:float ;
            sh:description "Sub-pixel X coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections (drift correction, chromatic correction, etc.)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:x ],
        [ sh:datatype xsd:integer ;
            sh:description "A unique integer identifier for an individual localization event. Loc_ID values are unique across the entire dataset. Serves as primary key in the Spot Demultiplexing, SM Localization Data, SM Localization Quality, and Undecoded SM Localization tables." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:loc_id ] ;
    sh:targetClass fof_ct:LocalizationMixin .

fof_ct:RNASpotBiologicalTable a sh:NodeShape ;
    rdfs:comment "The RNA Spot Biological Data table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_rna_bio). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the TSV serialisation) together with the full collection of RNASpotBiologicalRecord rows. Submission of this table is optional but highly recommended." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Unit used for any time metric reported in user-defined columns. Conditionally required when any such metric is present. Written as ##Time_Unit= in the file header." ;
            sh:in ( "s" "sec" "ms" "msec" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path fof_ct:time_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. Must always be '4dn_FOF-CT_rna_bio'. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_rna_bio" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:description ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" "FOF-CT_vol_core" "FOF-CT_vol_quality" "FOF-CT_undecoded" ) ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path fof_ct:additional_tables ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Required only when software was used; omit the block entirely if no software was applied. Written as repeating #Software_* blocks in the file header." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements. Conditionally required when any intensity metric is present. Written as #Intensity_Measurement_Method: in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:class fof_ct:RNASpotBiologicalRecord ;
            sh:description "The complete collection of RNASpotBiologicalRecord rows constituting this dataset. Each record corresponds to one data row in the TSV serialisation and must include at least one user-defined biological property column." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path fof_ct:rna_spot_biological_records ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:lab_name ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used for any intensity metric reported in user-defined columns. Conditionally required when any such metric is present. Written as ##Intensity_Unit= in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:intensity_unit ] ;
    sh:targetClass fof_ct:RNASpotBiologicalTable .

fof_ct:RNASpotQualityTable a sh:NodeShape ;
    rdfs:comment "The RNA Spot Quality table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_rna_quality). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the TSV serialisation) together with the full collection of RNASpotQualityRecord rows. Submission of this table is optional but recommended." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements. Conditionally required when any intensity metric is present. Written as #Intensity_Measurement_Method: in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" "FOF-CT_vol_core" "FOF-CT_vol_quality" "FOF-CT_undecoded" ) ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path fof_ct:additional_tables ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used for any intensity metric reported in user-defined columns. Conditionally required when any such metric is present. Written as ##Intensity_Unit= in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:class fof_ct:RNASpotQualityRecord ;
            sh:description "The complete collection of RNASpotQualityRecord rows constituting this dataset. Each record corresponds to one data row in the TSV serialisation and must include at least one user-defined quality metric column." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path fof_ct:rna_spot_quality_records ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:description ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:lab_name ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Required only when software was used; omit the block entirely if no software was applied. Written as repeating #Software_* blocks in the file header." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. Must always be '4dn_FOF-CT_rna_quality'. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_rna_quality" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:description "Unit used for any time metric reported in user-defined columns. Conditionally required when any such metric is present. Written as ##Time_Unit= in the file header." ;
            sh:in ( "s" "sec" "ms" "msec" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path fof_ct:time_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ] ;
    sh:targetClass fof_ct:RNASpotQualityTable .

fof_ct:RNASpotTable a sh:NodeShape ;
    rdfs:comment "The RNA Spot Data table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_rna). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the CSV serialisation) together with the full collection of RNA Spots (recorded as data rows). Analogous to the MappingSet class in SSSOM. This table is optional but recommended when RNA data are collected alongside Chromatin Tracing." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fof_ct:description ],
        [ sh:class fof_ct:RNASpot ;
            sh:description "The complete collection of RNA Spots constituting this dataset. Each RNASpot corresponds to one data row in the TSV serialisation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path fof_ct:rna_spots ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:lab_name ],
        [ sh:datatype xsd:string ;
            sh:description "Type of gene identifier used in the gene_id column (e.g. Ensembl_V38, NCBI_Gene). Written as ##Gene_ID_Type= in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:gene_id_type ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Genome build used for Chrom, Chrom_Start and Chrom_End coordinates. The 4DN Data Portal accepts GRCh38 (human) and GRCm38 (mouse). When the genome under study contains an INSERTION or DELETION the value must use the mandatory 'custom-build:' prefix followed by a descriptive name (e.g., custom-build:GRCm38+pJT039(insertion)). Written as ##Genome_Assembly= in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:genome_assembly ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" "FOF-CT_vol_core" "FOF-CT_vol_quality" "FOF-CT_undecoded" ) ;
            sh:minCount 1 ;
            sh:order 10 ;
            sh:path fof_ct:additional_tables ],
        [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Type of transcript identifier used in the transcript_id column (e.g. Ensembl_V38, RefSeq). Conditionally required when multiple transcripts share the same gene_id and the FISH probe can distinguish among them. Written as ##Transcript_ID_Type= in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:transcript_id_type ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. The required value is specific to each table. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_rna" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ] ;
    sh:targetClass fof_ct:RNASpotTable .

fof_ct:ROIMappingTable a sh:NodeShape ;
    rdfs:comment "The Cell/ROI Mapping table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_mapping). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the TSV serialisation) together with the full collection of ROI boundary records (recorded as data rows). This table is conditionally required whenever a Cell Data table, a Sub-Cell ROI Data table, or an Extra-Cell ROI Data table is deposited. Analogous to the MappingSet class in SSSOM." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fof_ct:description ],
        [ sh:datatype xsd:string ;
            sh:description "The type of cells present in this dataset, expressed using an ontology term from the Experimental Factor Ontology (EFO). Examples include \"Primary cell line\", \"Immortal cell line\", \"Induced pluripotent stem (IPS) cell\", \"Cell in tissue\", \"Cell in organoid\", \"Other\". Written as #Cell_Type: in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:cell_type ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required (metric-triggered) when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" "FOF-CT_vol_core" "FOF-CT_vol_quality" "FOF-CT_undecoded" ) ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path fof_ct:additional_tables ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:lab_name ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of how ROI boundaries are encoded, beyond what the format name alone conveys (e.g. coordinate order, dimensionality, or an external file reference). Conditionally required (content-triggered): MANDATORY when roi_boundaries_format_type is 'Other'; otherwise recommended." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fof_ct:roi_boundaries_format_description ],
        [ sh:description "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required (metric- triggered) when any time metric is reported in an optional column." ;
            sh:in ( "s" "sec" "ms" "msec" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 14 ;
            sh:path fof_ct:time_unit ],
        [ sh:class fof_ct:ROIMapping ;
            sh:description "The complete collection of ROI boundary records constituting this dataset. Each ROIMapping corresponds to one data row in the TSV serialisation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path fof_ct:roi_mappings ],
        [ sh:datatype xsd:string ;
            sh:description "The type of extracellular structure ROI within which cells are embedded, expressed using an EFO 'organism part' child term (e.g. Tissue, Organoid). Conditionally required when extracellular structure ROIs are identified and reported in a dedicated Extra-Cell ROI Data table. Written as #Extra_Cell_ROI_Type: in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fof_ct:extra_cell_roi_type ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. The required value is specific to each table. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_mapping" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:description "Controlled-vocabulary identifier of the standard used to encode ROI boundaries in global coordinates (e.g. OME_Polygon for the OME ROI data model, or Mesh_OBJ for a 3D OBJ mesh). Written as ##ROI_Boundaries_Format_Type= in the file header. Default value is OME_Polygon." ;
            sh:in ( "OME_Polygon" "OME_Mask" "Mesh_OBJ" "Mesh_STL" "Mesh_PLY" "GeoJSON" "WKT" "Label_Mask_Image" "Other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path fof_ct:roi_boundaries_format_type ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required (metric-triggered) when any intensity metric is reported in an optional column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:datatype xsd:string ;
            sh:description "The type of sub-cellular structure ROI documented in this table or mapping file. It is recommended to use a GO 'cellular_component' child term. Examples include Nucleolus, Nuclear Lamina (NL), Nuclear Pore Complex (NPC), PML_body, Cajal_body, Chromosome_Domain. Written as #Sub_Cell_ROI_Type: in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:sub_cell_roi_type ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ] ;
    sh:targetClass fof_ct:ROIMappingTable .

fof_ct:SMLocalizationQualityTable a sh:NodeShape ;
    rdfs:comment "The SM Localization Quality table of a FOF-vol-CT dataset (namespace: FOF-CT_vol_quality, no 4dn_ prefix). Requirement level: optional (recommended). Only vol_core (table 13) is mandatory for FOF-vol-CT submissions; this table provides localization quality metrics indexed by Loc_ID when submitted." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fof_ct:SMLocalizationQualityRecord ;
            sh:description "The complete collection of SMLocalizationQualityRecord rows constituting this dataset. Each record corresponds to one data row in the TSV serialisation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path fof_ct:sm_localization_quality_records ],
        [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" "FOF-CT_vol_core" "FOF-CT_vol_quality" "FOF-CT_undecoded" ) ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path fof_ct:additional_tables ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:description ],
        [ sh:description "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required (metric- triggered) when any time metric is reported in an optional column." ;
            sh:in ( "s" "sec" "ms" "msec" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path fof_ct:time_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:lab_name ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required (metric-triggered) when any intensity metric is reported in an optional column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required (metric-triggered) when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. Must always be 'FOF-CT_vol_quality' (no 4dn_ prefix — this FOF-vol-CT-exclusive namespace intentionally omits it). Written as ##Table_Namespace= in the file header." ;
            sh:in ( "FOF-CT_vol_quality" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ] ;
    sh:targetClass fof_ct:SMLocalizationQualityTable .

fof_ct:SMLocalizationTable a sh:NodeShape ;
    rdfs:comment "The SM Localization Data table of a FOF-vol-CT dataset (namespace: FOF-CT_vol_core, no 4dn_ prefix). This is the mandatory primary data table for volumetric FOF-CT submissions. Each row corresponds to one SM localization event. The Spot/Trace Data table is optional for FOF-vol-CT submissions but may be included to report post-processing results derived from the localization data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required (metric-triggered) when any intensity metric is reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fof_ct:intensity_measurement_method ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:lab_name ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Genome build used for Chrom, Chrom_Start and Chrom_End coordinates. The 4DN Data Portal accepts GRCh38 (human) and GRCm38 (mouse). When the genome under study contains an INSERTION or DELETION the value must use the mandatory 'custom-build:' prefix followed by a descriptive name (e.g., custom-build:GRCm38+pJT039(insertion)). Written as ##Genome_Assembly= in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fof_ct:genome_assembly ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the Variant Call Format (VCF) file that must be submitted alongside the dataset to describe the genome insertion or deletion. Conditionally required (content-triggered) when genome_assembly uses the 'custom-build:' prefix. Applies to both the core (bas) and vol_core (vol) tables. Written as ##VCF_File_Name= in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:vcf_file_name ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the nature and genomic position of a DNA insertion or deletion in the genome under study. Conditionally required (content- triggered) when genome_assembly uses the 'custom-build:' prefix. Applies to both the core (bas) and vol_core (vol) tables. Written as ##Modification= in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fof_ct:modification ],
        [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 12 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" "FOF-CT_vol_core" "FOF-CT_vol_quality" "FOF-CT_undecoded" ) ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path fof_ct:additional_tables ],
        [ sh:class fof_ct:SMLocalization ;
            sh:description "The complete collection of SMLocalization events constituting this dataset. Each entry corresponds to one data row in the TSV serialisation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path fof_ct:sm_localizations ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:description ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the VCF format used for the accompanying VCF file. Conditionally required (content-triggered) when genome_assembly uses the 'custom-build:' prefix. Applies to both the core (bas) and vol_core (vol) tables. Written as ##VCF_Version= in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:vcf_version ],
        [ sh:description "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required (metric- triggered) when any time metric is reported in an optional column." ;
            sh:in ( "s" "sec" "ms" "msec" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path fof_ct:time_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required (metric-triggered) when any intensity metric is reported in an optional column." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. Must always be 'FOF-CT_vol_core' (no 4dn_ prefix — this FOF-vol-CT-exclusive namespace intentionally omits it). Written as ##Table_Namespace= in the file header." ;
            sh:in ( "FOF-CT_vol_core" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ] ;
    sh:targetClass fof_ct:SMLocalizationTable .

fof_ct:SpotBiologicalTable a sh:NodeShape ;
    rdfs:comment "The Spot Biological Data table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_bio). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the TSV serialisation) together with the full collection of SpotBiologicalRecord rows. Submission of this table is optional but highly recommended." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fof_ct:description ],
        [ sh:class fof_ct:Software ;
            sh:description "One or more Software entries documenting every tool used to produce or process data in this table. Required only when software was used; omit the block entirely if no software was applied. Written as repeating #Software_* blocks in the file header." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fof_ct:softwares ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fof_ct:lab_name ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier for this table type. Must always be '4dn_FOF-CT_bio'. Written as ##Table_Namespace= in the file header." ;
            sh:in ( "4dn_FOF-CT_bio" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fof_ct:table_namespace ],
        [ sh:description "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table." ;
            sh:in ( "nm" "micron" "mm" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path fof_ct:xyz_unit ],
        [ sh:datatype xsd:string ;
            sh:description "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fof_ct:experimenter_name ],
        [ sh:description "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
            sh:in ( "4dn_FOF-CT_core" "4dn_FOF-CT_demultiplexing" "4dn_FOF-CT_trace" "4dn_FOF-CT_rna" "4dn_FOF-CT_quality" "4dn_FOF-CT_rna_quality" "4dn_FOF-CT_bio" "4dn_FOF-CT_rna_bio" "4dn_FOF-CT_cell" "4dn_FOF-CT_extracell" "4dn_FOF-CT_subcell" "4dn_FOF-CT_mapping" "FOF-CT_vol_core" "FOF-CT_vol_quality" "FOF-CT_undecoded" ) ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path fof_ct:additional_tables ],
        [ sh:datatype xsd:string ;
            sh:description "Unit used for any intensity metric reported in user-defined columns. Conditionally required when any such metric is present. Written as ##Intensity_Unit= in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fof_ct:intensity_unit ],
        [ sh:description "Unit used for any time metric reported in user-defined columns. Conditionally required when any such metric is present. Written as ##Time_Unit= in the file header." ;
            sh:in ( "s" "sec" "ms" "msec" "min" "hr" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path fof_ct:time_unit ],
        [ sh:class fof_ct:SpotBiologicalRecord ;
            sh:description "The complete collection of SpotBiologicalRecord rows constituting this dataset. Each record corresponds to one data row in the TSV serialisation and must include at least one user-defined biological property column." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path fof_ct:spot_biological_records ],
        [ sh:datatype xsd:string ;
            sh:description "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fof_ct:experimenter_contact ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fof_ct:fof_ct_version ;
            sh:pattern "^v[0-9]+\\.[0-9]+" ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to perform intensity measurements. Conditionally required when any intensity metric is present. Written as #Intensity_Measurement_Method: in the file header." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fof_ct:intensity_measurement_method ] ;
    sh:targetClass fof_ct:SpotBiologicalTable .

