    skos:definition "A single row in the RNA Spot Quality table. Each instance captures one or more quality metrics for a specific RNA bright Spot identified by RNA_Spot_ID. RNA_Spot_ID values must be unique across the dataset, linking to the corresponding record in the RNA Spot Data table (table 4). RNA_Spot_ID, Channel and Fluor are mandatory; all other reserved quality-metric columns are conditionally required (the same reserved vocabulary as the Spot Quality table) or fully free-form; users declare the latter via #^ header lines." ;
    skos:inScheme fof_ct:rna_quality .

<https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#GeoJSON> a owl:Class ;
    rdfs:label "GeoJSON" ;
    rdfs:subClassOf fof_ct:ROIBoundariesFormatTypeEnum,
        linkml:PermissibleValue ;
    skos:definition "Boundary described using the GeoJSON format." .

<https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#Label_Mask_Image> a owl:Class ;
    rdfs:label "Label_Mask_Image" ;
    rdfs:subClassOf fof_ct:ROIBoundariesFormatTypeEnum,
        linkml:PermissibleValue ;
    skos:definition "Boundary described as a labeled mask image." .

<https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#Mesh_OBJ> a owl:Class ;
    rdfs:label "Mesh_OBJ" ;
    rdfs:subClassOf fof_ct:ROIBoundariesFormatTypeEnum,
        linkml:PermissibleValue ;
    skos:definition "3D mesh boundary described using the Wavefront OBJ format." .

<https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#Mesh_PLY> a owl:Class ;
    rdfs:label "Mesh_PLY" ;
    rdfs:subClassOf fof_ct:ROIBoundariesFormatTypeEnum,
        linkml:PermissibleValue ;
    skos:definition "3D mesh boundary described using the PLY format." .

<https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#Mesh_STL> a owl:Class ;
    rdfs:label "Mesh_STL" ;
    rdfs:subClassOf fof_ct:ROIBoundariesFormatTypeEnum,
        linkml:PermissibleValue ;
    skos:definition "3D mesh boundary described using the STL format." .

<https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#OME_Mask> a owl:Class ;
    rdfs:label "OME_Mask" ;
    rdfs:subClassOf fof_ct:ROIBoundariesFormatTypeEnum,
        linkml:PermissibleValue ;
    skos:definition "OME ROI data model, mask representation." .

<https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#OME_Polygon> a owl:Class ;
    rdfs:label "OME_Polygon" ;
    rdfs:subClassOf fof_ct:ROIBoundariesFormatTypeEnum,
        linkml:PermissibleValue ;
    skos:definition "OME ROI data model, polygon representation (default)." .

<https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#Other> a owl:Class ;
    rdfs:label "Other" ;
    rdfs:subClassOf fof_ct:ROIBoundariesFormatTypeEnum,
        linkml:PermissibleValue ;
    skos:definition "Any other boundary format. When used, ROI_Boundaries_Format_Description becomes mandatory." .

<https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#WKT> a owl:Class ;
    rdfs:label "WKT" ;
    rdfs:subClassOf fof_ct:ROIBoundariesFormatTypeEnum,
        linkml:PermissibleValue ;
    skos:definition "Boundary described using Well-Known Text." .

fof_ct:SMLocalization a owl:Class ;
    rdfs:label "SMLocalization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:extra_cell_roi_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:spot_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:sub_cell_roi_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:trace_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:chrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:loc_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:extra_cell_roi_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:cell_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:x ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom fof_ct:LocalizationMixin ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:sub_cell_roi_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:extra_cell_roi_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:trace_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:chrom ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:chrom_end ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:spot_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:z ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:trace_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:chrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:chrom_start ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:sub_cell_roi_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:chrom_start ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:chrom_start ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:z ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:cell_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:y ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:chrom_end ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:loc_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:loc_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:chrom_end ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:spot_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:z ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:cell_id ],
        linkml:ClassDefinition ;
    skos:definition "A single individual single-molecule (SM) localization event in a FOF-vol-CT dataset. Each instance corresponds to one row in the TSV data section of the SM Localization Data table. The loc_id field is the primary key; spot_id links this localization to its parent Spot (if Spot/Trace post-processing was performed); trace_id links it to its parent Trace. Sub_Cell_ROI_ID, Cell_ID and Extra_Cell_ROI_ID optionally link the localization to spatial context tables." ;
    skos:inScheme fof_ct:vol_core .

