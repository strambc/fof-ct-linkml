fof_ct:SubCellROI a owl:Class ;
    rdfs:label "SubCellROI" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:cell_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:cell_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:sub_cell_roi_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:sub_cell_roi_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:cell_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:sub_cell_roi_id ],
        linkml:ClassDefinition ;
    skos:definition "A single sub-cellular structure ROI (e.g. nucleolus, nuclear lamina, PML body, chromosome domain) identified in a FOF-bas-CT experiment. Each instance of this class corresponds to one row in the TSV data section of the FOF-CT Sub-Cell ROI Data table. The sub_cell_roi_id field uniquely identifies each ROI and links to the core table, the Cell Data table, and the Cell/ROI Mapping table. This class accepts additional user-defined optional columns (e.g. ROI_Volume, ROI_Area). At least one such user-defined column MUST be present per submission." ;
    skos:inScheme fof_ct:subcell .

