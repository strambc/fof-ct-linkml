fof_ct:Trace a owl:Class ;
    rdfs:label "Trace" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:trace_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:trace_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:trace_id ],
        linkml:ClassDefinition ;
    skos:definition "A single chromatin Trace representing global properties associated with an entire polymeric trace rather than with individual Spots. Each instance of this class corresponds to one row in the CSV data section of the FOF-CT Trace Data table. The trace_id links each Trace to the core table and to the RNA Spot Data table. IMPORTANT: this class MUST contain at least one user-defined optional column describing trace-level properties (e.g., Allele, RNA_Expression, Lamina_Distance). User-defined columns are accommodated via open schema." ;
    skos:inScheme fof_ct:trace .

fof_ct:UndecodedLocalization a owl:Class ;
    rdfs:label "UndecodedLocalization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:channel_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:channel_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:the_z ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:loc_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:fluorophore_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:the_z ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:image_frame_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:z ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:channel_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:the_z ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:image_frame_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:hyb_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:loc_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:loc_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:z ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:z ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:y ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:image_frame_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:fluorophore_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:x ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:fluorophore_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:x ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:hyb_id ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom fof_ct:LocalizationMixin ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:hyb_id ],
        linkml:ClassDefinition ;
    skos:definition "A single raw, undecoded SM localization event in a FOF-vol-CT dataset. Each instance corresponds to one row in the TSV data section of the Undecoded SM Localization Data table. This class uses LocalizationMixin for the shared loc_id, x, y, z slots. The 8 mandatory columns, in order, are: Loc_ID, Hyb_ID, Image_Frame_ID, X, Y, Z, Channel, Fluor. TheZ (the_z) is a reserved, conditionally-required column for the focal Z-plane identifier." ;
    skos:inScheme fof_ct:undecoded .

<https://w3id.org/fof-ct/XYZUnitEnum#micron> a owl:Class ;
    rdfs:label "micron" ;
    rdfs:subClassOf fof_ct:XYZUnitEnum,
        linkml:PermissibleValue ;
    skos:definition "Micrometres. Use 'micron' rather than the Greek symbol μm to avoid encoding issues." .

<https://w3id.org/fof-ct/XYZUnitEnum#mm> a owl:Class ;
    rdfs:label "mm" ;
    rdfs:subClassOf fof_ct:XYZUnitEnum,
        linkml:PermissibleValue ;
    skos:definition "Millimetres" .

<https://w3id.org/fof-ct/XYZUnitEnum#nm> a owl:Class ;
    rdfs:label "nm" ;
    rdfs:subClassOf fof_ct:XYZUnitEnum,
        linkml:PermissibleValue ;
    skos:definition "Nanometres" .

fof_ct:cells a owl:ObjectProperty ;
    rdfs:label "cells" ;
    rdfs:domain fof_ct:CellTable ;
    rdfs:range fof_ct:Cell ;
    skos:definition "The complete collection of Cells constituting this dataset. Each Cell corresponds to one data row in the TSV serialisation. At least one user-defined optional column (e.g. Cell_Size, Cell_Volume) MUST be present in every submitted Cell Data table." ;
    skos:inScheme fof_ct:cell .

fof_ct:extra_cell_rois a owl:ObjectProperty ;
    rdfs:label "extra_cell_rois" ;
    rdfs:domain fof_ct:ExtraCellROITable ;
    rdfs:range fof_ct:ExtraCellROI ;
    skos:definition "The complete collection of extracellular ROIs constituting this dataset. Each ExtraCellROI corresponds to one data row in the TSV serialisation. At least one user-defined optional column (e.g. ROI_Volume, Cell_Count) MUST be present in every submitted Extra-Cell ROI Data table." ;
    skos:inScheme fof_ct:extracell .

fof_ct:localizations a owl:ObjectProperty ;
    rdfs:label "localizations" ;
    rdfs:domain fof_ct:DemultiplexingTable ;
    rdfs:range fof_ct:Localization ;
    skos:definition "The complete collection of Localization events constituting this dataset. Each Localization corresponds to one data row in the TSV serialisation." ;
    skos:inScheme fof_ct:demultiplexing .

fof_ct:rna_spot_biological_records a owl:ObjectProperty ;
    rdfs:label "rna_spot_biological_records" ;
    rdfs:domain fof_ct:RNASpotBiologicalTable ;
    rdfs:range fof_ct:RNASpotBiologicalRecord ;
    skos:definition "The complete collection of RNASpotBiologicalRecord rows constituting this dataset. Each record corresponds to one data row in the TSV serialisation and must include at least one user-defined biological property column." ;
    skos:inScheme fof_ct:rna_bio .

fof_ct:rna_spot_quality_records a owl:ObjectProperty ;
    rdfs:label "rna_spot_quality_records" ;
    rdfs:domain fof_ct:RNASpotQualityTable ;
    rdfs:range fof_ct:RNASpotQualityRecord ;
    skos:definition "The complete collection of RNASpotQualityRecord rows constituting this dataset. Each record corresponds to one data row in the TSV serialisation and must include at least one user-defined quality metric column." ;
    skos:inScheme fof_ct:rna_quality .

fof_ct:rna_spots a owl:ObjectProperty ;
    rdfs:label "rna_spots" ;
    rdfs:domain fof_ct:RNASpotTable ;
    rdfs:range fof_ct:RNASpot ;
    skos:definition "The complete collection of RNA Spots constituting this dataset. Each RNASpot corresponds to one data row in the TSV serialisation." ;
    skos:inScheme fof_ct:rna .

fof_ct:roi_mappings a owl:ObjectProperty ;
    rdfs:label "roi_mappings" ;
    rdfs:domain fof_ct:ROIMappingTable ;
    rdfs:range fof_ct:ROIMapping ;
    skos:definition "The complete collection of ROI boundary records constituting this dataset. Each ROIMapping corresponds to one data row in the TSV serialisation." ;
    skos:inScheme fof_ct:mapping .

fof_ct:sm_localization_quality_records a owl:ObjectProperty ;
    rdfs:label "sm_localization_quality_records" ;
    rdfs:domain fof_ct:SMLocalizationQualityTable ;
    rdfs:range fof_ct:SMLocalizationQualityRecord ;
    skos:definition "The complete collection of SMLocalizationQualityRecord rows constituting this dataset. Each record corresponds to one data row in the TSV serialisation." ;
    skos:inScheme fof_ct:vol_quality .

fof_ct:sm_localizations a owl:ObjectProperty ;
    rdfs:label "sm_localizations" ;
    rdfs:domain fof_ct:SMLocalizationTable ;
    rdfs:range fof_ct:SMLocalization ;
    skos:definition "The complete collection of SMLocalization events constituting this dataset. Each entry corresponds to one data row in the TSV serialisation." ;
    skos:inScheme fof_ct:vol_core .

fof_ct:spot_biological_records a owl:ObjectProperty ;
    rdfs:label "spot_biological_records" ;
    rdfs:domain fof_ct:SpotBiologicalTable ;
    rdfs:range fof_ct:SpotBiologicalRecord ;
    skos:definition "The complete collection of SpotBiologicalRecord rows constituting this dataset. Each record corresponds to one data row in the TSV serialisation and must include at least one user-defined biological property column." ;
    skos:inScheme fof_ct:bio .

fof_ct:spot_quality_records a owl:ObjectProperty ;
    rdfs:label "spot_quality_records" ;
    rdfs:domain fof_ct:SpotQualityTable ;
    rdfs:range fof_ct:SpotQualityRecord ;
    skos:definition "The complete collection of SpotQualityRecord rows constituting this dataset. Each record corresponds to one data row in the TSV serialisation and must include at least one user-defined quality metric column." ;
    skos:inScheme fof_ct:quality .

fof_ct:spots a owl:ObjectProperty ;
    rdfs:label "spots" ;
    rdfs:domain fof_ct:SpotTable ;
    rdfs:range fof_ct:Spot ;
    skos:definition "The complete collection of Spots constituting this dataset. Each Spot corresponds to one data row in the TSV serialisation." ;
    skos:inScheme <https://w3id.org/fof-ct> .

fof_ct:sub_cell_rois a owl:ObjectProperty ;
    rdfs:label "sub_cell_rois" ;
    rdfs:domain fof_ct:SubCellROITable ;
    rdfs:range fof_ct:SubCellROI ;
    skos:definition "The complete collection of sub-cellular ROIs constituting this dataset. Each SubCellROI corresponds to one data row in the TSV serialisation. At least one user-defined optional column (e.g. ROI_Volume, ROI_Area) MUST be present in every submitted Sub-Cell ROI Data table." ;
    skos:inScheme fof_ct:subcell .

fof_ct:traces a owl:ObjectProperty ;
    rdfs:label "traces" ;
    rdfs:domain fof_ct:TraceTable ;
    rdfs:range fof_ct:Trace ;
    skos:definition "The complete collection of Traces constituting this dataset. Each Trace corresponds to one data row in the TSV serialisation." ;
    skos:inScheme fof_ct:trace .

fof_ct:undecoded_localizations a owl:ObjectProperty ;
    rdfs:label "undecoded_localizations" ;
    rdfs:domain fof_ct:UndecodedLocalizationTable ;
    rdfs:range fof_ct:UndecodedLocalization ;
    skos:definition "The complete collection of UndecodedLocalization events constituting this dataset. Each entry corresponds to one data row in the TSV serialisation." ;
    skos:inScheme fof_ct:undecoded .

<https://w3id.org/fof-ct> a owl:Ontology ;
    rdfs:label "fof_ct" ;
    dcterms:license "MIT" ;
    dcterms:title "FISH Omics Format for Chromatin Tracing (FOF-CT)" ;
    pav:version "1.0.0" ;
    rdfs:seeAlso <https://4dn-dcic.github.io/fof-ct>,
        <https://fish-omics-format.readthedocs.io/> ;
    skos:definition "Root schema for the FISH Omics Format for Chromatin Tracing (FOF-CT). Covers both modalities: FOF-bas-CT (ball-and-stick, tables 1–12) and FOF-vol-CT (volumetric, tables 13–15). Imports all fifteen table schemas that together constitute the complete FOF-CT data model. Each table schema in turn imports fof_bas_ct_common for shared slots, the Software class, and enumerations." .

fof_ct:RNASpotTable a owl:Class ;
    rdfs:label "RNASpotTable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:gene_id_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:lab_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:experimenter_contact ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:table_namespace ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:transcript_id_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "4dn_FOF-CT_rna" ] ) ] ) ] ;
            owl:onProperty fof_ct:table_namespace ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:gene_id_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:lab_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:gene_id_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:experimenter_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:fof_ct_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:fof_ct_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:rna_spots ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:XYZUnitEnum ;
            owl:onProperty fof_ct:xyz_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:genome_assembly ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:table_namespace ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:experimenter_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:RNASpot ;
            owl:onProperty fof_ct:rna_spots ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:experimenter_contact ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^v[0-9]+\\.[0-9]+" ] ) ] ) ] ;
            owl:onProperty fof_ct:fof_ct_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:softwares ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:genome_assembly ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ] ) ] ) ] ;
            owl:onProperty fof_ct:experimenter_contact ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:additional_tables ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:xyz_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:genome_assembly ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:lab_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:TableNamespaceEnum ;
            owl:onProperty fof_ct:additional_tables ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:Software ;
            owl:onProperty fof_ct:softwares ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:experimenter_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:transcript_id_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:xyz_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:transcript_id_type ],
        linkml:ClassDefinition ;
    skos:definition "The RNA Spot Data table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_rna). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the CSV serialisation) together with the full collection of RNA Spots (recorded as data rows). Analogous to the MappingSet class in SSSOM. This table is optional but recommended when RNA data are collected alongside Chromatin Tracing." ;
    skos:inScheme fof_ct:rna .

fof_ct:ROIMapping a owl:Class ;
    rdfs:label "ROIMapping" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:roi_boundaries ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:cell_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:extra_cell_roi_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:sub_cell_roi_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:roi_boundaries ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:cell_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:cell_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:extra_cell_roi_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:sub_cell_roi_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:sub_cell_roi_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:extra_cell_roi_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:roi_boundaries ],
        linkml:ClassDefinition ;
    owl:disjointUnionOf ( [ owl:intersectionOf ( [ a owl:Restriction ;
                            owl:allValuesFrom xsd:string ;
                            owl:onProperty fof_ct:cell_id ] [ a owl:Restriction ;
                            owl:allValuesFrom xsd:string ;
                            owl:onProperty fof_ct:extra_cell_roi_id ] [ a owl:Restriction ;
                            owl:allValuesFrom xsd:string ;
                            owl:onProperty fof_ct:sub_cell_roi_id ] ) ] [ owl:intersectionOf ( [ a owl:Restriction ;
                            owl:allValuesFrom xsd:string ;
                            owl:onProperty fof_ct:cell_id ] [ a owl:Restriction ;
                            owl:allValuesFrom xsd:string ;
                            owl:onProperty fof_ct:extra_cell_roi_id ] [ a owl:Restriction ;
                            owl:allValuesFrom xsd:string ;
                            owl:onProperty fof_ct:sub_cell_roi_id ] ) ] [ owl:intersectionOf ( [ a owl:Restriction ;
                            owl:allValuesFrom xsd:string ;
                            owl:onProperty fof_ct:cell_id ] [ a owl:Restriction ;
                            owl:allValuesFrom xsd:string ;
                            owl:onProperty fof_ct:extra_cell_roi_id ] [ a owl:Restriction ;
                            owl:allValuesFrom xsd:string ;
                            owl:onProperty fof_ct:sub_cell_roi_id ] ) ] ) ;
    skos:definition "A single boundary record for one Cell, Sub-Cell ROI, or Extra-Cell ROI in a FOF-bas-CT experiment. Each instance corresponds to one row in the TSV data section of the FOF-CT Cell/ROI Mapping table. Exactly one of the three identifier slots (sub_cell_roi_id, cell_id, extra_cell_roi_id) must be populated per file; the choice of identifier must be consistent across all rows of a given submission. The roi_boundaries slot holds the boundary coordinates in the format specified by roi_boundaries_format in the table header. This class accepts additional user-defined optional columns." ;
    skos:inScheme fof_ct:mapping .

fof_ct:ROIMappingTable a owl:Class ;
    rdfs:label "ROIMappingTable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:time_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:extra_cell_roi_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:cell_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:fof_ct_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:intensity_measurement_method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:softwares ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:intensity_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:experimenter_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:lab_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:experimenter_contact ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "4dn_FOF-CT_mapping" ] ) ] ) ] ;
            owl:onProperty fof_ct:table_namespace ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:ROIMapping ;
            owl:onProperty fof_ct:roi_mappings ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:extra_cell_roi_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:intensity_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:roi_boundaries_format_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:roi_boundaries_format_description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:roi_mappings ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:fof_ct_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:lab_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:extra_cell_roi_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:table_namespace ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:xyz_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:time_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:roi_boundaries_format_description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:additional_tables ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:cell_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:TimeUnitEnum ;
            owl:onProperty fof_ct:time_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:ROIBoundariesFormatTypeEnum ;
            owl:onProperty fof_ct:roi_boundaries_format_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:intensity_measurement_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:roi_boundaries_format_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:xyz_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:experimenter_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:table_namespace ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:sub_cell_roi_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:TableNamespaceEnum ;
            owl:onProperty fof_ct:additional_tables ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:sub_cell_roi_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:cell_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:lab_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:sub_cell_roi_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:experimenter_contact ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:roi_boundaries_format_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:Software ;
            owl:onProperty fof_ct:softwares ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:XYZUnitEnum ;
            owl:onProperty fof_ct:xyz_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:intensity_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ] ) ] ) ] ;
            owl:onProperty fof_ct:experimenter_contact ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:intensity_measurement_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^v[0-9]+\\.[0-9]+" ] ) ] ) ] ;
            owl:onProperty fof_ct:fof_ct_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:experimenter_name ],
        linkml:ClassDefinition ;
    skos:definition "The Cell/ROI Mapping table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_mapping). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the TSV serialisation) together with the full collection of ROI boundary records (recorded as data rows). This table is conditionally required whenever a Cell Data table, a Sub-Cell ROI Data table, or an Extra-Cell ROI Data table is deposited. Analogous to the MappingSet class in SSSOM." ;
    skos:inScheme fof_ct:mapping .

fof_ct:gene_id a owl:DatatypeProperty ;
    rdfs:label "gene_id" ;
    rdfs:domain fof_ct:RNASpot ;
    rdfs:range xsd:string ;
    skos:definition "Official gene identifier corresponding to rna_name. The type of identifier used (e.g. Ensembl gene ID, NCBI Gene ID) must be declared in the gene_id_type header field." ;
    skos:inScheme fof_ct:rna .

fof_ct:gene_id_type a owl:DatatypeProperty ;
    rdfs:label "gene_id_type" ;
    rdfs:domain fof_ct:RNASpotTable ;
    rdfs:range xsd:string ;
    skos:definition "Type of gene identifier used in the gene_id column (e.g. Ensembl_V38, NCBI_Gene). Written as ##Gene_ID_Type= in the file header." ;
    skos:inScheme fof_ct:rna .

fof_ct:hyb_id a owl:DatatypeProperty ;
    rdfs:label "hyb_id" ;
    rdfs:range xsd:integer ;
    skos:definition "Unique identifier for the hybridization round in which this localization event was detected. Written as the Hyb_ID column. Mandatory in the Undecoded SM Localization table." ;
    skos:inScheme fof_ct:common .

fof_ct:image_frame_id a owl:DatatypeProperty ;
    rdfs:label "image_frame_id" ;
    rdfs:range xsd:integer ;
    skos:definition "Unique integer identifier for the imaging frame in which this undecoded localization event was detected. Written as the Image_Frame_ID column. Mandatory in the Undecoded SM Localization table." ;
    skos:inScheme fof_ct:common .

fof_ct:rna_name a owl:DatatypeProperty ;
    rdfs:label "rna_name" ;
    rdfs:domain fof_ct:RNASpot ;
    rdfs:range xsd:string ;
    skos:definition "Official name of the gene from which the targeted RNA is transcribed (e.g. ACTB, GAPDH). Should follow HGNC (human) or MGI (mouse) gene nomenclature." ;
    skos:inScheme fof_ct:rna .

fof_ct:roi_boundaries a owl:DatatypeProperty ;
    rdfs:label "roi_boundaries" ;
    rdfs:domain fof_ct:ROIMapping ;
    rdfs:range xsd:string ;
    skos:definition "Boundary coordinates for this Cell or ROI, encoded in the format specified by roi_boundaries_format in the table header. For the OME ROI Polygon model, coordinates are provided as a space-separated list of \"x,y\" pairs (e.g. \"12.5,40.2 13.1,41.0 ...\"). For OBJ 3D mesh format, the field contains the vertex and face list for the boundary mesh." ;
    skos:inScheme fof_ct:mapping .

fof_ct:roi_boundaries_format_description a owl:DatatypeProperty ;
    rdfs:label "roi_boundaries_format_description" ;
    rdfs:domain fof_ct:ROIMappingTable ;
    rdfs:range xsd:string ;
    skos:definition "Free-text description of how ROI boundaries are encoded, sufficient for unambiguous parsing of all roi_boundaries values in this file (e.g. coordinate order, dimensionality, or an external file reference). Written as ##ROI_Boundaries_Format_Description= in the file header. Conditionally required (content-triggered): MANDATORY whenever roi_boundaries_format_type is 'Other'; otherwise recommended." ;
    skos:inScheme fof_ct:mapping .

fof_ct:roi_boundaries_format_type a owl:ObjectProperty ;
    rdfs:label "roi_boundaries_format_type" ;
    rdfs:domain fof_ct:ROIMappingTable ;
    rdfs:range fof_ct:ROIBoundariesFormatTypeEnum ;
    skos:definition "Controlled-vocabulary identifier of the standard used to encode ROI boundaries in global coordinates (e.g. OME_Polygon for the OME ROI data model, or Mesh_OBJ for a 3D OBJ mesh). Written as ##ROI_Boundaries_Format_Type= in the file header. Default value is OME_Polygon." ;
    skos:inScheme fof_ct:mapping .

fof_ct:software_authors a owl:DatatypeProperty ;
    rdfs:label "software_authors" ;
    rdfs:range xsd:string ;
    skos:definition "Author name(s) in 'Surname, Firstname' format, multiple authors separated by semicolons. Written as #Software_Authors:." ;
    skos:inScheme fof_ct:common .

fof_ct:software_description a owl:DatatypeProperty ;
    rdfs:label "software_description" ;
    rdfs:range xsd:string ;
    skos:definition "Free-text description of the algorithm used, sufficient to guarantee reproducibility. Written as #Software_Description:." ;
    skos:inScheme fof_ct:common .

fof_ct:software_parameters a owl:DatatypeProperty ;
    rdfs:label "software_parameters" ;
    rdfs:range xsd:string ;
    skos:definition "Free-text description of the input parameters used for the specific analysis run performed using this Software. Should provide sufficient detail about the analysis parameters used to guarantee interpretation and reproducibility (e.g. input parameters used for assessing the precision of single molecule localization or drift correction in X, Y and Z). Written as #Software_Parameters:." ;
    skos:inScheme fof_ct:common .

fof_ct:software_preferred_citation_id a owl:DatatypeProperty ;
    rdfs:label "software_preferred_citation_id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Unique identifier (DOI, PMCID, ArXiv ID, etc.) for the primary publication describing this software. Written as #Software_PreferredCitationID:." ;
    skos:inScheme fof_ct:common .

fof_ct:software_repository a owl:DatatypeProperty ;
    rdfs:label "software_repository" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URL of the repository where the software release can be obtained. Written as #Software_Repository:." ;
    skos:inScheme fof_ct:common .

fof_ct:software_title a owl:DatatypeProperty ;
    rdfs:label "software_title" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the software tool. Written as #Software_Title:." ;
    skos:inScheme fof_ct:common .

fof_ct:software_type a owl:ObjectProperty ;
    rdfs:label "software_type" ;
    rdfs:range fof_ct:SoftwareTypeEnum ;
    skos:definition "Functional category of the software tool. Written as #Software_Type:." ;
    skos:inScheme fof_ct:common .

fof_ct:the_z a owl:DatatypeProperty ;
    rdfs:label "the_z" ;
    rdfs:range xsd:integer ;
    skos:definition "Identifier of the focal Z-plane in which this localization event was detected. Reserved, conditionally-required column name (TheZ) in the Undecoded SM Localization table: optional to use, but if the focal Z-plane is reported this exact reserved column name MUST be used." ;
    skos:inScheme fof_ct:common .

fof_ct:transcript_id a owl:DatatypeProperty ;
    rdfs:label "transcript_id" ;
    rdfs:domain fof_ct:RNASpot ;
    rdfs:range xsd:string ;
    skos:definition "Official transcript identifier for the specific transcript targeted by the FISH probe. Conditionally required when multiple transcripts share the same gene_id and the FISH probe can distinguish among them. The type of identifier used must be declared in the transcript_id_type header field." ;
    skos:inScheme fof_ct:rna .

fof_ct:transcript_id_type a owl:DatatypeProperty ;
    rdfs:label "transcript_id_type" ;
    rdfs:domain fof_ct:RNASpotTable ;
    rdfs:range xsd:string ;
    skos:definition "Type of transcript identifier used in the transcript_id column (e.g. Ensembl_V38, RefSeq). Conditionally required when multiple transcripts share the same gene_id and the FISH probe can distinguish among them. Written as ##Transcript_ID_Type= in the file header." ;
    skos:inScheme fof_ct:rna .

fof_ct:LocalizationMixin a owl:Class ;
    rdfs:label "LocalizationMixin" ;
    rdfs:subClassOf <https://w3id.org/linkml/ClassDefinition#Mixin> ;
    skos:definition "Mixin capturing the shared concept of a single localization event across FOF-CT modalities. Used by Localization (demultiplexing), SMLocalization (vol_core), and UndecodedLocalization (undecoded). All three classes represent the same atomic measurement unit — the sub-pixel position of a detected fluorescence emission event — but differ in context, mandatory columns, and table role." ;
    skos:inScheme fof_ct:common .

fof_ct:RNASpot a owl:Class ;
    rdfs:label "RNASpot" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:gene_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:gene_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fof_ct:z ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:rna_spot_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:extra_cell_roi_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:rna_spot_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:sub_cell_roi_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:transcript_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:cell_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:z ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:extra_cell_roi_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:extra_cell_roi_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fof_ct:y ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:rna_spot_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:sub_cell_roi_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:rna_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:trace_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:sub_cell_roi_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:cell_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:rna_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:gene_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:transcript_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:trace_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:rna_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:z ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:trace_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:transcript_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:cell_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fof_ct:x ],
        linkml:ClassDefinition ;
    skos:definition "A single detected RNA bright Spot corresponding to one RNA transcript location detected alongside Chromatin Tracing. Each instance of this class corresponds to one row in the CSV data section of the FOF-CT RNA Spot Data table. The rna_spot_id links each RNASpot to the RNA Quality and RNA Biological Data tables; the trace_id links this RNA Spot to a DNA chromatin Trace in the core table and Trace Data table. This class accepts additional user-defined optional columns via open schema." ;
    skos:inScheme fof_ct:rna .

fof_ct:chrom a owl:DatatypeProperty ;
    rdfs:label "chrom" ;
    rdfs:range xsd:string ;
    skos:definition "Chromosome name/identifier using BED (Browser Extensible Data) convention (e.g., chr3, chrY, chr2_random). Used by both the core (Spot) and vol_core (SMLocalization) tables." ;
    skos:inScheme fof_ct:common .

fof_ct:chrom_end a owl:DatatypeProperty ;
    rdfs:label "chrom_end" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "Non-inclusive end coordinate on the chromosome for the genomic target sequence, following BED convention. Used by both the core (Spot) and vol_core (SMLocalization) tables." ;
    skos:inScheme fof_ct:common .

fof_ct:chrom_start a owl:DatatypeProperty ;
    rdfs:label "chrom_start" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "0-based start coordinate on the chromosome for the genomic target sequence, following BED convention. Used by both the core (Spot) and vol_core (SMLocalization) tables." ;
    skos:inScheme fof_ct:common .

fof_ct:modification a owl:DatatypeProperty ;
    rdfs:label "modification" ;
    rdfs:range xsd:string ;
    skos:definition "Description of the nature and genomic position of a DNA insertion or deletion in the genome under study. Conditionally required (content- triggered) when genome_assembly uses the 'custom-build:' prefix. Applies to both the core (bas) and vol_core (vol) tables. Written as ##Modification= in the file header." ;
    skos:inScheme fof_ct:common .

fof_ct:sub_cell_roi_type a owl:DatatypeProperty ;
    rdfs:label "sub_cell_roi_type" ;
    rdfs:range xsd:string ;
    skos:definition "The type of sub-cellular structure ROI documented in this table or mapping file. It is recommended to use a GO 'cellular_component' child term. Examples include Nucleolus, Nuclear Lamina (NL), Nuclear Pore Complex (NPC), PML_body, Cajal_body, Chromosome_Domain. Written as #Sub_Cell_ROI_Type: in the file header." ;
    skos:inScheme fof_ct:common .

fof_ct:vcf_file_name a owl:DatatypeProperty ;
    rdfs:label "vcf_file_name" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the Variant Call Format (VCF) file that must be submitted alongside the dataset to describe the genome insertion or deletion. Conditionally required (content-triggered) when genome_assembly uses the 'custom-build:' prefix. Applies to both the core (bas) and vol_core (vol) tables. Written as ##VCF_File_Name= in the file header." ;
    skos:inScheme fof_ct:common .

fof_ct:vcf_version a owl:DatatypeProperty ;
    rdfs:label "vcf_version" ;
    rdfs:range xsd:string ;
    skos:definition "Version of the VCF format used for the accompanying VCF file. Conditionally required (content-triggered) when genome_assembly uses the 'custom-build:' prefix. Applies to both the core (bas) and vol_core (vol) tables. Written as ##VCF_Version= in the file header." ;
    skos:inScheme fof_ct:common .

fof_ct:x_chromatic_shift a owl:DatatypeProperty ;
    rdfs:label "x_chromatic_shift" ;
    rdfs:range xsd:float ;
    skos:definition "Chromatic aberration correction offset applied to the X coordinate. Same unit as X. Reserved, conditionally-required column name (X_Chromatic_Shift) in the Spot Quality and RNA Spot Quality tables." ;
    skos:inScheme fof_ct:common .

fof_ct:x_drift a owl:DatatypeProperty ;
    rdfs:label "x_drift" ;
    rdfs:range xsd:float ;
    skos:definition "Drift correction offset applied to the X coordinate. Same unit as X. Reserved, conditionally-required column name (X_Drift) in the Spot Quality and RNA Spot Quality tables. Not part of the reserved vocabulary of the SM Localization Quality table." ;
    skos:inScheme fof_ct:common .

fof_ct:y_chromatic_shift a owl:DatatypeProperty ;
    rdfs:label "y_chromatic_shift" ;
    rdfs:range xsd:float ;
    skos:definition "Chromatic aberration correction offset applied to the Y coordinate. Same unit as Y. Reserved, conditionally-required column name (Y_Chromatic_Shift) in the Spot Quality and RNA Spot Quality tables." ;
    skos:inScheme fof_ct:common .

fof_ct:y_drift a owl:DatatypeProperty ;
    rdfs:label "y_drift" ;
    rdfs:range xsd:float ;
    skos:definition "Drift correction offset applied to the Y coordinate. Same unit as Y. Reserved, conditionally-required column name (Y_Drift) in the Spot Quality and RNA Spot Quality tables." ;
    skos:inScheme fof_ct:common .

fof_ct:z_chromatic_shift a owl:DatatypeProperty ;
    rdfs:label "z_chromatic_shift" ;
    rdfs:range xsd:float ;
    skos:definition "Chromatic aberration correction offset applied to the Z coordinate. Same unit as Z. Reserved, conditionally-required column name (Z_Chromatic_Shift) in the Spot Quality and RNA Spot Quality tables." ;
    skos:inScheme fof_ct:common .

fof_ct:z_drift a owl:DatatypeProperty ;
    rdfs:label "z_drift" ;
    rdfs:range xsd:float ;
    skos:definition "Drift correction offset applied to the Z coordinate. Same unit as Z. Reserved, conditionally-required column name (Z_Drift) in the Spot Quality and RNA Spot Quality tables." ;
    skos:inScheme fof_ct:common .

fof_ct:cell_type a owl:DatatypeProperty ;
    rdfs:label "cell_type" ;
    rdfs:range xsd:string ;
    skos:definition "The type of cells present in this dataset, expressed using an ontology term from the Experimental Factor Ontology (EFO). Examples include \"Primary cell line\", \"Immortal cell line\", \"Induced pluripotent stem (IPS) cell\", \"Cell in tissue\", \"Cell in organoid\", \"Other\". Written as #Cell_Type: in the file header." ;
    skos:inScheme fof_ct:common .

fof_ct:centroid_intensity a owl:DatatypeProperty ;
    rdfs:label "centroid_intensity" ;
    rdfs:range xsd:float ;
    skos:definition "Signal intensity of the centroid pixel of the Spot / localization. Reserved, conditionally-required column name (Centroid_Intensity) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
    skos:inScheme fof_ct:common .

fof_ct:extra_cell_roi_type a owl:DatatypeProperty ;
    rdfs:label "extra_cell_roi_type" ;
    rdfs:range xsd:string ;
    skos:definition "The type of extracellular structure ROI within which cells are embedded, expressed using an EFO 'organism part' child term (e.g. Tissue, Organoid). Conditionally required when extracellular structure ROIs are identified and reported in a dedicated Extra-Cell ROI Data table. Written as #Extra_Cell_ROI_Type: in the file header." ;
    skos:inScheme fof_ct:common .

fof_ct:genome_assembly a owl:DatatypeProperty ;
    rdfs:label "genome_assembly" ;
    rdfs:range xsd:string ;
    skos:definition "Genome build used for Chrom, Chrom_Start and Chrom_End coordinates. The 4DN Data Portal accepts GRCh38 (human) and GRCm38 (mouse). When the genome under study contains an INSERTION or DELETION the value must use the mandatory 'custom-build:' prefix followed by a descriptive name (e.g., custom-build:GRCm38+pJT039(insertion)). Written as ##Genome_Assembly= in the file header." ;
    skos:inScheme fof_ct:common .

fof_ct:goodness_of_fit a owl:DatatypeProperty ;
    rdfs:label "goodness_of_fit" ;
    rdfs:range xsd:float ;
    skos:definition "Metric quantifying how well the fitted model matches the observed signal (e.g. chi-squared, R-squared). Reserved, conditionally-required column name (Goodness_of_Fit) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
    skos:inScheme fof_ct:common .

fof_ct:peak_intensity a owl:DatatypeProperty ;
    rdfs:label "peak_intensity" ;
    rdfs:range xsd:float ;
    skos:definition "Signal intensity of the brightest pixel within the Spot / localization boundary. Reserved, conditionally-required column name (Peak_Intensity) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
    skos:inScheme fof_ct:common .

fof_ct:photon_count a owl:DatatypeProperty ;
    rdfs:label "photon_count" ;
    rdfs:range xsd:integer ;
    skos:definition "Number of photons detected for this localization event or Spot. Reserved, conditionally-required column name (Photon_Count) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables; highly recommended in the latter." ;
    skos:inScheme fof_ct:common .

fof_ct:raw_x a owl:DatatypeProperty ;
    rdfs:label "raw_x" ;
    rdfs:range xsd:float ;
    skos:definition "X coordinate before any post-processing corrections (drift correction, chromatic correction, etc.). Same unit as X. Reserved, conditionally-required column name (Raw_X) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
    skos:inScheme fof_ct:common .

fof_ct:raw_y a owl:DatatypeProperty ;
    rdfs:label "raw_y" ;
    rdfs:range xsd:float ;
    skos:definition "Y coordinate before any post-processing corrections. Same unit as Y. Reserved, conditionally-required column name (Raw_Y) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
    skos:inScheme fof_ct:common .

fof_ct:raw_z a owl:DatatypeProperty ;
    rdfs:label "raw_z" ;
    rdfs:range xsd:float ;
    skos:definition "Z coordinate before any post-processing corrections. Same unit as Z. Reserved, conditionally-required column name (Raw_Z) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
    skos:inScheme fof_ct:common .

fof_ct:rna_spot_id a owl:DatatypeProperty ;
    rdfs:label "rna_spot_id" ;
    rdfs:range xsd:integer ;
    skos:definition "Unique integer identifier for an RNA bright Spot, unique across the entire dataset. Used as a primary key in the RNA Spot Data table and as a foreign key in the RNA Quality and RNA Biological Data tables." ;
    skos:inScheme fof_ct:common .

fof_ct:x_loc_error a owl:DatatypeProperty ;
    rdfs:label "x_loc_error" ;
    rdfs:range xsd:float ;
    skos:definition "Localization error estimate for the X coordinate (e.g. standard deviation of repeated measurements). Same unit as X. Reserved, conditionally-required column name (X_Loc_Error) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
    skos:inScheme fof_ct:common .

fof_ct:x_precision a owl:DatatypeProperty ;
    rdfs:label "x_precision" ;
    rdfs:range xsd:float ;
    skos:definition "Metric quantifying the precision of the X-axis localization estimate. Typically the Cramer-Rao lower bound or Thompson method estimate. Highly recommended (not literally mandatory) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables. Must be accompanied by a description in the file header. Written as the reserved X_Loc_Precision column." ;
    skos:inScheme fof_ct:common .

fof_ct:y_loc_error a owl:DatatypeProperty ;
    rdfs:label "y_loc_error" ;
    rdfs:range xsd:float ;
    skos:definition "Localization error estimate for the Y coordinate. Same unit as Y. Reserved, conditionally-required column name (Y_Loc_Error) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
    skos:inScheme fof_ct:common .

fof_ct:y_precision a owl:DatatypeProperty ;
    rdfs:label "y_precision" ;
    rdfs:range xsd:float ;
    skos:definition "Metric quantifying the precision of the Y-axis localization estimate. Highly recommended (not literally mandatory) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables. Written as the reserved Y_Loc_Precision column." ;
    skos:inScheme fof_ct:common .

fof_ct:z_loc_error a owl:DatatypeProperty ;
    rdfs:label "z_loc_error" ;
    rdfs:range xsd:float ;
    skos:definition "Localization error estimate for the Z coordinate. Same unit as Z. Reserved, conditionally-required column name (Z_Loc_Error) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables." ;
    skos:inScheme fof_ct:common .

fof_ct:z_precision a owl:DatatypeProperty ;
    rdfs:label "z_precision" ;
    rdfs:range xsd:float ;
    skos:definition "Metric quantifying the precision of the Z-axis localization estimate. Highly recommended (not literally mandatory) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables. Written as the reserved Z_Loc_Precision column." ;
    skos:inScheme fof_ct:common .

fof_ct:ROIBoundariesFormatTypeEnum a owl:Class ;
    rdfs:label "ROIBoundariesFormatTypeEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#OME_Polygon> <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#OME_Mask> <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#Mesh_OBJ> <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#Mesh_STL> <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#Mesh_PLY> <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#GeoJSON> <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#WKT> <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#Label_Mask_Image> <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#Other> ) ;
    skos:definition "Controlled vocabulary for ##ROI_Boundaries_Format_Type= in the Cell/ROI Mapping table (per the FOF-CT RTD \"Allowable value lists\" table). Default value is OME_Polygon." ;
    skos:inScheme fof_ct:common ;
    linkml:permissible_values <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#GeoJSON>,
        <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#Label_Mask_Image>,
        <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#Mesh_OBJ>,
        <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#Mesh_PLY>,
        <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#Mesh_STL>,
        <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#OME_Mask>,
        <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#OME_Polygon>,
        <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#Other>,
        <https://w3id.org/fof-ct/ROIBoundariesFormatTypeEnum#WKT> .

fof_ct:SoftwareTypeEnum a owl:Class ;
    rdfs:label "SoftwareTypeEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/fof-ct/SoftwareTypeEnum#Distance%20Calculation> <https://w3id.org/fof-ct/SoftwareTypeEnum#DriftCorrection> <https://w3id.org/fof-ct/SoftwareTypeEnum#Precision%20Assessment> <https://w3id.org/fof-ct/SoftwareTypeEnum#Segmentation> <https://w3id.org/fof-ct/SoftwareTypeEnum#Single%20Molecule%20Localization> <https://w3id.org/fof-ct/SoftwareTypeEnum#SpotLoc> <https://w3id.org/fof-ct/SoftwareTypeEnum#SpotLoc%2BTracing> <https://w3id.org/fof-ct/SoftwareTypeEnum#Tracing> <https://w3id.org/fof-ct/SoftwareTypeEnum#Other> ) ;
    skos:definition "Allowed functional categories for software tools (per the FOF-CT RTD \"Allowable value lists\" table for Software_Type)." ;
    skos:inScheme fof_ct:common ;
    linkml:permissible_values <https://w3id.org/fof-ct/SoftwareTypeEnum#Distance%20Calculation>,
        <https://w3id.org/fof-ct/SoftwareTypeEnum#DriftCorrection>,
        <https://w3id.org/fof-ct/SoftwareTypeEnum#Other>,
        <https://w3id.org/fof-ct/SoftwareTypeEnum#Precision%20Assessment>,
        <https://w3id.org/fof-ct/SoftwareTypeEnum#Segmentation>,
        <https://w3id.org/fof-ct/SoftwareTypeEnum#Single%20Molecule%20Localization>,
        <https://w3id.org/fof-ct/SoftwareTypeEnum#SpotLoc>,
        <https://w3id.org/fof-ct/SoftwareTypeEnum#SpotLoc%2BTracing>,
        <https://w3id.org/fof-ct/SoftwareTypeEnum#Tracing> .

fof_ct:trace_id a owl:DatatypeProperty ;
    rdfs:label "trace_id" ;
    rdfs:range xsd:integer ;
    skos:definition "Unique identifier for a chromatin Trace. Used as a primary key in the Trace Data table and as a foreign key in the RNA Spot Data table and (mandatorily) in the FOF-vol-CT SM Localization Data table." ;
    skos:inScheme fof_ct:common .

fof_ct:channel_name a owl:DatatypeProperty ;
    rdfs:label "channel_name" ;
    rdfs:range xsd:string ;
    skos:definition "The wavelength characteristics of the emission channel used to image this Spot / RNA Spot / localization event (e.g. '510/25', '695/81'). Mandatory in the Spot Demultiplexing, Spot Quality, RNA Spot Quality, SM Localization Quality, and Undecoded SM Localization tables. Written as the Channel column." ;
    skos:inScheme fof_ct:common .

fof_ct:fluorophore_name a owl:DatatypeProperty ;
    rdfs:label "fluorophore_name" ;
    rdfs:range xsd:string ;
    skos:definition "The name of the fluorophore whose emission was used to detect this Spot / RNA Spot / localization event (e.g. AlexaFluor_488, Cy5). Mandatory in the Spot Demultiplexing, Spot Quality, RNA Spot Quality, SM Localization Quality, and Undecoded SM Localization tables. Written as the Fluor column." ;
    skos:inScheme fof_ct:common .

fof_ct:loc_id a owl:DatatypeProperty ;
    rdfs:label "loc_id" ;
    rdfs:range xsd:integer ;
    skos:definition "A unique integer identifier for an individual localization event. Loc_ID values are unique across the entire dataset. Serves as primary key in the Spot Demultiplexing, SM Localization Data, SM Localization Quality, and Undecoded SM Localization tables." ;
    skos:inScheme fof_ct:common .

fof_ct:spot_id a owl:DatatypeProperty ;
    rdfs:label "spot_id" ;
    rdfs:range xsd:integer ;
    skos:definition "Unique identifier for a bright DNA Spot. Used as a primary key in quality and biological data tables, and as a foreign key linking localization events to their parent Spot in the demultiplexing table. In FOF-vol-CT (table 13, SM Localization Data), this same Spot_ID concept is derived by clustering Single-Molecule (SM) Localization events rather than by direct optical detection, and every SM Localization event MUST report its associated Spot_ID." ;
    skos:inScheme fof_ct:common .

fof_ct:Software a owl:Class ;
    rdfs:label "Software" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:software_description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:software_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty fof_ct:software_repository ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:software_authors ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:software_parameters ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:software_title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:software_title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:software_authors ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:software_authors ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:software_preferred_citation_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:software_parameters ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:software_preferred_citation_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:software_repository ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:software_parameters ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:software_title ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:SoftwareTypeEnum ;
            owl:onProperty fof_ct:software_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:software_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty fof_ct:software_preferred_citation_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:software_repository ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:software_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:software_description ],
        linkml:ClassDefinition ;
    skos:definition "Provenance metadata for a single software tool used to produce or process data in a FOF-CT table. If more than one tool was used, a separate Software entry must be provided for each. Written as a repeating block of #Software_* fields in the file header." ;
    skos:inScheme fof_ct:common .

fof_ct:sub_cell_roi_id a owl:DatatypeProperty ;
    rdfs:label "sub_cell_roi_id" ;
    rdfs:range xsd:integer ;
    skos:definition "Unique identifier for a sub-cellular structure ROI (e.g., nucleus, nucleolus). Links to the Sub-Cell ROI Data table." ;
    skos:inScheme fof_ct:common .

fof_ct:x a owl:DatatypeProperty ;
    rdfs:label "x" ;
    rdfs:range xsd:float ;
    skos:definition "Sub-pixel X coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections (drift correction, chromatic correction, etc.)." ;
    skos:inScheme fof_ct:common .

fof_ct:y a owl:DatatypeProperty ;
    rdfs:label "y" ;
    rdfs:range xsd:float ;
    skos:definition "Sub-pixel Y coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections." ;
    skos:inScheme fof_ct:common .

fof_ct:z a owl:DatatypeProperty ;
    rdfs:label "z" ;
    rdfs:range xsd:float ;
    skos:definition "Sub-pixel Z coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections." ;
    skos:inScheme fof_ct:common .

fof_ct:XYZUnitEnum a owl:Class ;
    rdfs:label "XYZUnitEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/fof-ct/XYZUnitEnum#nm> <https://w3id.org/fof-ct/XYZUnitEnum#micron> <https://w3id.org/fof-ct/XYZUnitEnum#mm> ) ;
    skos:definition "Allowed units for X, Y, Z spatial coordinates or distances." ;
    skos:inScheme fof_ct:common ;
    linkml:permissible_values <https://w3id.org/fof-ct/XYZUnitEnum#micron>,
        <https://w3id.org/fof-ct/XYZUnitEnum#mm>,
        <https://w3id.org/fof-ct/XYZUnitEnum#nm> .

fof_ct:TimeUnitEnum a owl:Class ;
    rdfs:label "TimeUnitEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/fof-ct/TimeUnitEnum#s> <https://w3id.org/fof-ct/TimeUnitEnum#sec> <https://w3id.org/fof-ct/TimeUnitEnum#ms> <https://w3id.org/fof-ct/TimeUnitEnum#msec> <https://w3id.org/fof-ct/TimeUnitEnum#min> <https://w3id.org/fof-ct/TimeUnitEnum#hr> ) ;
    skos:definition "Allowed units for time intervals." ;
    skos:inScheme fof_ct:common ;
    linkml:permissible_values <https://w3id.org/fof-ct/TimeUnitEnum#hr>,
        <https://w3id.org/fof-ct/TimeUnitEnum#min>,
        <https://w3id.org/fof-ct/TimeUnitEnum#ms>,
        <https://w3id.org/fof-ct/TimeUnitEnum#msec>,
        <https://w3id.org/fof-ct/TimeUnitEnum#s>,
        <https://w3id.org/fof-ct/TimeUnitEnum#sec> .

fof_ct:cell_id a owl:DatatypeProperty ;
    rdfs:label "cell_id" ;
    rdfs:range xsd:integer ;
    skos:definition "Unique identifier for a Cell. Links to the Cell Data table." ;
    skos:inScheme fof_ct:common .

fof_ct:extra_cell_roi_id a owl:DatatypeProperty ;
    rdfs:label "extra_cell_roi_id" ;
    rdfs:range xsd:integer ;
    skos:definition "Unique identifier for an extracellular structure ROI (e.g., tissue, organoid). Links to the Extra-Cell ROI Data table." ;
    skos:inScheme fof_ct:common .

fof_ct:additional_tables a owl:ObjectProperty ;
    rdfs:label "additional_tables" ;
    rdfs:range fof_ct:TableNamespaceEnum ;
    skos:definition "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header." ;
    skos:inScheme fof_ct:common .

fof_ct:softwares a owl:ObjectProperty ;
    rdfs:label "softwares" ;
    rdfs:range fof_ct:Software ;
    skos:definition "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header." ;
    skos:inScheme fof_ct:common .

fof_ct:TableNamespaceEnum a owl:Class ;
    rdfs:label "TableNamespaceEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_core> <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_demultiplexing> <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_trace> <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_rna> <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_quality> <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_rna_quality> <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_bio> <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_rna_bio> <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_cell> <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_extracell> <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_subcell> <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_mapping> <https://w3id.org/fof-ct/TableNamespaceEnum#FOF-CT_vol_core> <https://w3id.org/fof-ct/TableNamespaceEnum#FOF-CT_vol_quality> <https://w3id.org/fof-ct/TableNamespaceEnum#FOF-CT_undecoded> ) ;
    skos:definition "Allowed namespace identifiers for FOF-CT tables that may be listed in the additional_tables field. Note: per the FOF-CT RTD, the three FOF-vol-CT-exclusive namespaces (vol_core, vol_quality, undecoded) intentionally omit the 4dn_ prefix used by the 12 shared tables, to reflect the format's continued stewardship by the broader community beyond 4DN." ;
    skos:inScheme fof_ct:common ;
    linkml:permissible_values <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_bio>,
        <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_cell>,
        <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_core>,
        <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_demultiplexing>,
        <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_extracell>,
        <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_mapping>,
        <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_quality>,
        <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_rna>,
        <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_rna_bio>,
        <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_rna_quality>,
        <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_subcell>,
        <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_trace>,
        <https://w3id.org/fof-ct/TableNamespaceEnum#FOF-CT_undecoded>,
        <https://w3id.org/fof-ct/TableNamespaceEnum#FOF-CT_vol_core>,
        <https://w3id.org/fof-ct/TableNamespaceEnum#FOF-CT_vol_quality> .

fof_ct:intensity_measurement_method a owl:DatatypeProperty ;
    rdfs:label "intensity_measurement_method" ;
    rdfs:range xsd:string ;
    skos:definition "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required (metric-triggered) when any intensity metric is reported." ;
    skos:inScheme fof_ct:common .

fof_ct:intensity_unit a owl:DatatypeProperty ;
    rdfs:label "intensity_unit" ;
    rdfs:range xsd:string ;
    skos:definition "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required (metric-triggered) when any intensity metric is reported in an optional column." ;
    skos:inScheme fof_ct:common .

fof_ct:time_unit a owl:ObjectProperty ;
    rdfs:label "time_unit" ;
    rdfs:range fof_ct:TimeUnitEnum ;
    skos:definition "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required (metric- triggered) when any time metric is reported in an optional column." ;
    skos:inScheme fof_ct:common .

fof_ct:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header." ;
    skos:inScheme fof_ct:common .

fof_ct:experimenter_contact a owl:DatatypeProperty ;
    rdfs:label "experimenter_contact" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ] ) ] ) ] ;
    skos:definition "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header." ;
    skos:inScheme fof_ct:common .

fof_ct:experimenter_name a owl:DatatypeProperty ;
    rdfs:label "experimenter_name" ;
    rdfs:range xsd:string ;
    skos:definition "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header." ;
    skos:inScheme fof_ct:common .

fof_ct:fof_ct_version a owl:DatatypeProperty ;
    rdfs:label "fof_ct_version" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^v[0-9]+\\.[0-9]+" ] ) ] ) ] ;
    skos:definition "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=)." ;
    skos:inScheme fof_ct:common .

fof_ct:lab_name a owl:DatatypeProperty ;
    rdfs:label "lab_name" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header." ;
    skos:inScheme fof_ct:common .

fof_ct:table_namespace a owl:DatatypeProperty ;
    rdfs:label "table_namespace" ;
    rdfs:range xsd:string ;
    skos:definition "Identifier for this table type. The required value is specific to each table. Written as ##Table_Namespace= in the file header." ;
    skos:inScheme fof_ct:common .

fof_ct:xyz_unit a owl:ObjectProperty ;
    rdfs:label "xyz_unit" ;
    rdfs:range fof_ct:XYZUnitEnum ;
    skos:definition "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table." ;
    skos:inScheme fof_ct:common .

[] a owl:Restriction ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fof_ct:z ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fof_ct:y ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty fof_ct:x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:y ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:z ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:loc_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:z ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:loc_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:loc_id ] ;
    owl:onProperty linkml:mixins ;
    owl:someValuesFrom fof_ct:LocalizationMixin .

