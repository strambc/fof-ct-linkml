@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fof_ct: <https://w3id.org/fof-ct/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fof_ct:CellTable a owl:Class ;
    rdfs:label "CellTable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:softwares ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:time_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:additional_tables ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:intensity_measurement_method ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:experimenter_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:experimenter_contact ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:lab_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:intensity_measurement_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "4dn_FOF-CT_cell" ] ) ] ) ] ;
            owl:onProperty fof_ct:table_namespace ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:extra_cell_roi_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:TimeUnitEnum ;
            owl:onProperty fof_ct:time_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:time_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^v[0-9]+\\.[0-9]+" ] ) ] ) ] ;
            owl:onProperty fof_ct:fof_ct_version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:extra_cell_roi_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:xyz_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:fof_ct_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:lab_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:intensity_measurement_method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:intensity_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:Software ;
            owl:onProperty fof_ct:softwares ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:intensity_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:xyz_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:table_namespace ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ] ) ] ) ] ;
            owl:onProperty fof_ct:experimenter_contact ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:cell_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:experimenter_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:intensity_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:experimenter_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:fof_ct_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:extra_cell_roi_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:cell_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:Cell ;
            owl:onProperty fof_ct:cells ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:table_namespace ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:TableNamespaceEnum ;
            owl:onProperty fof_ct:additional_tables ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:cells ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:cell_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:experimenter_contact ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:XYZUnitEnum ;
            owl:onProperty fof_ct:xyz_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:lab_name ],
        linkml:ClassDefinition ;
    skos:definition "The Cell Data table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_cell). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the TSV serialisation) together with the full collection of Cells (recorded as data rows). This table is optional but recommended. Analogous to the MappingSet class in SSSOM." ;
    skos:inScheme fof_ct:cell .

fof_ct:DemultiplexingTable a owl:Class ;
