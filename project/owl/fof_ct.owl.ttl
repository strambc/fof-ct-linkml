        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:experimenter_contact ],
        linkml:ClassDefinition ;
    skos:definition "The Spot Demultiplexing table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_demultiplexing). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the CSV serialisation) together with the full collection of Localization events (recorded as data rows). Analogous to the MappingSet class in SSSOM. This table is optional but recommended for multiplexed FISH experiments." ;
    skos:inScheme fof_ct:demultiplexing .

