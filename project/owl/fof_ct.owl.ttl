        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:undecoded_localizations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:experimenter_contact ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:xyz_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:UndecodedLocalization ;
            owl:onProperty fof_ct:undecoded_localizations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:experimenter_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^v[0-9]+\\.[0-9]+" ] ) ] ) ] ;
            owl:onProperty fof_ct:fof_ct_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom fof_ct:XYZUnitEnum ;
            owl:onProperty fof_ct:xyz_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:xyz_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:table_namespace ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:lab_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ] ) ] ) ] ;
            owl:onProperty fof_ct:experimenter_contact ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:intensity_measurement_method ],
        linkml:ClassDefinition ;
    skos:definition "The Undecoded SM Localization Data table of a FOF-vol-CT dataset (namespace: FOF-CT_undecoded, no 4dn_ prefix). This table is optional but recommended. It records raw localization detections prior to any decoding or assignment step. Submission is recommended when the raw detections are available and reproducibility of the decoding pipeline is desired." ;
    skos:inScheme fof_ct:undecoded .

fof_ct:Cell a owl:Class ;
    rdfs:label "Cell" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:extra_cell_roi_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fof_ct:extra_cell_roi_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:extra_cell_roi_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:cell_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:cell_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:cell_id ],
        linkml:ClassDefinition ;
    skos:definition "A single Cell identified in a FOF-bas-CT experiment. Each instance of this class corresponds to one row in the TSV data section of the FOF-CT Cell Data table. The cell_id field uniquely identifies each Cell and links to the core table, the Sub-Cell ROI Data table, and the Cell/ROI Mapping table. This class accepts additional user-defined optional columns (e.g. Cell_Size, Cell_Volume, Cell_Cycle_State, RNA_Spot_Count) via open schema. At least one such user-defined column MUST be present per submission." ;
    skos:inScheme fof_ct:cell .

fof_ct:ExtraCellROI a owl:Class ;
    rdfs:label "ExtraCellROI" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:extra_cell_roi_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:extra_cell_roi_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:extra_cell_roi_id ],
        linkml:ClassDefinition ;
    skos:definition "A single extracellular structure ROI (e.g. a tissue section or organoid) identified in a FOF-bas-CT experiment. Each instance of this class corresponds to one row in the TSV data section of the FOF-CT Extra-Cell ROI Data table. The extra_cell_roi_id field uniquely identifies each ROI and links to the core table, the RNA Spot Data table, and the Cell Data table. This class accepts additional user-defined optional columns (e.g. ROI_Volume, Cell_Count). At least one such user-defined column MUST be present per submission." ;
    skos:inScheme fof_ct:extracell .

fof_ct:Localization a owl:Class ;
    rdfs:label "Localization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:spot_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:x ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom fof_ct:LocalizationMixin ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:loc_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:x ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:z ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:z ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:x ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:loc_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:spot_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:fluorophore_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:fluorophore_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:fluorophore_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:y ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:channel_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:spot_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:loc_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fof_ct:channel_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:z ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:channel_name ],
        linkml:ClassDefinition ;
    skos:definition "A single individual localisation event contributing to the final position of a bright DNA Spot in a multiplexed FISH experiment (e.g. MERFISH). Each instance of this class corresponds to one row in the CSV data section of the FOF-CT Spot Demultiplexing table. The spot_id field links each Localization to its parent Spot in the core table (or RNA Spot Data table); it may be NA when the localisation could not be assigned to any Spot. This class accepts additional user-defined optional columns (e.g. Hyb, Brightness, Fit_Quality)." ;
    skos:inScheme fof_ct:demultiplexing .

fof_ct:RNASpotBiologicalRecord a owl:Class ;
    rdfs:label "RNASpotBiologicalRecord" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fof_ct:rna_spot_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fof_ct:rna_spot_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fof_ct:rna_spot_id ],
        linkml:ClassDefinition ;
    skos:definition "A single row in the RNA Spot Biological Data table. Each instance captures one or more user-defined biological properties for a specific RNA bright Spot identified by RNA_Spot_ID. RNA_Spot_ID values must be unique across the dataset, linking to the corresponding record in the RNA Spot Data table (table 4). At least one user-defined biological property column MUST be present; users declare these via #^ header lines." ;
    skos:inScheme fof_ct:rna_bio .

