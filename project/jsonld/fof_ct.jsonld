      "definition_uri": "https://w3id.org/fof-ct/extra_cell_rois",
      "description": "The complete collection of extracellular ROIs constituting this dataset. Each ExtraCellROI corresponds to one data row in the TSV serialisation. At least one user-defined optional column (e.g. ROI_Volume, Cell_Count) MUST be present in every submitted Extra-Cell ROI Data table.",
      "from_schema": "https://w3id.org/fof-ct/extracell",
