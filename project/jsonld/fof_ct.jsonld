      "alias": "fluorophore_name",
      "owner": "SpotQualityRecord",
      "domain_of": [
        "SpotQualityRecord"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "fluorophore_name",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "SpotQualityRecord_x_precision",
      "definition_uri": "https://w3id.org/fof-ct/x_precision",
      "description": "Recommended: metric for X localization precision",
      "examples": [
        {
          "value": "0.01",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "x_precision",
      "domain": "SpotQualityRecord",
