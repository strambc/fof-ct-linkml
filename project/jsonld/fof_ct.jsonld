    },
    {
      "name": "image_frame_id",
      "definition_uri": "https://w3id.org/fof-ct/image_frame_id",
      "description": "Unique integer identifier for the imaging frame in which this undecoded localization event was detected. Written as the Image_Frame_ID column. Mandatory in the Undecoded SM Localization table.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/image_frame_id",
      "owner": "UndecodedLocalization",
      "domain_of": [
        "UndecodedLocalization"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "hyb_id",
      "definition_uri": "https://w3id.org/fof-ct/hyb_id",
      "description": "Unique identifier for the hybridization round in which this localization event was detected. Written as the Hyb_ID column. Mandatory in the Undecoded SM Localization table.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/hyb_id",
      "owner": "UndecodedLocalization",
      "domain_of": [
        "UndecodedLocalization"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "the_z",
      "definition_uri": "https://w3id.org/fof-ct/the_z",
      "description": "Identifier of the focal Z-plane in which this localization event was detected. Reserved, conditionally-required column name (TheZ) in the Undecoded SM Localization table: optional to use, but if the focal Z-plane is reported this exact reserved column name MUST be used.",
      "examples": [
        {
          "value": "10",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/the_z",
      "owner": "UndecodedLocalization",
      "domain_of": [
        "UndecodedLocalization"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "genome_assembly",
      "definition_uri": "https://w3id.org/fof-ct/genome_assembly",
      "description": "Genome build used for Chrom, Chrom_Start and Chrom_End coordinates. The 4DN Data Portal accepts GRCh38 (human) and GRCm38 (mouse). When the genome under study contains an INSERTION or DELETION the value must use the mandatory 'custom-build:' prefix followed by a descriptive name (e.g., custom-build:GRCm38+pJT039(insertion)). Written as ##Genome_Assembly= in the file header.",
      "examples": [
        {
          "value": "GRCh38",
          "@type": "Example"
        },
        {
          "value": "custom-build:GRCm38+pJT039(insertion)",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/genome_assembly",
      "owner": "SMLocalizationTable",
      "domain_of": [
        "RNASpotTable",
        "SMLocalizationTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "modification",
      "definition_uri": "https://w3id.org/fof-ct/modification",
      "description": "Description of the nature and genomic position of a DNA insertion or deletion in the genome under study. Conditionally required (content- triggered) when genome_assembly uses the 'custom-build:' prefix. Applies to both the core (bas) and vol_core (vol) tables. Written as ##Modification= in the file header.",
      "examples": [
        {
          "value": "pJT039:chr3(insertion 0001-2500)",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/modification",
      "owner": "SMLocalizationTable",
      "domain_of": [
        "SMLocalizationTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "vcf_file_name",
      "definition_uri": "https://w3id.org/fof-ct/vcf_file_name",
      "description": "Name of the Variant Call Format (VCF) file that must be submitted alongside the dataset to describe the genome insertion or deletion. Conditionally required (content-triggered) when genome_assembly uses the 'custom-build:' prefix. Applies to both the core (bas) and vol_core (vol) tables. Written as ##VCF_File_Name= in the file header.",
      "examples": [
        {
          "value": "pJT039:chr3.vcf",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/vcf_file_name",
      "owner": "SMLocalizationTable",
      "domain_of": [
        "SMLocalizationTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "vcf_version",
      "definition_uri": "https://w3id.org/fof-ct/vcf_version",
      "description": "Version of the VCF format used for the accompanying VCF file. Conditionally required (content-triggered) when genome_assembly uses the 'custom-build:' prefix. Applies to both the core (bas) and vol_core (vol) tables. Written as ##VCF_Version= in the file header.",
      "examples": [
        {
          "value": "v4.2",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/vcf_version",
      "owner": "SMLocalizationTable",
      "domain_of": [
        "SMLocalizationTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "cell_type",
      "definition_uri": "https://w3id.org/fof-ct/cell_type",
      "description": "The type of cells present in this dataset, expressed using an ontology term from the Experimental Factor Ontology (EFO). Examples include \"Primary cell line\", \"Immortal cell line\", \"Induced pluripotent stem (IPS) cell\", \"Cell in tissue\", \"Cell in organoid\", \"Other\". Written as #Cell_Type: in the file header.",
      "examples": [
        {
          "value": "Cell in tissue",
          "@type": "Example"
        },
        {
          "value": "Cell in organoid",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/cell_type",
      "owner": "ROIMappingTable",
      "domain_of": [
        "CellTable",
        "SubCellROITable",
        "ROIMappingTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "extra_cell_roi_type",
      "definition_uri": "https://w3id.org/fof-ct/extra_cell_roi_type",
      "description": "The type of extracellular structure ROI within which cells are embedded, expressed using an EFO 'organism part' child term (e.g. Tissue, Organoid). Conditionally required when extracellular structure ROIs are identified and reported in a dedicated Extra-Cell ROI Data table. Written as #Extra_Cell_ROI_Type: in the file header.",
      "examples": [
        {
          "value": "Tissue",
          "@type": "Example"
        },
        {
          "value": "Organoid",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/extra_cell_roi_type",
      "owner": "ROIMappingTable",
      "domain_of": [
        "CellTable",
        "ExtraCellROITable",
        "ROIMappingTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "sub_cell_roi_type",
      "definition_uri": "https://w3id.org/fof-ct/sub_cell_roi_type",
      "description": "The type of sub-cellular structure ROI documented in this table or mapping file. It is recommended to use a GO 'cellular_component' child term. Examples include Nucleolus, Nuclear Lamina (NL), Nuclear Pore Complex (NPC), PML_body, Cajal_body, Chromosome_Domain. Written as #Sub_Cell_ROI_Type: in the file header.",
      "examples": [
        {
          "value": "Nucleolus",
          "@type": "Example"
        },
        {
          "value": "Nuclear Lamina (NL)",
          "@type": "Example"
        },
        {
          "value": "Nuclear Pore Complex (NPC)",
          "@type": "Example"
        },
        {
          "value": "Chromosome_Domain",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/sub_cell_roi_type",
      "owner": "ROIMappingTable",
      "domain_of": [
        "SubCellROITable",
        "ROIMappingTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "software_title",
      "definition_uri": "https://w3id.org/fof-ct/software_title",
      "description": "Name of the software tool. Written as #Software_Title:.",
      "examples": [
        {
          "value": "ChrTracer3",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/software_title",
      "owner": "Software",
      "domain_of": [
        "Software"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "software_type",
      "definition_uri": "https://w3id.org/fof-ct/software_type",
      "description": "Functional category of the software tool. Written as #Software_Type:.",
      "examples": [
        {
          "value": "SpotLoc+Tracing",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/software_type",
      "owner": "Software",
      "domain_of": [
        "Software"
      ],
      "range": "SoftwareTypeEnum",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "software_authors",
      "definition_uri": "https://w3id.org/fof-ct/software_authors",
      "description": "Author name(s) in 'Surname, Firstname' format, multiple authors separated by semicolons. Written as #Software_Authors:.",
      "examples": [
        {
          "value": "Mateo, LJ; Sinnott-Armstrong, N; Boettiger, AN",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/software_authors",
      "owner": "Software",
      "domain_of": [
        "Software"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "software_description",
      "definition_uri": "https://w3id.org/fof-ct/software_description",
      "description": "Free-text description of the algorithm used, sufficient to guarantee reproducibility. Written as #Software_Description:.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/software_description",
      "owner": "Software",
      "domain_of": [
        "Software"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "software_parameters",
      "definition_uri": "https://w3id.org/fof-ct/software_parameters",
      "description": "Free-text description of the input parameters used for the specific analysis run performed using this Software. Should provide sufficient detail about the analysis parameters used to guarantee interpretation and reproducibility (e.g. input parameters used for assessing the precision of single molecule localization or drift correction in X, Y and Z). Written as #Software_Parameters:.",
      "examples": [
        {
          "value": "X_Loc_Precision Parameter = 1.01",
          "@type": "Example"
        }
      ],
