      "usage_slot_name": "cell_id",
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "ROIMapping_extra_cell_roi_id",
      "definition_uri": "https://w3id.org/fof-ct/extra_cell_roi_id",
      "description": "Unique identifier for the extracellular structure ROI whose boundaries are described in this row. Conditionally required when this file contains Extra-Cell ROI boundary data. Exactly one of sub_cell_roi_id, cell_id, or extra_cell_roi_id must be used consistently throughout the file.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "extra_cell_roi_id",
