        "ROIMapping",
        "SMLocalization"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "cell_id",
      "definition_uri": "https://w3id.org/fof-ct/cell_id",
      "description": "Unique identifier for a Cell. Links to the Cell Data table.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/cell_id",
