    {
      "name": "SubCellROITable_intensity_measurement_method",
      "definition_uri": "https://w3id.org/fof-ct/intensity_measurement_method",
      "description": "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required when any intensity metric is reported.",
      "examples": [
        {
          "value": "Localization centroid intensity",
