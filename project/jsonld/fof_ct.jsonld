    {
      "name": "x_loc_error",
      "definition_uri": "https://w3id.org/fof-ct/x_loc_error",
      "description": "Localization error estimate for the X coordinate (e.g. standard deviation of repeated measurements). Same unit as X. Reserved, conditionally-required column name (X_Loc_Error) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables.",
