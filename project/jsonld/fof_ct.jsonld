    {
      "name": "SMLocalization_loc_id",
      "definition_uri": "https://w3id.org/fof-ct/loc_id",
      "description": "Unique integer identifier for this SM localization event. Loc_ID values are unique across the entire dataset.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
