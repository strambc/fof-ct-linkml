      "domain_of": [
        "RNASpot"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "trace_id",
      "range": "integer",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "RNASpotTable_fof_ct_version",
      "definition_uri": "https://w3id.org/fof-ct/fof_ct_version",
      "description": "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=).",
      "examples": [
        {
          "value": "v1.0",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "fof_ct_version",
      "domain": "RNASpotTable",
      "slot_uri": "https://w3id.org/fof-ct/fof_ct_version",
      "alias": "fof_ct_version",
      "owner": "RNASpotTable",
      "domain_of": [
        "RNASpotTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "fof_ct_version",
      "range": "string",
      "required": true,
      "pattern": "^v[0-9]+\\.[0-9]+",
      "@type": "SlotDefinition"
    },
    {
      "name": "RNASpotTable_table_namespace",
      "definition_uri": "https://w3id.org/fof-ct/table_namespace",
      "description": "Identifier for this table type. The required value is specific to each table. Written as ##Table_Namespace= in the file header.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "table_namespace",
      "domain": "RNASpotTable",
      "slot_uri": "https://w3id.org/fof-ct/table_namespace",
      "alias": "table_namespace",
      "owner": "RNASpotTable",
      "domain_of": [
        "RNASpotTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "table_namespace",
      "range": "string",
      "required": true,
      "equals_string": "4dn_FOF-CT_rna",
      "@type": "SlotDefinition"
    },
    {
      "name": "RNASpotTable_genome_assembly",
      "definition_uri": "https://w3id.org/fof-ct/genome_assembly",
      "description": "Genome build used for Chrom, Chrom_Start and Chrom_End coordinates. The 4DN Data Portal accepts GRCh38 (human) and GRCm38 (mouse). When the genome under study contains an INSERTION or DELETION the value must use the mandatory 'custom-build:' prefix followed by a descriptive name (e.g., custom-build:GRCm38+pJT039(insertion)). Written as ##Genome_Assembly= in the file header.",
      "examples": [
        {
          "value": "GRCh38",
          "@type": "Example"
        },
        {
          "value": "custom-build:GRCm38+pJT039(insertion)",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "genome_assembly",
      "domain": "RNASpotTable",
      "slot_uri": "https://w3id.org/fof-ct/genome_assembly",
      "alias": "genome_assembly",
      "owner": "RNASpotTable",
      "domain_of": [
        "RNASpotTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "genome_assembly",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "RNASpotTable_gene_id_type",
      "definition_uri": "https://w3id.org/fof-ct/gene_id_type",
      "description": "Type of gene identifier used in the gene_id column (e.g. Ensembl_V38, NCBI_Gene). Written as ##Gene_ID_Type= in the file header.",
      "examples": [
        {
          "value": "Ensembl_V38",
          "@type": "Example"
        },
        {
          "value": "NCBI_Gene",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/rna",
      "is_a": "gene_id_type",
      "domain": "RNASpotTable",
      "slot_uri": "https://w3id.org/fof-ct/gene_id_type",
      "alias": "gene_id_type",
      "owner": "RNASpotTable",
      "domain_of": [
        "RNASpotTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "gene_id_type",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "RNASpotTable_xyz_unit",
      "definition_uri": "https://w3id.org/fof-ct/xyz_unit",
      "description": "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table.",
      "examples": [
        {
          "value": "micron",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "xyz_unit",
      "domain": "RNASpotTable",
      "slot_uri": "https://w3id.org/fof-ct/xyz_unit",
      "alias": "xyz_unit",
      "owner": "RNASpotTable",
      "domain_of": [
        "RNASpotTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "xyz_unit",
      "range": "XYZUnitEnum",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "RNASpotTable_lab_name",
      "definition_uri": "https://w3id.org/fof-ct/lab_name",
      "description": "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header.",
      "examples": [
        {
          "value": "Nobel",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
