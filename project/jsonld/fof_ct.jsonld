      "range": "SubCellROI",
      "required": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "ROIMapping_sub_cell_roi_id",
      "definition_uri": "https://w3id.org/fof-ct/sub_cell_roi_id",
      "description": "Unique identifier for the Sub-Cell ROI whose boundaries are described in this row. Conditionally required when this file contains sub- cellular ROI boundary data. Exactly one of sub_cell_roi_id, cell_id, or extra_cell_roi_id must be used consistently throughout the file.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "sub_cell_roi_id",
      "domain": "ROIMapping",
      "slot_uri": "https://w3id.org/fof-ct/sub_cell_roi_id",
      "alias": "sub_cell_roi_id",
      "owner": "ROIMapping",
      "domain_of": [
        "ROIMapping"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "sub_cell_roi_id",
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "ROIMapping_cell_id",
      "definition_uri": "https://w3id.org/fof-ct/cell_id",
      "description": "Unique identifier for the Cell whose boundaries are described in this row. Conditionally required when this file contains Cell boundary data. Exactly one of sub_cell_roi_id, cell_id, or extra_cell_roi_id must be used consistently throughout the file.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "cell_id",
      "domain": "ROIMapping",
      "slot_uri": "https://w3id.org/fof-ct/cell_id",
      "alias": "cell_id",
