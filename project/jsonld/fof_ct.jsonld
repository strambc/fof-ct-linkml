      "name": "SpotQualityRecord_goodness_of_fit",
      "definition_uri": "https://w3id.org/fof-ct/goodness_of_fit",
      "description": "Metric quantifying how well the fitted model matches the observed signal (e.g. chi-squared, R-squared). Reserved, conditionally-required column name (Goodness_of_Fit) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables.",
      "examples": [
        {
          "value": "0.95",
          "@type": "Example"
        }
