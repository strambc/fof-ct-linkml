    },
    {
      "name": "RNASpotTable_rna_spots",
      "definition_uri": "https://w3id.org/fof-ct/rna_spots",
      "description": "The complete collection of RNA Spots constituting this dataset. Each RNASpot corresponds to one data row in the TSV serialisation.",
      "from_schema": "https://w3id.org/fof-ct/rna",
