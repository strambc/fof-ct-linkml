      "usage_slot_name": "extra_cell_roi_id",
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "SMLocalizationTable_fof_ct_version",
      "definition_uri": "https://w3id.org/fof-ct/fof_ct_version",
      "description": "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=).",
      "examples": [
        {
          "value": "v1.0",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "fof_ct_version",
      "domain": "SMLocalizationTable",
      "slot_uri": "https://w3id.org/fof-ct/fof_ct_version",
      "alias": "fof_ct_version",
      "owner": "SMLocalizationTable",
      "domain_of": [
        "SMLocalizationTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "fof_ct_version",
      "range": "string",
      "required": true,
      "pattern": "^v[0-9]+\\.[0-9]+",
      "@type": "SlotDefinition"
    },
    {
      "name": "SMLocalizationTable_table_namespace",
      "definition_uri": "https://w3id.org/fof-ct/table_namespace",
      "description": "Identifier for this table type. Must always be 'FOF-CT_vol_core' (no 4dn_ prefix \u2014 this FOF-vol-CT-exclusive namespace intentionally omits it). Written as ##Table_Namespace= in the file header.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "table_namespace",
      "domain": "SMLocalizationTable",
      "slot_uri": "https://w3id.org/fof-ct/table_namespace",
      "alias": "table_namespace",
      "owner": "SMLocalizationTable",
      "domain_of": [
        "SMLocalizationTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "table_namespace",
      "range": "string",
      "required": true,
      "equals_string": "FOF-CT_vol_core",
      "@type": "SlotDefinition"
    },
    {
      "name": "SMLocalizationTable_lab_name",
      "definition_uri": "https://w3id.org/fof-ct/lab_name",
      "description": "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header.",
      "examples": [
        {
          "value": "Nobel",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "lab_name",
      "domain": "SMLocalizationTable",
      "slot_uri": "https://w3id.org/fof-ct/lab_name",
      "alias": "lab_name",
      "owner": "SMLocalizationTable",
      "domain_of": [
        "SMLocalizationTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "lab_name",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "SMLocalizationTable_experimenter_name",
      "definition_uri": "https://w3id.org/fof-ct/experimenter_name",
      "description": "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header.",
      "examples": [
        {
          "value": "John Doe",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "experimenter_name",
      "domain": "SMLocalizationTable",
      "slot_uri": "https://w3id.org/fof-ct/experimenter_name",
      "alias": "experimenter_name",
      "owner": "SMLocalizationTable",
      "domain_of": [
        "SMLocalizationTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "experimenter_name",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "SMLocalizationTable_experimenter_contact",
      "definition_uri": "https://w3id.org/fof-ct/experimenter_contact",
      "description": "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header.",
      "examples": [
        {
          "value": "john.doe@email.com",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "experimenter_contact",
      "domain": "SMLocalizationTable",
      "slot_uri": "https://w3id.org/fof-ct/experimenter_contact",
      "alias": "experimenter_contact",
      "owner": "SMLocalizationTable",
      "domain_of": [
        "SMLocalizationTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "experimenter_contact",
      "range": "string",
      "required": true,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "@type": "SlotDefinition"
    },
    {
      "name": "SMLocalizationTable_description",
      "definition_uri": "https://w3id.org/fof-ct/description",
      "description": "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "description",
      "domain": "SMLocalizationTable",
      "slot_uri": "https://w3id.org/fof-ct/description",
      "alias": "description",
      "owner": "SMLocalizationTable",
      "domain_of": [
        "SMLocalizationTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "description",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "SMLocalizationTable_softwares",
      "definition_uri": "https://w3id.org/fof-ct/softwares",
      "description": "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "softwares",
      "domain": "SMLocalizationTable",
      "slot_uri": "https://w3id.org/fof-ct/softwares",
      "alias": "softwares",
      "owner": "SMLocalizationTable",
      "domain_of": [
        "SMLocalizationTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "softwares",
      "range": "Software",
      "required": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "SMLocalizationTable_additional_tables",
      "definition_uri": "https://w3id.org/fof-ct/additional_tables",
      "description": "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "additional_tables",
      "domain": "SMLocalizationTable",
      "slot_uri": "https://w3id.org/fof-ct/additional_tables",
      "alias": "additional_tables",
      "owner": "SMLocalizationTable",
      "domain_of": [
        "SMLocalizationTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "additional_tables",
      "range": "TableNamespaceEnum",
      "required": true,
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "SMLocalizationTable_genome_assembly",
      "definition_uri": "https://w3id.org/fof-ct/genome_assembly",
      "description": "Genome build used for Chrom, Chrom_Start and Chrom_End coordinates. The 4DN Data Portal accepts GRCh38 (human) and GRCm38 (mouse). When the genome under study contains an INSERTION or DELETION the value must use the mandatory 'custom-build:' prefix followed by a descriptive name (e.g., custom-build:GRCm38+pJT039(insertion)). Written as ##Genome_Assembly= in the file header.",
      "examples": [
        {
          "value": "GRCh38",
          "@type": "Example"
        },
        {
          "value": "custom-build:GRCm38+pJT039(insertion)",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "genome_assembly",
      "domain": "SMLocalizationTable",
      "slot_uri": "https://w3id.org/fof-ct/genome_assembly",
      "alias": "genome_assembly",
      "owner": "SMLocalizationTable",
      "domain_of": [
        "SMLocalizationTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "genome_assembly",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "SMLocalizationTable_xyz_unit",
      "definition_uri": "https://w3id.org/fof-ct/xyz_unit",
      "description": "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table.",
      "examples": [
        {
          "value": "micron",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "xyz_unit",
      "domain": "SMLocalizationTable",
      "slot_uri": "https://w3id.org/fof-ct/xyz_unit",
      "alias": "xyz_unit",
      "owner": "SMLocalizationTable",
      "domain_of": [
        "SMLocalizationTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "xyz_unit",
      "range": "XYZUnitEnum",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "SMLocalizationTable_sm_localizations",
