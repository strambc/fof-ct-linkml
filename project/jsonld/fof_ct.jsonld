    },
    {
      "name": "UndecodedLocalization_y",
      "definition_uri": "https://w3id.org/fof-ct/y",
      "description": "Sub-pixel Y coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections.",
