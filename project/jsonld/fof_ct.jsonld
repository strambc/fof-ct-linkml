      "is_usage_slot": true,
      "usage_slot_name": "description",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "RNASpotTable_softwares",
      "definition_uri": "https://w3id.org/fof-ct/softwares",
