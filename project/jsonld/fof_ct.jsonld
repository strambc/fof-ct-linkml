      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "SMLocalization_x",
      "definition_uri": "https://w3id.org/fof-ct/x",
      "description": "Sub-pixel X coordinate of this SM localization event in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections.",
      "examples": [
