    {
      "name": "ROIMapping",
      "definition_uri": "https://w3id.org/fof-ct/ROIMapping",
      "description": "A single boundary record for one Cell, Sub-Cell ROI, or Extra-Cell ROI in a FOF-bas-CT experiment. Each instance corresponds to one row in the TSV data section of the FOF-CT Cell/ROI Mapping table. Exactly one of the three identifier slots (sub_cell_roi_id, cell_id, extra_cell_roi_id) must be populated per file; the choice of identifier must be consistent across all rows of a given submission. The roi_boundaries slot holds the boundary coordinates in the format specified by roi_boundaries_format in the table header. This class accepts additional user-defined optional columns.",
      "from_schema": "https://w3id.org/fof-ct/mapping",
      "slots": [
        "ROIMapping_sub_cell_roi_id",
        "ROIMapping_cell_id",
        "ROIMapping_extra_cell_roi_id",
        "ROIMapping_roi_boundaries"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/fof-ct/ROIMapping",
      "exactly_one_of": [
        {
          "slot_conditions": [
            {
              "name": "sub_cell_roi_id",
              "value_presence": "PRESENT",
              "@type": "SlotDefinition"
            },
            {
              "name": "cell_id",
              "value_presence": "ABSENT",
              "@type": "SlotDefinition"
            },
            {
              "name": "extra_cell_roi_id",
              "value_presence": "ABSENT",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "slot_conditions": [
            {
              "name": "sub_cell_roi_id",
              "value_presence": "ABSENT",
              "@type": "SlotDefinition"
            },
            {
              "name": "cell_id",
              "value_presence": "PRESENT",
              "@type": "SlotDefinition"
            },
            {
              "name": "extra_cell_roi_id",
              "value_presence": "ABSENT",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "slot_conditions": [
            {
              "name": "sub_cell_roi_id",
              "value_presence": "ABSENT",
              "@type": "SlotDefinition"
            },
            {
              "name": "cell_id",
              "value_presence": "ABSENT",
              "@type": "SlotDefinition"
            },
            {
              "name": "extra_cell_roi_id",
              "value_presence": "PRESENT",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ROIMappingTable",
      "definition_uri": "https://w3id.org/fof-ct/ROIMappingTable",
      "description": "The Cell/ROI Mapping table of a FOF-bas-CT dataset (namespace: 4dn_FOF-CT_mapping). This class represents the entire file: it holds all dataset-level provenance metadata (recorded as header lines in the TSV serialisation) together with the full collection of ROI boundary records (recorded as data rows). This table is conditionally required whenever a Cell Data table, a Sub-Cell ROI Data table, or an Extra-Cell ROI Data table is deposited. Analogous to the MappingSet class in SSSOM.",
      "from_schema": "https://w3id.org/fof-ct/mapping",
