    },
    {
      "name": "UndecodedLocalization_x",
      "definition_uri": "https://w3id.org/fof-ct/x",
      "description": "Sub-pixel X coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections (drift correction, chromatic correction, etc.).",
      "examples": [
