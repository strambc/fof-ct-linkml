      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "SMLocalization_chrom",
      "definition_uri": "https://w3id.org/fof-ct/chrom",
      "description": "Chromosome name/identifier using BED (Browser Extensible Data) convention (e.g., chr3, chrY, chr2_random). Used by both the core (Spot) and vol_core (SMLocalization) tables.",
      "examples": [
