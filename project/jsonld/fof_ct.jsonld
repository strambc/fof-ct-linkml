      "alias": "the_z",
      "owner": "UndecodedLocalization",
      "domain_of": [
        "UndecodedLocalization"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "the_z",
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "UndecodedLocalizationTable_fof_ct_version",
      "definition_uri": "https://w3id.org/fof-ct/fof_ct_version",
      "description": "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=).",
      "examples": [
        {
          "value": "v1.0",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "fof_ct_version",
      "domain": "UndecodedLocalizationTable",
      "slot_uri": "https://w3id.org/fof-ct/fof_ct_version",
      "alias": "fof_ct_version",
      "owner": "UndecodedLocalizationTable",
      "domain_of": [
        "UndecodedLocalizationTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "fof_ct_version",
      "range": "string",
      "required": true,
      "pattern": "^v[0-9]+\\.[0-9]+",
      "@type": "SlotDefinition"
    },
    {
      "name": "UndecodedLocalizationTable_table_namespace",
      "definition_uri": "https://w3id.org/fof-ct/table_namespace",
      "description": "Identifier for this table type. Must always be 'FOF-CT_undecoded' (no 4dn_ prefix \u2014 this FOF-vol-CT-exclusive namespace intentionally omits it). Written as ##Table_Namespace= in the file header.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "table_namespace",
      "domain": "UndecodedLocalizationTable",
      "slot_uri": "https://w3id.org/fof-ct/table_namespace",
      "alias": "table_namespace",
      "owner": "UndecodedLocalizationTable",
      "domain_of": [
        "UndecodedLocalizationTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "table_namespace",
      "range": "string",
      "required": true,
      "equals_string": "FOF-CT_undecoded",
      "@type": "SlotDefinition"
    },
    {
      "name": "UndecodedLocalizationTable_lab_name",
      "definition_uri": "https://w3id.org/fof-ct/lab_name",
      "description": "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header.",
      "examples": [
