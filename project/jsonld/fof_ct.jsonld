      "owner": "SpotQualityRecord",
      "domain_of": [
        "SpotQualityRecord"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "y_precision",
      "range": "float",
      "@type": "SlotDefinition"
    },
    {
      "name": "SpotQualityRecord_z_precision",
      "definition_uri": "https://w3id.org/fof-ct/z_precision",
      "description": "Metric quantifying the precision of the Z-axis localization estimate. Highly recommended (not literally mandatory) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables. Written as the reserved Z_Loc_Precision column.",
      "examples": [
        {
          "value": "0.02",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "z_precision",
      "domain": "SpotQualityRecord",
      "slot_uri": "https://w3id.org/fof-ct/z_precision",
      "alias": "z_precision",
      "owner": "SpotQualityRecord",
      "domain_of": [
