    {
      "name": "ROIMappingTable_time_unit",
      "definition_uri": "https://w3id.org/fof-ct/time_unit",
      "description": "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required (metric- triggered) when any time metric is reported in an optional column.",
      "examples": [
        {
          "value": "sec",
