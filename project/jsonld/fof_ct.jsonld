    {
      "name": "SubCellROITable_sub_cell_rois",
      "definition_uri": "https://w3id.org/fof-ct/sub_cell_rois",
      "description": "The complete collection of sub-cellular ROIs constituting this dataset. Each SubCellROI corresponds to one data row in the TSV serialisation. At least one user-defined optional column (e.g. ROI_Volume, ROI_Area) MUST be present in every submitted Sub-Cell ROI Data table.",
      "from_schema": "https://w3id.org/fof-ct/subcell",
      "is_a": "sub_cell_rois",
