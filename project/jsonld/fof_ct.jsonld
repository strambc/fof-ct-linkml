    },
    {
      "name": "SpotQualityRecord_spot_id",
      "definition_uri": "https://w3id.org/fof-ct/spot_id",
      "description": "Unique integer identifier for the DNA bright Spot to which these quality metrics belong. Links to the corresponding Spot record in the core table (table 1). Must be unique within this table.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
