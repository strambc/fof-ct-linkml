      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "ROIMapping_roi_boundaries",
      "definition_uri": "https://w3id.org/fof-ct/roi_boundaries",
      "description": "Boundary coordinates for this Cell or ROI, encoded in the format specified by roi_boundaries_format in the table header. For the OME ROI Polygon model, coordinates are provided as a space-separated list of \"x,y\" pairs (e.g. \"12.5,40.2 13.1,41.0 ...\"). For OBJ 3D mesh format, the field contains the vertex and face list for the boundary mesh.",
      "examples": [
        {
          "value": "12.5,40.2 13.1,41.0 14.0,40.5 13.5,39.8",
          "@type": "Example"
        },
        {
          "value": "v 1.0 2.0 3.0\nv 4.0 5.0 6.0\nf 1 2 3",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/mapping",
      "is_a": "roi_boundaries",
      "domain": "ROIMapping",
      "slot_uri": "https://w3id.org/fof-ct/roi_boundaries",
      "alias": "roi_boundaries",
      "owner": "ROIMapping",
      "domain_of": [
        "ROIMapping"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "roi_boundaries",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "ROIMappingTable_fof_ct_version",
      "definition_uri": "https://w3id.org/fof-ct/fof_ct_version",
      "description": "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=).",
      "examples": [
        {
          "value": "v1.0",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "fof_ct_version",
      "domain": "ROIMappingTable",
      "slot_uri": "https://w3id.org/fof-ct/fof_ct_version",
      "alias": "fof_ct_version",
      "owner": "ROIMappingTable",
      "domain_of": [
        "ROIMappingTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "fof_ct_version",
      "range": "string",
      "required": true,
      "pattern": "^v[0-9]+\\.[0-9]+",
      "@type": "SlotDefinition"
    },
    {
      "name": "ROIMappingTable_table_namespace",
      "definition_uri": "https://w3id.org/fof-ct/table_namespace",
      "description": "Identifier for this table type. The required value is specific to each table. Written as ##Table_Namespace= in the file header.",
