        "ExtraCellROITable",
        "SubCellROITable",
        "ROIMappingTable",
        "SMLocalizationTable",
        "SMLocalizationQualityTable",
        "UndecodedLocalizationTable"
      ],
      "range": "TimeUnitEnum",
      "@type": "SlotDefinition"
    },
    {
      "name": "intensity_unit",
      "definition_uri": "https://w3id.org/fof-ct/intensity_unit",
      "description": "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required (metric-triggered) when any intensity metric is reported in an optional column.",
      "examples": [
        {
          "value": "a.u.",
          "@type": "Example"
