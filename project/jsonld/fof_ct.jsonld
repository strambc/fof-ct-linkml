    {
      "name": "UndecodedLocalization_channel_name",
      "definition_uri": "https://w3id.org/fof-ct/channel_name",
      "description": "The wavelength characteristics of the emission channel used to image this Spot / RNA Spot / localization event (e.g. '510/25', '695/81'). Mandatory in the Spot Demultiplexing, Spot Quality, RNA Spot Quality, SM Localization Quality, and Undecoded SM Localization tables. Written as the Channel column.",
      "examples": [
        {
          "value": "510/25",
          "@type": "Example"
        },
        {
          "value": "695/81",
          "@type": "Example"
        }
      ],
