      "usage_slot_name": "centroid_intensity",
      "range": "float",
      "@type": "SlotDefinition"
    },
    {
      "name": "SpotQualityRecord_peak_intensity",
      "definition_uri": "https://w3id.org/fof-ct/peak_intensity",
      "description": "Signal intensity of the brightest pixel within the Spot / localization boundary. Reserved, conditionally-required column name (Peak_Intensity) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables.",
      "examples": [
