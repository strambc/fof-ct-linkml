    {
      "name": "SpotQualityTable_fof_ct_version",
      "definition_uri": "https://w3id.org/fof-ct/fof_ct_version",
      "description": "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=).",
      "examples": [
        {
          "value": "v1.0",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "fof_ct_version",
      "domain": "SpotQualityTable",
      "slot_uri": "https://w3id.org/fof-ct/fof_ct_version",
      "alias": "fof_ct_version",
      "owner": "SpotQualityTable",
      "domain_of": [
        "SpotQualityTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "fof_ct_version",
      "range": "string",
      "required": true,
      "pattern": "^v[0-9]+\\.[0-9]+",
      "@type": "SlotDefinition"
    },
    {
      "name": "SpotQualityTable_table_namespace",
      "definition_uri": "https://w3id.org/fof-ct/table_namespace",
      "description": "Identifier for this table type. Must always be '4dn_FOF-CT_quality'. Written as ##Table_Namespace= in the file header.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "table_namespace",
      "domain": "SpotQualityTable",
      "slot_uri": "https://w3id.org/fof-ct/table_namespace",
      "alias": "table_namespace",
      "owner": "SpotQualityTable",
      "domain_of": [
        "SpotQualityTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "table_namespace",
      "range": "string",
      "required": true,
      "equals_string": "4dn_FOF-CT_quality",
      "@type": "SlotDefinition"
    },
    {
      "name": "SpotQualityTable_lab_name",
      "definition_uri": "https://w3id.org/fof-ct/lab_name",
      "description": "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header.",
      "examples": [
        {
          "value": "Nobel",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "lab_name",
      "domain": "SpotQualityTable",
      "slot_uri": "https://w3id.org/fof-ct/lab_name",
      "alias": "lab_name",
      "owner": "SpotQualityTable",
      "domain_of": [
        "SpotQualityTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "lab_name",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "SpotQualityTable_experimenter_name",
      "definition_uri": "https://w3id.org/fof-ct/experimenter_name",
      "description": "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header.",
      "examples": [
        {
          "value": "John Doe",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "experimenter_name",
      "domain": "SpotQualityTable",
      "slot_uri": "https://w3id.org/fof-ct/experimenter_name",
      "alias": "experimenter_name",
      "owner": "SpotQualityTable",
      "domain_of": [
        "SpotQualityTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "experimenter_name",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "SpotQualityTable_experimenter_contact",
      "definition_uri": "https://w3id.org/fof-ct/experimenter_contact",
      "description": "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header.",
      "examples": [
        {
          "value": "john.doe@email.com",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "experimenter_contact",
      "domain": "SpotQualityTable",
      "slot_uri": "https://w3id.org/fof-ct/experimenter_contact",
      "alias": "experimenter_contact",
      "owner": "SpotQualityTable",
      "domain_of": [
        "SpotQualityTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "experimenter_contact",
      "range": "string",
      "required": true,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "@type": "SlotDefinition"
    },
    {
      "name": "SpotQualityTable_description",
      "definition_uri": "https://w3id.org/fof-ct/description",
      "description": "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "description",
      "domain": "SpotQualityTable",
      "slot_uri": "https://w3id.org/fof-ct/description",
      "alias": "description",
      "owner": "SpotQualityTable",
      "domain_of": [
        "SpotQualityTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "description",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "SpotQualityTable_additional_tables",
      "definition_uri": "https://w3id.org/fof-ct/additional_tables",
      "description": "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "additional_tables",
      "domain": "SpotQualityTable",
      "slot_uri": "https://w3id.org/fof-ct/additional_tables",
      "alias": "additional_tables",
      "owner": "SpotQualityTable",
      "domain_of": [
        "SpotQualityTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "additional_tables",
      "range": "TableNamespaceEnum",
      "required": true,
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "SpotQualityTable_softwares",
      "definition_uri": "https://w3id.org/fof-ct/softwares",
      "description": "One or more Software entries documenting every tool used to produce or process data in this table. Required only when software was used; omit the block entirely if no software was applied. Written as repeating #Software_* blocks in the file header.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "softwares",
      "domain": "SpotQualityTable",
      "slot_uri": "https://w3id.org/fof-ct/softwares",
      "alias": "softwares",
      "owner": "SpotQualityTable",
      "domain_of": [
        "SpotQualityTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "softwares",
      "range": "Software",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "SpotQualityTable_xyz_unit",
      "definition_uri": "https://w3id.org/fof-ct/xyz_unit",
      "description": "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Mandatory in every FOF-CT table.",
      "examples": [
        {
          "value": "micron",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "xyz_unit",
      "domain": "SpotQualityTable",
      "slot_uri": "https://w3id.org/fof-ct/xyz_unit",
      "alias": "xyz_unit",
      "owner": "SpotQualityTable",
      "domain_of": [
        "SpotQualityTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "xyz_unit",
      "range": "XYZUnitEnum",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "SpotQualityTable_time_unit",
      "definition_uri": "https://w3id.org/fof-ct/time_unit",
      "description": "Unit used for any time metric reported in user-defined columns. Conditionally required when any such metric is present. Written as ##Time_Unit= in the file header.",
      "examples": [
        {
          "value": "sec",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "time_unit",
      "domain": "SpotQualityTable",
      "slot_uri": "https://w3id.org/fof-ct/time_unit",
      "alias": "time_unit",
      "owner": "SpotQualityTable",
      "domain_of": [
        "SpotQualityTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "time_unit",
      "range": "TimeUnitEnum",
      "@type": "SlotDefinition"
    },
    {
      "name": "SpotQualityTable_intensity_unit",
      "definition_uri": "https://w3id.org/fof-ct/intensity_unit",
      "description": "Unit used for any intensity metric reported in user-defined columns. Conditionally required when any such metric is present. Written as ##Intensity_Unit= in the file header.",
      "examples": [
        {
          "value": "a.u.",
          "@type": "Example"
        },
        {
          "value": "photons",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "intensity_unit",
      "domain": "SpotQualityTable",
      "slot_uri": "https://w3id.org/fof-ct/intensity_unit",
      "alias": "intensity_unit",
      "owner": "SpotQualityTable",
      "domain_of": [
        "SpotQualityTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "intensity_unit",
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "SpotQualityTable_intensity_measurement_method",
      "definition_uri": "https://w3id.org/fof-ct/intensity_measurement_method",
      "description": "Method used to perform intensity measurements. Conditionally required when any intensity metric is present. Written as #Intensity_Measurement_Method: in the file header.",
      "examples": [
        {
          "value": "Localization centroid intensity",
          "@type": "Example"
        },
        {
          "value": "Mean Fluorescence Intensity",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "intensity_measurement_method",
      "domain": "SpotQualityTable",
      "slot_uri": "https://w3id.org/fof-ct/intensity_measurement_method",
      "alias": "intensity_measurement_method",
      "owner": "SpotQualityTable",
      "domain_of": [
        "SpotQualityTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "intensity_measurement_method",
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "SpotQualityTable_spot_quality_records",
      "definition_uri": "https://w3id.org/fof-ct/spot_quality_records",
      "description": "The complete collection of SpotQualityRecord rows constituting this dataset. Each record corresponds to one data row in the TSV serialisation and must include at least one user-defined quality metric column.",
      "from_schema": "https://w3id.org/fof-ct/quality",
      "is_a": "spot_quality_records",
      "domain": "SpotQualityTable",
      "slot_uri": "https://w3id.org/fof-ct/spot_quality_records",
      "alias": "spot_quality_records",
      "owner": "SpotQualityTable",
      "domain_of": [
        "SpotQualityTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "spot_quality_records",
      "range": "SpotQualityRecord",
      "required": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "RNASpotQualityRecord_rna_spot_id",
      "definition_uri": "https://w3id.org/fof-ct/rna_spot_id",
      "description": "Unique integer identifier for an RNA bright Spot, unique across the entire dataset. Used as a primary key in the RNA Spot Data table and as a foreign key in the RNA Quality and RNA Biological Data tables.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "rna_spot_id",
      "domain": "RNASpotQualityRecord",
      "slot_uri": "https://w3id.org/fof-ct/rna_spot_id",
      "identifier": true,
      "alias": "rna_spot_id",
      "owner": "RNASpotQualityRecord",
      "domain_of": [
        "RNASpotQualityRecord"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "rna_spot_id",
      "range": "integer",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "RNASpotQualityRecord_channel_name",
      "definition_uri": "https://w3id.org/fof-ct/channel_name",
      "description": "The wavelength characteristics of the emission channel used to image this Spot / RNA Spot / localization event (e.g. '510/25', '695/81'). Mandatory in the Spot Demultiplexing, Spot Quality, RNA Spot Quality, SM Localization Quality, and Undecoded SM Localization tables. Written as the Channel column.",
      "examples": [
        {
          "value": "510/25",
          "@type": "Example"
        },
        {
          "value": "695/81",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "channel_name",
      "domain": "RNASpotQualityRecord",
      "slot_uri": "https://w3id.org/fof-ct/channel_name",
      "alias": "channel_name",
      "owner": "RNASpotQualityRecord",
      "domain_of": [
        "RNASpotQualityRecord"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "channel_name",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "RNASpotQualityRecord_fluorophore_name",
      "definition_uri": "https://w3id.org/fof-ct/fluorophore_name",
      "description": "The name of the fluorophore whose emission was used to detect this Spot / RNA Spot / localization event (e.g. AlexaFluor_488, Cy5). Mandatory in the Spot Demultiplexing, Spot Quality, RNA Spot Quality, SM Localization Quality, and Undecoded SM Localization tables. Written as the Fluor column.",
      "examples": [
        {
          "value": "AlexaFluor_488",
          "@type": "Example"
        },
        {
          "value": "Cy5",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "fluorophore_name",
      "domain": "RNASpotQualityRecord",
      "slot_uri": "https://w3id.org/fof-ct/fluorophore_name",
      "alias": "fluorophore_name",
      "owner": "RNASpotQualityRecord",
      "domain_of": [
        "RNASpotQualityRecord"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "fluorophore_name",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "RNASpotQualityRecord_x_precision",
      "definition_uri": "https://w3id.org/fof-ct/x_precision",
      "description": "Metric quantifying the precision of the X-axis localization estimate. Typically the Cramer-Rao lower bound or Thompson method estimate. Highly recommended (not literally mandatory) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables. Must be accompanied by a description in the file header. Written as the reserved X_Loc_Precision column.",
      "examples": [
        {
          "value": "0.01",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "is_a": "x_precision",
      "domain": "RNASpotQualityRecord",
      "slot_uri": "https://w3id.org/fof-ct/x_precision",
      "alias": "x_precision",
      "owner": "RNASpotQualityRecord",
      "domain_of": [
        "RNASpotQualityRecord"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "x_precision",
      "range": "float",
      "@type": "SlotDefinition"
    },
    {
      "name": "RNASpotQualityRecord_y_precision",
      "definition_uri": "https://w3id.org/fof-ct/y_precision",
      "description": "Metric quantifying the precision of the Y-axis localization estimate. Highly recommended (not literally mandatory) in the Spot Quality, RNA Spot Quality, and SM Localization Quality tables. Written as the reserved Y_Loc_Precision column.",
      "examples": [
        {
