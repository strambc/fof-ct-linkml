        "LocalizationMixin",
        "RNASpot"
      ],
      "range": "float",
      "@type": "SlotDefinition"
    },
    {
      "name": "y",
      "definition_uri": "https://w3id.org/fof-ct/y",
      "description": "Sub-pixel Y coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections.",
      "examples": [
        {
          "value": "41.43",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/y",
      "owner": "RNASpot",
      "domain_of": [
        "LocalizationMixin",
        "RNASpot"
      ],
      "range": "float",
      "@type": "SlotDefinition"
    },
    {
      "name": "z",
      "definition_uri": "https://w3id.org/fof-ct/z",
      "description": "Sub-pixel Z coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections.",
      "examples": [
        {
          "value": "1.23",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/z",
      "owner": "RNASpot",
      "domain_of": [
        "LocalizationMixin",
        "RNASpot"
      ],
      "range": "float",
      "@type": "SlotDefinition"
    },
    {
      "name": "loc_id",
      "definition_uri": "https://w3id.org/fof-ct/loc_id",
      "description": "A unique integer identifier for an individual localization event. Loc_ID values are unique across the entire dataset. Serves as primary key in the Spot Demultiplexing, SM Localization Data, SM Localization Quality, and Undecoded SM Localization tables.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/loc_id",
      "owner": "SMLocalizationQualityRecord",
      "domain_of": [
        "LocalizationMixin",
        "SMLocalizationQualityRecord"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "spot_id",
      "definition_uri": "https://w3id.org/fof-ct/spot_id",
      "description": "Unique identifier for a bright DNA Spot. Used as a primary key in quality and biological data tables, and as a foreign key linking localization events to their parent Spot in the demultiplexing table. In FOF-vol-CT (table 13, SM Localization Data), this same Spot_ID concept is derived by clustering Single-Molecule (SM) Localization events rather than by direct optical detection, and every SM Localization event MUST report its associated Spot_ID.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/spot_id",
      "owner": "SMLocalization",
      "domain_of": [
        "Localization",
        "SpotQualityRecord",
        "SpotBiologicalRecord",
        "SMLocalization"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "trace_id",
      "definition_uri": "https://w3id.org/fof-ct/trace_id",
      "description": "Unique identifier for a chromatin Trace. Used as a primary key in the Trace Data table and as a foreign key in the RNA Spot Data table and (mandatorily) in the FOF-vol-CT SM Localization Data table.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/trace_id",
      "owner": "SMLocalization",
      "domain_of": [
        "Trace",
        "RNASpot",
        "SMLocalization"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "sub_cell_roi_id",
      "definition_uri": "https://w3id.org/fof-ct/sub_cell_roi_id",
      "description": "Unique identifier for a sub-cellular structure ROI (e.g., nucleus, nucleolus). Links to the Sub-Cell ROI Data table.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/sub_cell_roi_id",
