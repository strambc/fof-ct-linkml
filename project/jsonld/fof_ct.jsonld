{
  "name": "fof_ct",
  "description": "Root schema for the FISH Omics Format for Chromatin Tracing - Ball-and-Stick modality (FOF-bas-CT). Imports all twelve table schemas that together constitute the complete FOF-bas-CT data model. Each table schema in turn imports fof_bas_ct_common for shared slots, the Software class, and enumerations.",
  "title": "FISH Omics Format for Chromatin Tracing (FOF-CT)",
  "see_also": [
    "https://4dn-dcic.github.io/fof-ct",
    "https://fish-omics-format.readthedocs.io/"
  ],
  "id": "https://w3id.org/fof-ct",
  "version": "1.0.0",
  "imports": [
    "linkml:types",
    "fof_bas_ct_common",
    "fof_bas_ct_core",
    "fof_bas_ct_demultiplexing",
    "fof_bas_ct_trace",
    "fof_bas_ct_rna",
    "fof_bas_ct_quality",
    "fof_bas_ct_rna_quality",
    "fof_bas_ct_bio",
    "fof_bas_ct_rna_bio",
    "fof_bas_ct_cell",
    "fof_bas_ct_extracell",
    "fof_bas_ct_subcell",
    "fof_bas_ct_mapping"
  ],
  "license": "MIT",
  "prefixes": [
    {
      "prefix_prefix": "linkml",
      "prefix_reference": "https://w3id.org/linkml/"
    },
    {
      "prefix_prefix": "fof_ct",
      "prefix_reference": "https://w3id.org/fof-ct/"
    },
    {
      "prefix_prefix": "xsd",
      "prefix_reference": "http://www.w3.org/2001/XMLSchema#"
    }
  ],
  "default_prefix": "fof_ct",
  "default_range": "string",
  "types": [
    {
      "name": "string",
      "definition_uri": "https://w3id.org/linkml/String",
      "description": "A character string",
      "notes": [
        "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Text"
      ],
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
      "name": "integer",
      "definition_uri": "https://w3id.org/linkml/Integer",
      "description": "An integer",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"integer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Integer"
      ],
      "base": "int",
      "uri": "http://www.w3.org/2001/XMLSchema#integer",
      "@type": "TypeDefinition"
    },
    {
      "name": "boolean",
      "definition_uri": "https://w3id.org/linkml/Boolean",
      "description": "A binary (true or false) value",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"boolean\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Boolean"
      ],
      "base": "Bool",
      "uri": "http://www.w3.org/2001/XMLSchema#boolean",
      "repr": "bool",
      "@type": "TypeDefinition"
    },
    {
      "name": "float",
      "definition_uri": "https://w3id.org/linkml/Float",
      "description": "A real number that conforms to the xsd:float specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"float\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Float"
      ],
      "base": "float",
      "uri": "http://www.w3.org/2001/XMLSchema#float",
      "@type": "TypeDefinition"
    },
    {
      "name": "double",
      "definition_uri": "https://w3id.org/linkml/Double",
      "description": "A real number that conforms to the xsd:double specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"double\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "close_mappings": [
        "schema:Float"
      ],
      "base": "float",
      "uri": "http://www.w3.org/2001/XMLSchema#double",
      "@type": "TypeDefinition"
    },
    {
      "name": "decimal",
      "definition_uri": "https://w3id.org/linkml/Decimal",
      "description": "A real number with arbitrary precision that conforms to the xsd:decimal specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"decimal\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "broad_mappings": [
        "schema:Number"
      ],
      "base": "Decimal",
      "uri": "http://www.w3.org/2001/XMLSchema#decimal",
      "@type": "TypeDefinition"
    },
    {
      "name": "time",
      "definition_uri": "https://w3id.org/linkml/Time",
      "description": "A time object represents a (local) time of day, independent of any particular day",
      "notes": [
        "URI is dateTime because OWL reasoners do not work with straight date or time",
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Time"
      ],
      "base": "XSDTime",
      "uri": "http://www.w3.org/2001/XMLSchema#time",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "date",
      "definition_uri": "https://w3id.org/linkml/Date",
      "description": "a date (year, month and day) in an idealized calendar",
      "notes": [
        "URI is dateTime because OWL reasoners don't work with straight date or time",
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Date"
      ],
      "base": "XSDDate",
      "uri": "http://www.w3.org/2001/XMLSchema#date",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "datetime",
      "definition_uri": "https://w3id.org/linkml/Datetime",
      "description": "The combination of a date and time",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"datetime\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:DateTime"
      ],
      "base": "XSDDateTime",
      "uri": "http://www.w3.org/2001/XMLSchema#dateTime",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "date_or_datetime",
      "definition_uri": "https://w3id.org/linkml/DateOrDatetime",
      "description": "Either a date or a datetime",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date_or_datetime\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "https://w3id.org/linkml/DateOrDatetime",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "uriorcurie",
      "definition_uri": "https://w3id.org/linkml/Uriorcurie",
      "description": "a URI or a CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "URIorCURIE",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "curie",
      "definition_uri": "https://w3id.org/linkml/Curie",
      "conforms_to": "https://www.w3.org/TR/curie/",
      "description": "a compact URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"."
      ],
      "comments": [
        "in RDF serializations this MUST be expanded to a URI",
        "in non-RDF serializations MAY be serialized as the compact representation"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "Curie",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "uri",
      "definition_uri": "https://w3id.org/linkml/Uri",
      "conforms_to": "https://www.ietf.org/rfc/rfc3987.txt",
      "description": "a complete URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"."
      ],
      "comments": [
        "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "close_mappings": [
        "schema:URL"
      ],
      "base": "URI",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "ncname",
      "definition_uri": "https://w3id.org/linkml/Ncname",
      "description": "Prefix part of CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"ncname\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NCName",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "objectidentifier",
      "definition_uri": "https://w3id.org/linkml/Objectidentifier",
      "description": "A URI or CURIE that represents an object in the model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"objectidentifier\"."
      ],
      "comments": [
        "Used for inheritance and type checking"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "ElementIdentifier",
      "uri": "http://www.w3.org/ns/shex#iri",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "nodeidentifier",
      "definition_uri": "https://w3id.org/linkml/Nodeidentifier",
      "description": "A URI, CURIE or BNODE that represents a node in a model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"nodeidentifier\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NodeIdentifier",
      "uri": "http://www.w3.org/ns/shex#nonLiteral",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpointer",
      "definition_uri": "https://w3id.org/linkml/Jsonpointer",
      "conforms_to": "https://datatracker.ietf.org/doc/html/rfc6901",
      "description": "A string encoding a JSON Pointer. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to a valid object within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpointer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpath",
      "definition_uri": "https://w3id.org/linkml/Jsonpath",
      "conforms_to": "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html",
      "description": "A string encoding a JSON Path. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "sparqlpath",
      "definition_uri": "https://w3id.org/linkml/Sparqlpath",
      "conforms_to": "https://www.w3.org/TR/sparql11-query/#propertypaths",
      "description": "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    }
  ],
  "enums": [
    {
      "name": "XYZUnitEnum",
      "definition_uri": "https://w3id.org/fof-ct/XYZUnitEnum",
      "description": "Allowed units for X, Y, Z spatial coordinates or distances.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "permissible_values": [
        {
          "text": "nm",
          "description": "Nanometres"
        },
        {
          "text": "micron",
          "description": "Micrometres. Use 'micron' rather than the Greek symbol \u03bcm to avoid encoding issues."
        },
        {
          "text": "mm",
          "description": "Millimetres"
        }
      ]
    },
    {
      "name": "TimeUnitEnum",
      "definition_uri": "https://w3id.org/fof-ct/TimeUnitEnum",
      "description": "Allowed units for time intervals.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "permissible_values": [
        {
          "text": "s",
          "description": "Seconds (SI base unit)"
        },
        {
          "text": "sec",
          "description": "Seconds (alternative spelling accepted by FOF-CT)"
        },
        {
          "text": "ms",
          "description": "Milliseconds"
        },
        {
          "text": "min",
          "description": "Minutes"
        },
        {
          "text": "hr",
          "description": "Hours"
        }
      ]
    },
    {
      "name": "SoftwareTypeEnum",
      "definition_uri": "https://w3id.org/fof-ct/SoftwareTypeEnum",
      "description": "Allowed functional categories for software tools.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "permissible_values": [
        {
          "text": "SpotLoc",
          "description": "Spot localisation software"
        },
        {
          "text": "Tracing",
          "description": "Chromatin tracing software"
        },
        {
          "text": "SpotLoc+Tracing",
          "description": "Combined spot localisation and tracing software"
        },
        {
          "text": "Segmentation",
          "description": "Image segmentation software"
        },
        {
          "text": "QC",
          "description": "Quality control software"
        },
        {
          "text": "Distance",
          "description": "Distance calculation software"
        },
        {
          "text": "Other",
          "description": "Other software type"
        }
      ]
    },
    {
      "name": "TableNamespaceEnum",
      "definition_uri": "https://w3id.org/fof-ct/TableNamespaceEnum",
      "description": "Allowed namespace identifiers for FOF-CT tables that may be listed in the additional_tables field.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "permissible_values": [
        {
          "text": "4dn_FOF-CT_core",
          "description": "DNA-Spot/Trace Data core table (table 1)"
        },
        {
          "text": "4dn_FOF-CT_demultiplexing",
          "description": "Spot Demultiplexing table (table 2)"
        },
        {
          "text": "4dn_FOF-CT_trace",
          "description": "Trace Data table (table 3)"
        },
        {
          "text": "4dn_FOF-CT_rna",
          "description": "RNA Spot Data table (table 4)"
        },
        {
          "text": "4dn_FOF-CT_quality",
          "description": "Spot Quality table (table 5)"
        },
        {
          "text": "4dn_FOF-CT_rna_quality",
          "description": "RNA Spot Quality table (table 6)"
        },
        {
          "text": "4dn_FOF-CT_bio",
          "description": "Spot Biological Data table (table 7)"
        },
        {
          "text": "4dn_FOF-CT_rna_bio",
          "description": "RNA Spot Biological Data table (table 8)"
        },
        {
          "text": "4dn_FOF-CT_cell",
          "description": "Cell Data table (table 9)"
        },
        {
          "text": "4dn_FOF-CT_extracell",
          "description": "Extra-Cell ROI Data table (table 10)"
        },
        {
          "text": "4dn_FOF-CT_subcell",
          "description": "Sub-Cell ROI Data table (table 11)"
        },
        {
          "text": "4dn_FOF-CT_mapping",
          "description": "Cell/ROI Mapping table (table 12)"
        }
      ]
    }
  ],
  "slots": [
    {
      "name": "fof_ct_version",
      "definition_uri": "https://w3id.org/fof-ct/fof_ct_version",
      "description": "Version of the FOF-CT format used in this file. Always the first line of the file header (##FOF-CT_Version=).",
      "examples": [
        {
          "value": "v1.0",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/fof_ct_version",
      "owner": "ROIMappingTable",
      "domain_of": [
        "LocalizationTable",
        "TraceTable",
        "RNASpotTable",
        "SpotQualityTable",
        "RNASpotQualityTable",
        "SpotBiologicalTable",
        "RNASpotBiologicalTable",
        "CellTable",
        "ExtraCellROITable",
        "SubCellROITable",
        "ROIMappingTable"
      ],
      "range": "string",
      "pattern": "^v[0-9]+\\.[0-9]+",
      "@type": "SlotDefinition"
    },
    {
      "name": "table_namespace",
      "definition_uri": "https://w3id.org/fof-ct/table_namespace",
      "description": "Identifier for this table type. The required value is specific to each table. Written as ##Table_Namespace= in the file header.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/table_namespace",
      "owner": "ROIMappingTable",
      "domain_of": [
        "LocalizationTable",
        "TraceTable",
        "RNASpotTable",
        "SpotQualityTable",
        "RNASpotQualityTable",
        "SpotBiologicalTable",
        "RNASpotBiologicalTable",
        "CellTable",
        "ExtraCellROITable",
        "SubCellROITable",
        "ROIMappingTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "lab_name",
      "definition_uri": "https://w3id.org/fof-ct/lab_name",
      "description": "Name of the laboratory where the experiment was performed. Written as #Lab_Name: in the file header.",
      "examples": [
        {
          "value": "Nobel",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/lab_name",
      "owner": "ROIMappingTable",
      "domain_of": [
        "LocalizationTable",
        "TraceTable",
        "RNASpotTable",
        "SpotQualityTable",
        "RNASpotQualityTable",
        "SpotBiologicalTable",
        "RNASpotBiologicalTable",
        "CellTable",
        "ExtraCellROITable",
        "SubCellROITable",
        "ROIMappingTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "experimenter_name",
      "definition_uri": "https://w3id.org/fof-ct/experimenter_name",
      "description": "Full name of the person who performed the experiment. Written as #Experimenter_Name: in the file header.",
      "examples": [
        {
          "value": "John Doe",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/experimenter_name",
      "owner": "ROIMappingTable",
      "domain_of": [
        "LocalizationTable",
        "TraceTable",
        "RNASpotTable",
        "SpotQualityTable",
        "RNASpotQualityTable",
        "SpotBiologicalTable",
        "RNASpotBiologicalTable",
        "CellTable",
        "ExtraCellROITable",
        "SubCellROITable",
        "ROIMappingTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "experimenter_contact",
      "definition_uri": "https://w3id.org/fof-ct/experimenter_contact",
      "description": "Email address of the person who performed the experiment. Written as #Experimenter_Contact: in the file header.",
      "examples": [
        {
          "value": "john.doe@email.com",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/experimenter_contact",
      "owner": "ROIMappingTable",
      "domain_of": [
        "LocalizationTable",
        "TraceTable",
        "RNASpotTable",
        "SpotQualityTable",
        "RNASpotQualityTable",
        "SpotBiologicalTable",
        "RNASpotBiologicalTable",
        "CellTable",
        "ExtraCellROITable",
        "SubCellROITable",
        "ROIMappingTable"
      ],
      "range": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "@type": "SlotDefinition"
    },
    {
      "name": "description",
      "definition_uri": "https://w3id.org/fof-ct/description",
      "description": "Free-text description of the experiment and of the data recorded in this table. Should provide sufficient detail for interpretation and reproducibility. Written as #Description: in the file header.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/description",
      "owner": "ROIMappingTable",
      "domain_of": [
        "LocalizationTable",
        "TraceTable",
        "RNASpotTable",
        "SpotQualityTable",
        "RNASpotQualityTable",
        "SpotBiologicalTable",
        "RNASpotBiologicalTable",
        "CellTable",
        "ExtraCellROITable",
        "SubCellROITable",
        "ROIMappingTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "additional_tables",
      "definition_uri": "https://w3id.org/fof-ct/additional_tables",
      "description": "List of additional FOF-CT table namespaces being submitted alongside this table, separated by commas in the TSV header. Written as #Additional_Tables: in the file header.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/additional_tables",
      "owner": "ROIMappingTable",
      "domain_of": [
        "LocalizationTable",
        "TraceTable",
        "RNASpotTable",
        "SpotQualityTable",
        "RNASpotQualityTable",
        "SpotBiologicalTable",
        "RNASpotBiologicalTable",
        "CellTable",
        "ExtraCellROITable",
        "SubCellROITable",
        "ROIMappingTable"
      ],
      "range": "TableNamespaceEnum",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "softwares",
      "definition_uri": "https://w3id.org/fof-ct/softwares",
      "description": "One or more Software entries documenting every tool used to produce or process data in this table. Written as repeating #Software_* blocks in the file header.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/softwares",
      "owner": "ROIMappingTable",
      "domain_of": [
        "LocalizationTable",
        "TraceTable",
        "RNASpotTable",
        "SpotQualityTable",
        "RNASpotQualityTable",
        "SpotBiologicalTable",
        "RNASpotBiologicalTable",
        "CellTable",
        "ExtraCellROITable",
        "SubCellROITable",
        "ROIMappingTable"
      ],
      "range": "Software",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "xyz_unit",
      "definition_uri": "https://w3id.org/fof-ct/xyz_unit",
      "description": "Unit used to represent X, Y, Z spatial coordinates or distances in this table. Use 'micron' to avoid issues with Greek symbols. Values should be drawn from SI units of length. Written as ##XYZ_Unit= in the file header. Conditionally required when any location or distance metric is reported.",
      "examples": [
        {
          "value": "micron",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/xyz_unit",
      "owner": "ROIMappingTable",
      "domain_of": [
        "LocalizationTable",
        "TraceTable",
        "RNASpotTable",
        "SpotQualityTable",
        "RNASpotQualityTable",
        "SpotBiologicalTable",
        "RNASpotBiologicalTable",
        "CellTable",
        "ExtraCellROITable",
        "SubCellROITable",
        "ROIMappingTable"
      ],
      "range": "XYZUnitEnum",
      "@type": "SlotDefinition"
    },
    {
      "name": "time_unit",
      "definition_uri": "https://w3id.org/fof-ct/time_unit",
      "description": "Unit used to represent time intervals in this table. Allowed values are SI time units plus 'min' and 'hr'. Written as ##Time_Unit= in the file header. Conditionally required when any time metric is reported.",
      "examples": [
        {
          "value": "sec",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/time_unit",
      "owner": "ROIMappingTable",
      "domain_of": [
        "LocalizationTable",
        "TraceTable",
        "RNASpotTable",
        "SpotQualityTable",
        "RNASpotQualityTable",
        "SpotBiologicalTable",
        "RNASpotBiologicalTable",
        "CellTable",
        "ExtraCellROITable",
        "SubCellROITable",
        "ROIMappingTable"
      ],
      "range": "TimeUnitEnum",
      "@type": "SlotDefinition"
    },
    {
      "name": "intensity_unit",
      "definition_uri": "https://w3id.org/fof-ct/intensity_unit",
      "description": "Unit used to represent intensity measurements in this table. Written as ##Intensity_Unit= in the file header. Conditionally required when any intensity metric is reported.",
      "examples": [
        {
          "value": "a.u.",
          "@type": "Example"
        },
        {
          "value": "photons",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/intensity_unit",
      "owner": "ROIMappingTable",
      "domain_of": [
        "LocalizationTable",
        "TraceTable",
        "RNASpotTable",
        "SpotQualityTable",
        "RNASpotQualityTable",
        "SpotBiologicalTable",
        "RNASpotBiologicalTable",
        "CellTable",
        "ExtraCellROITable",
        "SubCellROITable",
        "ROIMappingTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "intensity_measurement_method",
      "definition_uri": "https://w3id.org/fof-ct/intensity_measurement_method",
      "description": "Method used to perform intensity measurements, including how digital signals were converted to photon counts. Written as #Intensity_Measurement_Method: in the file header. Conditionally required when any intensity metric is reported.",
      "examples": [
        {
          "value": "Localization centroid intensity",
          "@type": "Example"
        },
        {
          "value": "Mean Fluorescence Intensity",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/intensity_measurement_method",
      "owner": "ROIMappingTable",
      "domain_of": [
        "LocalizationTable",
        "TraceTable",
        "RNASpotTable",
        "SpotQualityTable",
        "RNASpotQualityTable",
        "SpotBiologicalTable",
        "RNASpotBiologicalTable",
        "CellTable",
        "ExtraCellROITable",
        "SubCellROITable",
        "ROIMappingTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "x",
      "definition_uri": "https://w3id.org/fof-ct/x",
      "description": "Sub-pixel X coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections (drift correction, chromatic correction, etc.).",
      "examples": [
        {
          "value": "14.43",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/x",
      "owner": "RNASpot",
      "domain_of": [
        "Localization",
        "RNASpot"
      ],
      "range": "float",
      "@type": "SlotDefinition"
    },
    {
      "name": "y",
      "definition_uri": "https://w3id.org/fof-ct/y",
      "description": "Sub-pixel Y coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections.",
      "examples": [
        {
          "value": "41.43",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/y",
      "owner": "RNASpot",
      "domain_of": [
        "Localization",
        "RNASpot"
      ],
      "range": "float",
      "@type": "SlotDefinition"
    },
    {
      "name": "z",
      "definition_uri": "https://w3id.org/fof-ct/z",
      "description": "Sub-pixel Z coordinate of this detected event (Spot or localisation) in the unit specified by xyz_unit. The reported value is the final position after all post-processing corrections.",
      "examples": [
        {
          "value": "1.23",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/z",
      "owner": "RNASpot",
      "domain_of": [
        "Localization",
        "RNASpot"
      ],
      "range": "float",
      "@type": "SlotDefinition"
    },
    {
      "name": "spot_id",
      "definition_uri": "https://w3id.org/fof-ct/spot_id",
      "description": "Unique identifier for a bright DNA Spot. Used as a primary key in quality and biological data tables, and as a foreign key linking localization events to their parent Spot in the demultiplexing table.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/spot_id",
      "owner": "SpotBiologicalRecord",
      "domain_of": [
        "Localization",
        "SpotQualityRecord",
        "SpotBiologicalRecord"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "trace_id",
      "definition_uri": "https://w3id.org/fof-ct/trace_id",
      "description": "Unique identifier for a chromatin Trace. Used as a primary key in the Trace Data table and as a foreign key in the RNA Spot Data table.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/trace_id",
      "owner": "RNASpot",
      "domain_of": [
        "Trace",
        "RNASpot"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "sub_cell_roi_id",
      "definition_uri": "https://w3id.org/fof-ct/sub_cell_roi_id",
      "description": "Unique identifier for a sub-cellular structure ROI (e.g., nucleus, nucleolus). Links to the Sub-Cell ROI Data table.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/sub_cell_roi_id",
      "owner": "ROIMapping",
      "domain_of": [
        "RNASpot",
        "SubCellROI",
        "ROIMapping"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "cell_id",
      "definition_uri": "https://w3id.org/fof-ct/cell_id",
      "description": "Unique identifier for a Cell. Links to the Cell Data table.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/cell_id",
      "owner": "ROIMapping",
      "domain_of": [
        "RNASpot",
        "Cell",
        "SubCellROI",
        "ROIMapping"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "extra_cell_roi_id",
      "definition_uri": "https://w3id.org/fof-ct/extra_cell_roi_id",
      "description": "Unique identifier for an extracellular structure ROI (e.g., tissue, organoid). Links to the Extra-Cell ROI Data table.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/extra_cell_roi_id",
      "owner": "ROIMapping",
      "domain_of": [
        "RNASpot",
        "Cell",
        "ExtraCellROI",
        "ROIMapping"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "rna_spot_id",
      "definition_uri": "https://w3id.org/fof-ct/rna_spot_id",
      "description": "Unique integer identifier for an RNA bright Spot, unique across the entire dataset. Used as a primary key in the RNA Spot Data table and as a foreign key in the RNA Quality and RNA Biological Data tables.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/rna_spot_id",
      "owner": "RNASpotBiologicalRecord",
      "domain_of": [
        "RNASpot",
        "RNASpotQualityRecord",
        "RNASpotBiologicalRecord"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "genome_assembly",
      "definition_uri": "https://w3id.org/fof-ct/genome_assembly",
      "description": "Genome build used for Chrom, Chrom_Start and Chrom_End coordinates. The 4DN Data Portal accepts GRCh38 (human) and GRCm38 (mouse). When the genome under study contains an INSERTION or DELETION the value must use the mandatory 'custom-build:' prefix followed by a descriptive name (e.g., custom-build:GRCm38+pJT039(insertion)). Written as ##Genome_Assembly= in the file header.",
      "examples": [
        {
          "value": "GRCh38",
          "@type": "Example"
        },
        {
          "value": "custom-build:GRCm38+pJT039(insertion)",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/genome_assembly",
      "owner": "RNASpotTable",
      "domain_of": [
        "RNASpotTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "cell_type",
      "definition_uri": "https://w3id.org/fof-ct/cell_type",
      "description": "The type of cells present in this dataset, expressed using an ontology term from the Experimental Factor Ontology (EFO). Examples include \"Cell in tissue\" or \"Cell in organoid\". Written as #Cell_Type: in the file header.",
      "examples": [
        {
          "value": "Cell in tissue",
          "@type": "Example"
        },
        {
          "value": "Cell in organoid",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/cell_type",
      "owner": "ROIMappingTable",
      "domain_of": [
        "CellTable",
        "SubCellROITable",
        "ROIMappingTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "extra_cell_roi_type",
      "definition_uri": "https://w3id.org/fof-ct/extra_cell_roi_type",
      "description": "The type of extracellular structure ROI within which cells are embedded, expressed using an EFO 'organism part' child term (e.g. Tissue, Organoid). Conditionally required when extracellular structure ROIs are identified and reported in a dedicated Extra-Cell ROI Data table. Written as #Extra_Cell_ROI_Type: in the file header.",
      "examples": [
        {
          "value": "Tissue",
          "@type": "Example"
        },
        {
          "value": "Organoid",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/extra_cell_roi_type",
      "owner": "ROIMappingTable",
      "domain_of": [
        "CellTable",
        "ExtraCellROITable",
        "ROIMappingTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "sub_cell_roi_type",
      "definition_uri": "https://w3id.org/fof-ct/sub_cell_roi_type",
      "description": "The type of sub-cellular structure ROI documented in this table or mapping file. It is recommended to use an EFO 'cellular_component' child term. Examples include Nucleolus, NL (nuclear lamina), NPC (nuclear pore complex), PML_body, Cajal_body, Chromosome_Domain. Written as #Sub_Cell_ROI_Type: in the file header.",
      "examples": [
        {
          "value": "Nucleolus",
          "@type": "Example"
        },
        {
          "value": "NL",
          "@type": "Example"
        },
        {
          "value": "NPC",
          "@type": "Example"
        },
        {
          "value": "Chromosome_Domain",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/sub_cell_roi_type",
      "owner": "ROIMappingTable",
      "domain_of": [
        "SubCellROITable",
        "ROIMappingTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "software_title",
      "definition_uri": "https://w3id.org/fof-ct/software_title",
      "description": "Name of the software tool. Written as #Software_Title:.",
      "examples": [
        {
          "value": "ChrTracer3",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/software_title",
      "owner": "Software",
      "domain_of": [
        "Software"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "software_type",
      "definition_uri": "https://w3id.org/fof-ct/software_type",
      "description": "Functional category of the software tool. Written as #Software_Type:.",
      "examples": [
        {
          "value": "SpotLoc+Tracing",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/software_type",
      "owner": "Software",
      "domain_of": [
        "Software"
      ],
      "range": "SoftwareTypeEnum",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "software_authors",
      "definition_uri": "https://w3id.org/fof-ct/software_authors",
      "description": "Author name(s) in 'Surname, Firstname' format, multiple authors separated by semicolons. Written as #Software_Authors:.",
      "examples": [
        {
          "value": "Mateo, LJ; Sinnott-Armstrong, N; Boettiger, AN",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/software_authors",
      "owner": "Software",
      "domain_of": [
        "Software"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "software_description",
      "definition_uri": "https://w3id.org/fof-ct/software_description",
      "description": "Free-text description of the algorithm and analysis parameters, sufficient to guarantee reproducibility. Written as #Software_Description:.",
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/software_description",
      "owner": "Software",
      "domain_of": [
        "Software"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "software_repository",
      "definition_uri": "https://w3id.org/fof-ct/software_repository",
      "description": "URL of the repository where the software release can be obtained. Written as #Software_Repository:.",
      "examples": [
        {
          "value": "https://github.com/BoettigerLab/ORCA-public",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/software_repository",
      "owner": "Software",
      "domain_of": [
        "Software"
      ],
      "range": "uri",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "software_preferred_citation_id",
      "definition_uri": "https://w3id.org/fof-ct/software_preferred_citation_id",
      "description": "Unique identifier (DOI, PMCID, ArXiv ID, etc.) for the primary publication describing this software. Written as #Software_PreferredCitationID:.",
      "examples": [
        {
          "value": "https://doi.org/10.1038/s41596-020-00478-x",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/common",
      "slot_uri": "https://w3id.org/fof-ct/software_preferred_citation_id",
      "owner": "Software",
      "domain_of": [
        "Software"
      ],
      "range": "uri",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "loc_id",
      "definition_uri": "https://w3id.org/fof-ct/loc_id",
      "description": "A unique integer identifier for this individual localisation event. Loc_ID values are unique across the entire dataset.",
      "examples": [
        {
          "value": "1",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/demultiplexing",
      "domain": "Localization",
      "slot_uri": "https://w3id.org/fof-ct/loc_id",
      "identifier": true,
      "owner": "Localization",
      "domain_of": [
        "Localization"
      ],
      "range": "integer",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "fluor",
      "definition_uri": "https://w3id.org/fof-ct/fluor",
      "description": "Fluorescent channel in which this individual localisation event was detected (e.g. DAPI, GFP, Cy5, Alexa647).",
      "examples": [
        {
          "value": "Cy5",
          "@type": "Example"
        },
        {
          "value": "Alexa647",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/demultiplexing",
      "domain": "Localization",
      "slot_uri": "https://w3id.org/fof-ct/fluor",
      "owner": "Localization",
      "domain_of": [
        "Localization"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "localizations",
      "definition_uri": "https://w3id.org/fof-ct/localizations",
      "description": "The complete collection of Localization events constituting this dataset. Each Localization corresponds to one data row in the TSV serialisation.",
      "from_schema": "https://w3id.org/fof-ct/demultiplexing",
      "domain": "LocalizationTable",
      "slot_uri": "https://w3id.org/fof-ct/localizations",
      "owner": "LocalizationTable",
      "domain_of": [
        "LocalizationTable"
      ],
      "range": "Localization",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "traces",
      "definition_uri": "https://w3id.org/fof-ct/traces",
      "description": "The complete collection of Traces constituting this dataset. Each Trace corresponds to one data row in the TSV serialisation.",
      "from_schema": "https://w3id.org/fof-ct/trace",
      "domain": "TraceTable",
      "slot_uri": "https://w3id.org/fof-ct/traces",
      "owner": "TraceTable",
      "domain_of": [
        "TraceTable"
      ],
      "range": "Trace",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "gene_id_type",
      "definition_uri": "https://w3id.org/fof-ct/gene_id_type",
      "description": "Type of gene identifier used in the gene_id column (e.g. Ensembl_V38, NCBI_Gene). Written as ##Gene_ID_Type= in the file header.",
      "examples": [
        {
          "value": "Ensembl_V38",
          "@type": "Example"
        },
        {
          "value": "NCBI_Gene",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/fof-ct/rna",
      "domain": "RNASpotTable",
      "slot_uri": "https://w3id.org/fof-ct/gene_id_type",
      "owner": "RNASpotTable",
      "domain_of": [
        "RNASpotTable"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "transcript_id_type",
      "definition_uri": "https://w3id.org/fof-ct/transcript_id_type",
      "description": "Type of transcript identifier used in the transcript_id column (e.g. Ensembl_V38, RefSeq). Conditionally required when multiple transcripts share the same gene_id and the FISH probe can distinguish among them. Written as ##Transcript_ID_Type= in the file header.",
      "examples": [
        {
          "value": "Ensembl_V38",
          "@type": "Example"
        },
        {
          "value": "RefSeq",
          "@type": "Example"
        }
      ],
