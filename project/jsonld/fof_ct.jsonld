      "slot_uri": "https://w3id.org/fof-ct/extra_cell_roi_type",
      "alias": "extra_cell_roi_type",
      "owner": "ROIMappingTable",
      "domain_of": [
        "ROIMappingTable"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "extra_cell_roi_type",
      "range": "string",
      "@type": "SlotDefinition"
