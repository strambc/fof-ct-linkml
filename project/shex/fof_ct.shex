}

<ROIMapping> CLOSED {
    (  $<ROIMapping_tes> (  <sub_cell_roi_id> @linkml:Integer ? ;
          <cell_id> @linkml:Integer ? ;
          <extra_cell_roi_id> @linkml:Integer ? ;
          <roi_boundaries> @linkml:String
       ) ;
       rdf:type [ <ROIMapping> ] ?
    )
}

<ROIMappingTable> CLOSED {
    (  $<ROIMappingTable_tes> (  <fof_ct_version> @linkml:String ;
          <table_namespace> @linkml:String ;
