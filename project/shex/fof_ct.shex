             <https://w3id.org/fof-ct/TableNamespaceEnum#FOF-CT_undecoded> ] + ;
          <softwares> @<Software> * ;
          <xyz_unit> [ <https://w3id.org/fof-ct/XYZUnitEnum#nm> <https://w3id.org/fof-ct/XYZUnitEnum#micron>
             <https://w3id.org/fof-ct/XYZUnitEnum#mm> ] ;
          <time_unit> [ <https://w3id.org/fof-ct/TimeUnitEnum#s> <https://w3id.org/fof-ct/TimeUnitEnum#sec>
             <https://w3id.org/fof-ct/TimeUnitEnum#ms> <https://w3id.org/fof-ct/TimeUnitEnum#msec>
             <https://w3id.org/fof-ct/TimeUnitEnum#min> <https://w3id.org/fof-ct/TimeUnitEnum#hr> ] ? ;
          <intensity_unit> @linkml:String ? ;
          <intensity_measurement_method> @linkml:String ? ;
          <extra_cell_rois> @<ExtraCellROI> +
       ) ;
       rdf:type [ <ExtraCellROITable> ] ?
    )
}

<Localization> CLOSED {
    (  $<Localization_tes> (  &<LocalizationMixin_tes> ;
          rdf:type [ <LocalizationMixin> ] ? ;
          <spot_id> @linkml:Integer ;
          <channel_name> @linkml:String ;
          <fluorophore_name> @linkml:String ;
          <x> @linkml:Float ;
          <y> @linkml:Float ;
          <z> @linkml:Float
       ) ;
       rdf:type [ <Localization> ]
    )
}

<LocalizationMixin> {
    (  $<LocalizationMixin_tes> (  <loc_id> @linkml:Integer ? ;
          <x> @linkml:Float ? ;
          <y> @linkml:Float ? ;
          <z> @linkml:Float ?
       ) ;
       rdf:type [ <LocalizationMixin> ] ?
    )
}

<RNASpot> CLOSED {
    (  $<RNASpot_tes> (  <rna_spot_id> @linkml:Integer ;
          <x> @linkml:Float ;
          <y> @linkml:Float ;
          <z> @linkml:Float ;
          <rna_name> @linkml:String ;
          <gene_id> @linkml:String ;
          <trace_id> @linkml:Integer ;
          <transcript_id> @linkml:String ? ;
          <sub_cell_roi_id> @linkml:Integer ? ;
          <cell_id> @linkml:Integer ? ;
          <extra_cell_roi_id> @linkml:Integer ?
       ) ;
       rdf:type [ <RNASpot> ] ?
    )
}

<RNASpotBiologicalRecord> CLOSED {
    (  $<RNASpotBiologicalRecord_tes> rdf:type . * ;
       rdf:type [ <RNASpotBiologicalRecord> ]
    )
}

<RNASpotBiologicalTable> CLOSED {
    (  $<RNASpotBiologicalTable_tes> (  <fof_ct_version> @linkml:String ;
          <table_namespace> @linkml:String ;
          <lab_name> @linkml:String ;
          <experimenter_name> @linkml:String ;
          <experimenter_contact> @linkml:String ;
          <description> @linkml:String ;
          <additional_tables> [ <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_core>
             <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_demultiplexing>
             <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_trace>
             <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_rna>
             <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_quality>
             <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_rna_quality>
             <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_bio>
             <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_rna_bio>
             <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_cell>
             <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_extracell>
             <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_subcell>
             <https://w3id.org/fof-ct/TableNamespaceEnum#4dn_FOF-CT_mapping>
             <https://w3id.org/fof-ct/TableNamespaceEnum#FOF-CT_vol_core>
             <https://w3id.org/fof-ct/TableNamespaceEnum#FOF-CT_vol_quality>
             <https://w3id.org/fof-ct/TableNamespaceEnum#FOF-CT_undecoded> ] + ;
          <softwares> @<Software> * ;
          <xyz_unit> [ <https://w3id.org/fof-ct/XYZUnitEnum#nm> <https://w3id.org/fof-ct/XYZUnitEnum#micron>
             <https://w3id.org/fof-ct/XYZUnitEnum#mm> ] ;
          <time_unit> [ <https://w3id.org/fof-ct/TimeUnitEnum#s> <https://w3id.org/fof-ct/TimeUnitEnum#sec>
             <https://w3id.org/fof-ct/TimeUnitEnum#ms> <https://w3id.org/fof-ct/TimeUnitEnum#msec>
             <https://w3id.org/fof-ct/TimeUnitEnum#min> <https://w3id.org/fof-ct/TimeUnitEnum#hr> ] ? ;
          <intensity_unit> @linkml:String ? ;
          <intensity_measurement_method> @linkml:String ? ;
          <rna_spot_biological_records> @<RNASpotBiologicalRecord> +
       ) ;
       rdf:type [ <RNASpotBiologicalTable> ] ?
    )
}

<RNASpotQualityRecord> CLOSED {
    (  $<RNASpotQualityRecord_tes> (  <channel_name> @linkml:String ;
          <fluorophore_name> @linkml:String ;
          <x_precision> @linkml:Float ? ;
          <y_precision> @linkml:Float ? ;
          <z_precision> @linkml:Float ? ;
          <photon_count> @linkml:Integer ? ;
          <goodness_of_fit> @linkml:Float ? ;
          <centroid_intensity> @linkml:Float ? ;
          <peak_intensity> @linkml:Float ? ;
          <raw_x> @linkml:Float ? ;
          <raw_y> @linkml:Float ? ;
          <raw_z> @linkml:Float ? ;
          <x_drift> @linkml:Float ? ;
          <y_drift> @linkml:Float ? ;
          <z_drift> @linkml:Float ? ;
          <x_chromatic_shift> @linkml:Float ? ;
          <y_chromatic_shift> @linkml:Float ? ;
          <z_chromatic_shift> @linkml:Float ? ;
          <x_loc_error> @linkml:Float ? ;
          <y_loc_error> @linkml:Float ? ;
          <z_loc_error> @linkml:Float ?
       ) ;
       rdf:type [ <RNASpotQualityRecord> ]
    )
}

