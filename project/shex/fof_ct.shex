<RNASpotTable> CLOSED {
    (  $<RNASpotTable_tes> (  <fof_ct_version> @linkml:String ;
          <table_namespace> @linkml:String ;
          <genome_assembly> @linkml:String ;
          <gene_id_type> @linkml:String ;
