<RNASpot> CLOSED {
    (  $<RNASpot_tes> (  <rna_spot_id> @linkml:Integer ;
          <x> @linkml:Float ;
          <y> @linkml:Float ;
          <z> @linkml:Float ;
          <rna_name> @linkml:String ;
          <gene_id> @linkml:String ;
          <trace_id> @linkml:Integer ;
          <transcript_id> @linkml:String ? ;
          <sub_cell_roi_id> @linkml:Integer ? ;
          <cell_id> @linkml:Integer ? ;
          <extra_cell_roi_id> @linkml:Integer ?
       ) ;
       rdf:type [ <RNASpot> ] ?
    )
}

