             <https://w3id.org/fof-ct/TimeUnitEnum#hr> ] ? ;
          <intensity_unit> @linkml:String ? ;
          <intensity_measurement_method> @linkml:String ? ;
          <spot_quality_records> @<SpotQualityRecord> +
       ) ;
       rdf:type [ <SpotQualityTable> ] ?
    )
}

